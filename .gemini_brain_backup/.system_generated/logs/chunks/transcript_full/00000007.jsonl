{"step_index":374,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-20T15:35:00Z","content":"Created At: 2026-09-20T22:35:00+07:00\nCompleted At: 2026-09-20T22:35:00+07:00\nFile Path: `file:///C:/Delta%20Force/kts-vinhlong/src/app/%28portal%29/kts/lo-trinh/page.tsx`\nTotal Lines: 207\nTotal Bytes: 7793\nShowing lines 1 to 207\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"use client\";\n2: import { useEffect, useState } from \"react\";\n3: import { Table, Tag, Progress, Select, Card, Badge, Tooltip, Button } from \"antd\";\n4: import { WarningOutlined, CheckCircleOutlined, ClockCircleOutlined } from \"@ant-design/icons\";\n5: import type { ColumnsType } from \"antd/es/table\";\n6: import { NhiemVuData } from \"@/types\";\n7: import { LOP_CONFIG, TRANG_THAI_CONFIG, UU_TIEN_CONFIG, PHUONG_AN_CONFIG, formatDate, isOverdue, getDaysRemaining } from \"@/lib/utils\";\n8: import dayjs from \"dayjs\";\n9: \n10: export default function LoTrinhPage() {\n11:   const [data, setData] = useState<NhiemVuData[]>([]);\n12:   const [loading, setLoading] = useState(true);\n13:   const [filterLop, setFilterLop] = useState<string>(\"\");\n14:   const [filterTrangThai, setFilterTrangThai] = useState<string>(\"\");\n15: \n16:   useEffect(() => {\n17:     fetch(\"/api/nhiem-vu\")\n18:       .then((r) => r.json())\n19:       .then((d) => { setData(d); setLoading(false); });\n20:   }, []);\n21: \n22:   const filtered = data.filter((d) => {\n23:     if (filterLop && d.lop !== parseInt(filterLop)) return false;\n24:     if (filterTrangThai && d.trangThai !== filterTrangThai) return false;\n25:     return true;\n26:   });\n27: \n28:   const columns: ColumnsType<NhiemVuData> = [\n29:     {\n30:       title: \"Mã\",\n31:       dataIndex: \"ma\",\n32:       width: 80,\n33:       render: (ma) => <span className=\"font-mono text-xs bg-gray-100 px-2 py-1 rounded\">{ma}</span>,\n34:     },\n35:     {\n36:       title: \"Nhiệm vụ\",\n37:       dataIndex: \"ten\",\n38:       render: (ten, rec) => (\n39:         <div>\n40:           <div className=\"font-medium text-gray-800\">{ten}</div>\n41:           {rec.moTa && <div className=\"text-xs text-gray-400 mt-0.5 line-clamp-2\">{rec.moTa}</div>}\n42:           {rec.phuongAnXuLy && (\n43:             <div className=\"text-xs mt-1 text-blue-600\">\n44:               {PHUONG_AN_CONFIG[rec.phuongAnXuLy] || rec.phuongAnXuLy}\n45:             </div>\n46:           )}\n47:         </div>\n48:       ),\n49:     },\n50:     {\n51:       title: \"Lớp\",\n52:       dataIndex: \"lop\",\n53:       width: 120,\n54:       filters: [1, 2, 3, 4].map((l) => ({ text: LOP_CONFIG[l as 1|2|3|4].shortLabel, value: l })),\n55:       onFilter: (value, record) => record.lop === value,\n56:       render: (lop) => {\n57:         const cfg = LOP_CONFIG[lop as 1|2|3|4];\n58:         return (\n59:           <Tag style={{ color: cfg.color, borderColor: cfg.borderColor, backgroundColor: cfg.bgColor }}>\n60:             {cfg.icon} Lớp {lop}\n61:           </Tag>\n62:         );\n63:       },\n64:     },\n65:     {\n66:       title: \"Đơn vị\",\n67:       dataIndex: [\"donViChuTri\", \"ten\"],\n68:       width: 160,\n69:       render: (_, rec) => rec.donViChuTri?.ten || \"—\",\n70:     },\n71:     {\n72:       title: \"Ưu tiên\",\n73:       dataIndex: \"uuTien\",\n74:       width: 100,\n75:       render: (uuTien) => {\n76:         const cfg = UU_TIEN_CONFIG[uuTien] || { label: uuTien, color: \"#8c8c8c\" };\n77:         return <Tag color={uuTien === \"cao\" ? \"red\" : uuTien === \"trung-binh\" ? \"orange\" : \"green\"}>{cfg.label}</Tag>;\n78:       },\n79:     },\n80:     {\n81:       title: \"Thời hạn\",\n82:       dataIndex: \"thoiHan\",\n83:       width: 120,\n84:       render: (thoiHan, rec) => {\n85:         if (!thoiHan) return \"—\";\n86:         const overdue = isOverdue(thoiHan) && rec.trangThai !== \"hoan-thanh\";\n87:         const days = getDaysRemaining(thoiHan);\n88:         return (\n89:           <Tooltip title={days !== null ? (overdue ? `Trễ ${Math.abs(days)} ngày` : `Còn ${days} ngày`) : \"\"}>\n90:             <span className={overdue ? \"text-red-500 font-semibold\" : days !== null && days <= 30 ? \"text-orange-500\" : \"text-gray-600\"}>\n91:               {overdue && <WarningOutlined className=\"mr-1\" />}\n92:               {formatDate(thoiHan)}\n93:             </span>\n94:           </Tooltip>\n95:         );\n96:       },\n97:     },\n98:     {\n99:       title: \"Tiến độ\",\n100:       dataIndex: \"tienDo\",\n101:       width: 160,\n102:       render: (tienDo, rec) => (\n103:         <div>\n104:           <Progress\n105:             percent={tienDo}\n106:             size=\"small\"\n107:             status={rec.trangThai === \"tre-han\" ? \"exception\" : rec.trangThai === \"hoan-thanh\" ? \"success\" : \"active\"}\n108:             strokeColor={\n109:               rec.trangThai === \"hoan-thanh\" ? \"#52c41a\" :\n110:               rec.trangThai === \"tre-han\" ? \"#ff4d4f\" :\n111:               tienDo > 50 ? \"#1677ff\" : \"#faad14\"\n112:             }\n113:           />\n114:           <div className=\"text-xs text-gray-400 mt-0.5\">\n115:             {TRANG_THAI_CONFIG[rec.trangThai]?.label || rec.trangThai}\n116:           </div>\n117:         </div>\n118:       ),\n119:     },\n120:   ];\n121: \n122:   const tongHT = data.filter(d => d.trangThai === 'hoan-thanh').length;\n123:   const tongDT = data.filter(d => d.trangThai === 'dang-thuc-hien').length;\n124:   const tongTH = data.filter(d => d.trangThai === 'tre-han' || (d.thoiHan && isOverdue(d.thoiHan) && d.trangThai !== 'hoan-thanh')).length;\n125: \n126:   return (\n127:     <div>\n128:       <div className=\"page-header mb-6\">\n129:         <h1 className=\"text-2xl font-bold\">Lộ trình Nhiệm vụ Chuyển đổi Kiến trúc</h1>\n130:         <p className=\"text-blue-200 mt-1\">\n131:           Theo dõi tiến độ các nhiệm vụ chuyển đổi kiến trúc số theo lộ trình 2026–2028\n132:         </p>\n133:       </div>\n134: \n135:       {/* Quick stats */}\n136:       <div className=\"flex gap-4 mb-4\">\n137:         <Badge count={data.length} color=\"#1677ff\" overflowCount={99}>\n138:           <Card size=\"small\" className=\"px-4 py-2 min-w-[100px] text-center\">\n139:             <div className=\"text-lg font-bold text-gray-800\">{data.length}</div>\n140:             <div className=\"text-xs text-gray-400\">Tổng nhiệm vụ</div>\n141:           </Card>\n142:         </Badge>\n143:         <Card size=\"small\" className=\"px-4 py-2 min-w-[100px] text-center bg-green-50 border-green-200\">\n144:           <div className=\"text-lg font-bold text-green-600\"><CheckCircleOutlined /> {tongHT}</div>\n145:           <div className=\"text-xs text-gray-400\">Hoàn thành</div>\n146:         </Card>\n147:         <Card size=\"small\" className=\"px-4 py-2 min-w-[100px] text-center bg-blue-50 border-blue-200\">\n148:           <div className=\"text-lg font-bold text-blue-600\"><ClockCircleOutlined /> {tongDT}</div>\n149:           <div className=\"text-xs text-gray-400\">Đang thực hiện</div>\n150:         </Card>\n151:         <Card size=\"small\" className=\"px-4 py-2 min-w-[100px] text-center bg-red-50 border-red-200\">\n152:           <div className=\"text-lg font-bold text-red-600\"><WarningOutlined /> {tongTH}</div>\n153:           <div className=\"text-xs text-gray-400\">Cảnh báo</div>\n154:         </Card>\n155:       </div>\n156: \n157:       {/* Filters */}\n158:       <Card className=\"mb-4 shadow-sm\">\n159:         <div className=\"flex gap-4 items-center\">\n160:           <span className=\"text-gray-600 font-medium\">Lọc:</span>\n161:           <Select\n162:             placeholder=\"Tất cả lớp\"\n163:             allowClear\n164:             style={{ width: 200 }}\n165:             onChange={setFilterLop}\n166:           >\n167:             {[1, 2, 3, 4].map((l) => (\n168:               <Select.Option key={l} value={String(l)}>\n169:                 {LOP_CONFIG[l as 1|2|3|4].icon} {LOP_CONFIG[l as 1|2|3|4].shortLabel}\n170:               </Select.Option>\n171:             ))}\n172:           </Select>\n173:           <Select\n174:             placeholder=\"Tất cả trạng thái\"\n175:             allowClear\n176:             style={{ width: 200 }}\n177:             onChange={setFilterTrangThai}\n178:           >\n179:             {Object.entries(TRANG_THAI_CONFIG).map(([k, v]) => (\n180:               <Select.Option key={k} value={k}>{v.label}</Select.Option>\n181:             ))}\n182:           </Select>\n183:           <span className=\"text-gray-400 text-sm ml-auto\">\n184:             Hiển thị {filtered.length}/{data.length} nhiệm vụ\n185:           </span>\n186:         </div>\n187:       </Card>\n188: \n189:       <Card className=\"shadow-sm\">\n190:         <Table\n191:           columns={columns}\n192:           dataSource={filtered}\n193:           rowKey=\"id\"\n194:           loading={loading}\n195:           pagination={{ pageSize: 20 }}\n196:           rowClassName={(record) => {\n197:             if (record.trangThai === \"hoan-thanh\") return \"bg-green-50\";\n198:             if (isOverdue(record.thoiHan) && record.trangThai !== \"hoan-thanh\") return \"bg-red-50\";\n199:             return \"\";\n200:           }}\n201:           size=\"middle\"\n202:         />\n203:       </Card>\n204:     </div>\n205:   );\n206: }\n207: \nThe above content shows the entire, complete file contents of the requested file.\n"}
