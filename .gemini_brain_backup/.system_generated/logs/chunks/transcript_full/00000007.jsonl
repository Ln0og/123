on value=\"can-thay-the\">Cần thay thế</Select.Option>\n156:                 <Select.Option value=\"ke-hoach\">Kế hoạch</Select.Option>\n157:               </Select>\n158:             </Form.Item>\n159:             <Form.Item label=\"Chủ quản\" name=\"chuQuan\">\n160:               <Input placeholder=\"Sở TT&TT\" />\n161:             </Form.Item>\n162:             <Form.Item label=\"Năm triển khai\" name=\"namTrienKhai\">\n163:               <Input type=\"number\" placeholder=\"2023\" />\n164:             </Form.Item>\n165:           </div>\n166:           <Form.Item label=\"Đơn vị\" name=\"donViId\">\n167:             <Select allowClear placeholder=\"Chọn đơn vị quản lý\">\n168:               {donVis.map(dv => <Select.Option key={dv.id} value={dv.id}>{dv.ten}</Select.Option>)}\n169:             </Select>\n170:           </Form.Item>\n171:         </Form>\n172:       </Modal>\n173:     </div>\n174:   );\n175: }\n176: \nThe above content shows the entire, complete file contents of the requested file.\n"}
