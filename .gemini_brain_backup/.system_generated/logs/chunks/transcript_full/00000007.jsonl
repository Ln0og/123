age=\"Không tải được dữ liệu\" type=\"error\" />;\n40: \n41:   const pieData = [\n42:     { name: \"Hoàn thành\", value: stats.hoanThanh, color: \"#52c41a\" },\n43:     { name: \"Đang thực hiện\", value: stats.dangThucHien, color: \"#1677ff\" },\n44:     { name: \"Chưa bắt đầu\", value: stats.chuaBatDau, color: \"#8c8c8c\" },\n45:     { name: \"Trễ hạn\", value: stats.treHan, color: \"#ff4d4f\" },\n46:   ].filter(d => d.value > 0);\n47: \n48:   const barData = stats.nhiemVuTheoLop.map((l) => ({\n49:     name: LOP_CONFIG[l.lop as 1|2|3|4]?.shortLabel || `Lớp ${l.lop}`,\n50:     \"Tổng\": l.total,\n51:     \"Hoàn thành\": l.hoanThanh,\n52:     \"Còn lại\": l.total - l.hoanThanh,\n53:   }));\n54: \n55:   const alertColumns: ColumnsType<NhiemVuData> = [\n56:     {\n57:       title: \"Mã\",\n58:       dataIndex: \"ma\",\n59:       width: 70,\n60:       render: (ma) => <span className=\"font-mono text-xs\">{ma}</span>,\n61:     },\n62:     { title: \"Nhiệm vụ\", dataIndex: \"ten\", ellipsis: true },\n63:     {\n64:       title: \"Lớp\",\n65:       dataIndex: \"lop\",\n66:       width: 80,\n67:       render: (lop) => {\n68:         const cfg = LOP_CONFIG[lop as 1|2|3|4];\n69:         return <Tag style={{ color: cfg.color, backgroundColor: cfg.bgColor, borderColor: cfg.borderColor }}>{cfg.icon} {lop}</Tag>;\n70:       },\n71:     },\n72:     {\n73:       title: \"Thời hạn\",\n74:       dataIndex: \"thoiHan\",\n75:       width: 110,\n76:       render: (d, rec) => {\n77:         const overdue = isOverdue(d) && rec.trangThai !== \"hoan-thanh\";\n78:         return (\n79:           <span className={overdue ? \"text-red-500 font-semibold\" : \"text-orange-500\"}>\n80:             {overdue && <WarningOutlined className=\"mr-1\" />}\n81:             {formatDate(d)}\n82:           </span>\n83:         );\n84:       },\n85:     },\n86:     {\n87:       title: \"Tiến độ\",\n88:       dataIndex: \"tienDo\",\n89:       width: 100,\n90:       render: (p) => <Progress percent={p} size=\"small\" />,\n91:     },\n92:   ];\n93: \n94:   return (\n95:     <div className=\"min-h-screen bg-gray-50\">\n96:       {/* Header */}\n97:       <div className=\"hero-gradient text-white px-8 py-6\">\n98:         <div className=\"max-w-7xl mx-auto\">\n99:           <div className=\"flex items-center gap-3 mb-1\">\n100:             <ApartmentOutlined className=\"text-2xl\" />\n101:             <div>\n102:               <h1 className=\"text-2xl font-bold\">Dashboard Lãnh đạo</h1>\n103:               <p className=\"text-blue-200 text-sm\">\n104:                 Giám sát tiến độ triển khai Khung Kiến trúc Số — Tỉnh Vĩnh Long\n105:               </p>\n106:             </div>\n107:           </div>\n108:         </div>\n109:       </div>\n110: \n111:       <div className=\"max-w-7xl mx-auto px-8 py-6 space-y-6\">\n112:         {/* Cảnh báo trễ hạn */}\n113:         {stats.treHan > 0 && (\n114:           <Alert\n115:             message={`⚠️ Có ${stats.treHan} nhiệm vụ trễ hạn cần xử lý gấp`}\n116:             type=\"error\"\n117:             showIcon\n118:             className=\"rounded-xl\"\n119:           />\n120:         )}\n121: \n122:         {/* 5 Stat Cards */}\n123:         <div className=\"grid grid-cols-5 gap-4\">\n124:           {[\n125:             {\n126:               title: \"Tổng nhiệm vụ\",\n127:               value: stats.tongNhiemVu,\n128:               color: \"#1677ff\",\n129:               icon: <ClockCircleOutlined />,\n130:               bg: \"#e6f4ff\",\n131:             },\n132:             {\n133:               title: \"Hoàn thành\",\n134:               value: stats.hoanThanh,\n135:               color: \"#52c41a\",\n136:               icon: <CheckCircleOutlined />,\n137:               bg: \"#f6ffed\",\n138:             },\n139:             {\n140:               title: \"Đang thực hiện\",\n141:               value: stats.dangThucHien,\n142:               color: \"#1677ff\",\n143:               icon: <ClockCircleOutlined />,\n144:               bg: \"#e6f4ff\",\n145:             },\n146:             {\n147:               title: \"Trễ hạn\",\n148:               value: stats.treHan,\n149:               color: \"#ff4d4f\",\n150:               icon: <WarningOutlined />,\n151:               bg: \"#fff2f0\",\n152:             },\n153:             {\n154:               title: \"Hệ thống số\",\n155:               value: stats.tongHeThong,\n156:               color: \"#722ed1\",\n157:               icon: <DatabaseOutlined />,\n158:               bg: \"#f9f0ff\",\n159:             },\n160:           ].map((s) => (\n161:             <Card\n162:               key={s.title}\n163:               className=\"stat-card border-0\"\n164:               style={{ backgroundColor: s.bg }}\n165:             >\n166:               <div className=\"flex items-center gap-3\">\n167:                 <div\n168:                   className=\"w-10 h-10 rounded-xl flex items-center justify-center text-lg\"\n169:                   style={{ backgroundColor: s.color + \"20\", color: s.color }}\n170:                 >\n171:                   {s.icon}\n172:                 </div>\n173:                 <div>\n174:                   <Statistic\n175:                     title={<span className=\"text-gray-500 text-xs\">{s.title}</span>}\n176:                     value={s.value}\n177:                     valueStyle={{ color: s.color, fontSize: 28, fontWeight: 700 }}\n178:                   />\n179:                 </div>\n180:               </div>\n181:             </Card>\n182:           ))}\n183:         </div>\n184: \n185:         {/* Progress tổng thể */}\n186:         <Card className=\"shadow-sm\">\n187:           <div className=\"flex items-center justify-between mb-3\">\n188:             <span className=\"font-bold text-gray-700 text-lg\">Tiến độ tổng thể</span>\n189:             <span className=\"text-2xl font-bold text-blue-600\">{stats.phanTramHoanThanh}%</span>\n190:           </div>\n191:           <Progress\n192:             percent={stats.phanTramHoanThanh}\n193:             strokeWidth={16}\n194:             strokeColor={{\n195:               \"0%\": \"#1677ff\",\n196:               \"100%\": \"#52c41a\",\n197:             }}\n198:             trailColor=\"#e8e8e8\"\n199:             format={(p) => `${p}% hoàn thành`}\n200:           />\n201:           <div className=\"flex gap-6 mt-3 text-sm text-gray-500\">\n202:             <span>✅ Hoàn thành: {stats.hoanThanh}</span>\n203:             <span>🔵 Đang thực hiện: {stats.dangThucHien}</span>\n204:             <span>⚪ Chưa bắt đầu: {stats.chuaBatDau}</span>\n205:             <span>🔴 Trễ hạn: {stats.treHan}</span>\n206:           </div>\n207:         </Card>\n208: \n209:         {/* Charts */}\n210:         <div className=\"grid grid-cols-2 gap-6\">\n211:           {/* Pie chart */}\n212:           <Card title=\"Phân bổ trạng thái nhiệm vụ\" className=\"shadow-sm\">\n213:             <ResponsiveContainer width=\"100%\" height={280}>\n214:               <PieChart>\n215:                 <Pie\n216:                   data={pieData}\n217:                   cx=\"50%\"\n218:                   cy=\"50%\"\n219:                   innerRadius={70}\n220:                   outerRadius={110}\n221:                   paddingAngle={3}\n222:                   dataKey=\"value\"\n223:                   label={({ name, percent }) => `${name} (${(percent * 100).toFixed(0)}%)`}\n224:                 >\n225:                   {pieData.map((entry, index) => (\n226:                     <Cell key={index} fill={entry.color} />\n227:                   ))}\n228:                 </Pie>\n229:                 <Tooltip />\n230:               </PieChart>\n231:             </ResponsiveContainer>\n232:           </Card>\n233: \n234:           {/* Bar chart by layer */}\n235:           <Card title=\"Tiến độ theo lớp kiến trúc\" className=\"shadow-sm\">\n236:             <ResponsiveContainer width=\"100%\" height={280}>\n237:               <BarChart data={barData} margin={{ top: 5, right: 30, left: 0, bottom: 5 }}>\n238:                 <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#f0f0f0\" />\n239:                 <XAxis dataKey=\"name\" tick={{ fontSize: 11 }} />\n240:                 <YAxis tick={{ fontSize: 11 }} />\n241:                 <Tooltip />\n242:                 <Legend />\n243:                 <Bar dataKey=\"Hoàn thành\" fill=\"#52c41a\" radius={[4, 4, 0, 0]} />\n244:                 <Bar dataKey=\"Còn lại\" fill=\"#e8e8e8\" radius={[4, 4, 0, 0]} />\n245:               </BarChart>\n246:             </ResponsiveContainer>\n247:           </Card>\n248:         </div>\n249: \n250:         {/* 4 Lớp quick view */}\n251:         <div className=\"grid grid-cols-4 gap-4\">\n252:           {stats.nhiemVuTheoLop.map((l) => {\n253:             const cfg = LOP_CONFIG[l.lop as 1|2|3|4];\n254:             const pct = l.total > 0 ? Math.round((l.hoanThanh / l.total) * 100) : 0;\n255:             return (\n256:               <Card\n257:                 key={l.lop}\n258:                 size=\"small\"\n259:                 className=\"lop-card\"\n260:                 style={{ borderColor: cfg.borderColor, backgroundColor: cfg.bgColor }}\n261:               >\n262:                 <div className=\"flex items-center gap-2 mb-2\">\n263:                   <span className=\"text-xl\">{cfg.icon}</span>\n264:                   <div>\n265:                     <div className=\"font-bold text-xs\" style={{ color: cfg.color }}>\n266:                       Lớp {l.lop}\n267:                     </div>\n268:                     <div className=\"text-xs text-gray-500\">{l.total} nhiệm vụ</div>\n269:                   </div>\n270:                 </div>\n271:                 <Progress percent={pct} size=\"small\" strokeColor={cfg.color} />\n272:                 <div className=\"text-xs text-gray-400 mt-1\">\n273:                   {l.hoanThanh}/{l.total} hoàn thành\n274:                 </div>\n275:               </Card>\n276:             );\n277:           })}\