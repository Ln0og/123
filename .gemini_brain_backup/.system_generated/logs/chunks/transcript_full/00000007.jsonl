olor: cfg.color, backgroundColor: cfg.bgColor, borderColor: cfg.borderColor }}>{cfg.icon} L{lop}</Tag>;\n84:     }},\n85:     { title: \"Chủ quản\", dataIndex: \"chuQuan\", width: 120 },\n86:     { title: \"Trạng thái\", dataIndex: \"trangThai\", width: 140, render: ts => {\n87:       const cfg = TRANG_THAI_CONFIG[ts];\n88:       return cfg ? <Tag color={cfg.antdColor}>{cfg.label}</Tag> : <Tag>{ts}</Tag>;\n89:     }},\n90:     { title: \"Thao tác\", width: 100, render: (_, rec) => (\n91:       <div className=\"flex gap-2\">\n92:         <Button icon={<EditOutlined />} size=\"small\" onClick={() => openEdit(rec)} />\n93:         <Popconfirm title=\"Xóa hệ thống này?\" onConfirm={() => handleDelete(rec.id)} okText=\"Xóa\" cancelText=\"Hủy\" okButtonProps={{ danger: true }}>\n94:           <Button icon={<DeleteOutlined />} size=\"small\" danger />\n95:         </Popconfirm>\n96:       </div>\n97:     )},\n98:   ];\n99: \n100:   return (\n101:     <div>\n102:       <div className=\"flex justify-between items-center mb-6\">\n103:         <div>\n104:           <h1 className=\"text-xl font-bold text-gray-800\">Quản lý Hệ thống Số</h1>\n105:           <p className=\"text-gray-400 text-sm\">Danh mục các hệ thống số theo 4 lớp kiến trúc</p>\n106:         </div>\n107:         <Button type=\"primary\" icon={<PlusOutlined />} onClick={openCreate} style={{ backgroundColor: \"#003087\" }}>\n108:           Thêm hệ thống\n109:         </Button>\n110:       </div>\n111: \n112:       <Card className=\"shadow-sm\">\n113:         <Table columns={columns} dataSource={data} rowKey=\"id\" loading={loading} size=\"middle\" pagination={{ pageSize: 20 }} />\n114:       </Card>\n115: \n116:       <Modal\n117:         title={editing ? \"Sửa thông tin hệ thống\" : \"Thêm hệ thống mới\"}\n118:         open={modalOpen}\n119:         onOk={handleSave}\n120:         onCancel={() => setModalOpen(false)}\n121:         confirmLoading={saving}\n122:         okText={editing ? \"Cập nhật\" : \"Thêm mới\"}