temsMatch: (ht) => ht.ma.startsWith(\"DL-\") || ht.ten.toLowerCase().includes(\"kho dữ liệu\") || ht.ten.toLowerCase().includes(\"danh mục\"),\n      tasksMatch: (nv) => nv.ma === \"NV-06\",\n      color: \"#2563eb\",\n      borderColor: \"#93c5fd\",\n      bgColor: \"#eff6ff\",\n    },\n    lop2_csdl_quocgia: {\n      id: \"lop2_csdl_quocgia\",\n      title: \"Kết Nối CSDL Quốc Gia (Đề Án 06)\",\n      description: \"Kết nối CSDL Quốc gia về Dân cư, CSDL Đất đai, CSDL Đăng ký doanh nghiệp, Bảo hiểm xã hội\",\n      icon: <ApartmentOutlined />,\n      lop: 2,\n      category: \"Lớp 2: Dữ liệu & Nền tảng lõi\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"dân cư\") || ht.ma === \"DL-01\" || ht.ma === \"DL-02\",\n      tasksMatch: (nv) => nv.ma === \"NV-03\" || nv.ma === \"NV-01\",\n      color: \"#1d4ed8\",\n      borderColor: \"#93c5fd\",\n      bgColor: \"#eff6ff\",\n    },\n    lop2_nentang_loi: {\n      id: \"lop2_nentang_loi\",\n      title: \"Nền Tảng Định Danh & GIS Dùng Chung\",\n      description: \"Nền tảng xác thực định danh (VNeID/SSO), Nền tảng thanh toán số Payment, Nền tảng Bản đồ số GIS\",\n      icon: <DeploymentUnitOutlined />,\n      lop: 2,\n      category: \"Lớp 2: Dữ liệu & Nền tảng lõi\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"định danh\") || ht.ten.toLowerCase().includes(\"gis\") || ht.ten.toLowerCase().includes(\"thanh toán\"),\n      tasksMatch: (nv) => nv.ma === \"NV-03\",\n      color: \"#0284c7\",\n      borderColor: \"#7dd3fc\",\n      bgColor: \"#f0f9ff\",\n    },\n\n    // ==========================================\n    // LỚP 1: HẠ TẦNG SỐ VÀ AN NINH MẠNG DÙNG CHUNG\n    // ==========================================\n    lop1_idc_cloud: {\n      id: \"lop1_idc_cloud\",\n      title: \"Trung Tâm Dữ Liệu & Cloud Tỉnh (IDC)\",\n      description: \"Trung tâm tích hợp dữ liệu tỉnh, chuyển đổi sang kiến trúc Cloud kết nối Cloud Quốc gia\",\n      icon: <CloudServerOutlined />,\n      lop: 1,\n      category: \"Lớp 1: Hạ tầng số & An ninh mạng dùng chung\",\n      itemsMatch: (ht) => ht.ma === \"HT-02\" || ht.ten.toLowerCase().includes(\"idc\") || ht.ten.toLowerCase().includes(\"trung tâm tích hợp\"),\n      tasksMatch: (nv) => nv.ma === \"NV-02\",\n      color: \"#4c1d95\",\n      borderColor: \"#c084fc\",\n      bgColor: \"#f3e8ff\",\n    },\n    lop1_mang_tslcd: {\n      id: \"lop1_mang_tslcd\",\n      title: \"Mạng TSLCD & Internet Băng Rộng\",\n      description: \"Mạng Truyền số liệu chuyên dùng cấp I, II kết nối 100% cơ quan Đảng, chính quyền 3 cấp\",\n      icon: <NodeIndexOutlined />,\n      lop: 1,\n      category: \"Lớp 1: Hạ tầng số & An ninh mạng dùng chung\",\n      itemsMatch: (ht) => ht.ma === \"HT-01\" || ht.ten.toLowerCase().includes(\"wan\") || ht.ten.toLowerCase().includes(\"mạng\"),\n      tasksMatch: (nv) => false,\n      color: \"#581c87\",\n      borderColor: \"#d8b4fe\",\n      bgColor: \"#faf5ff\",\n    },\n    lop1_soc_anm: {\n      id: \"lop1_soc_anm\",\n      title: \"Trung Tâm Giám Sát ATTT (SOC Tỉnh 24/7)\",\n      description: \"Mô hình bảo vệ 4 lớp ATTT, kết nối SOC Quốc gia của Bộ Công an, chữ ký số PKI, sao lưu dự phòng\",\n      icon: <LockOutlined />,\n      lop: 1,\n      category: \"Lớp 1: Hạ tầng số & An ninh mạng dùng chung\",\n      itemsMatch: (ht) => ht.ma === \"HT-03\" || ht.ten.toLowerCase().includes(\"soc\") || ht.ten.toLowerCase().includes(\"an toàn\"),\n      tasksMatch: (nv) => nv.ma === \"NV-05\",\n      color: \"#991b1b\",\n      borderColor: \"#f87171\",\n      bgColor: \"#fef2f2\",\n    },\n    lop1_iot_bien: {\n      id: \"lop1_iot_bien\",\n      title: \"Hạ Tầng IoT, Camera & Cảm Biến Biên\",\n      description: \"Hệ thống camera giám sát an ninh đô thị, trạm quan trắc IoT môi trường, nông nghiệp\",\n      icon: <EyeOutlined />,\n      lop: 1,\n      category: \"Lớp 1: Hạ tầng số & An ninh mạng dùng chung\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"camera\") || ht.ten.toLowerCase().includes(\"quan trắc\") || ht.ten.toLowerCase().includes(\"iot\"),\n      tasksMatch: (nv) => false,\n      color: \"#701a75\",\n      borderColor: \"#f472b6\",\n      bgColor: \"#fdf2f8\",\n    },\n  };\n\n  const getMatchedItems = (block: FrameworkBlock) => {\n    return heThongs.filter(block.itemsMatch);\n  };\n\n  const getMatchedTasks = (block: FrameworkBlock) => {\n    return nhiemVus.filter(block.tasksMatch);\n  };\n\n  const renderBlockCard = (blockKey: string) => {\n    const block = frameworkBlocks[blockKey];\n    if (!block) return null;\n    const items = getMatchedItems(block);\n    const tasks = getMatchedTasks(block);\n    const hasUpgrade = items.some((i) => i.trangThai === \"can-nang-cap\") || tasks.length > 0;\n\n    return (\n      <div\n        onClick={() => setSelectedBlock(block)}\n        className=\"p-3 rounded-xl border-2 transition-all cursor-pointer hover:shadow-lg hover:-translate-y-0.5 flex flex-col justify-between group\"\n        style={{\n          borderColor: block.borderColor,\n          backgroundColor: block.bgColor,\n        }}\n      >\n        <div>\n          <div className=\"flex justify-between items-start mb-1.5\">\n            <div className=\"flex items-center gap-1.5 font-bold text-xs md:text-sm\" style={{ color: block.color }}>\n              <span className=\"text-base\">{block.icon}</span>\n              <span className=\"line-clamp-1\">{block.title}</span>\n            </div>\n            {hasUpgrade && (\n              <span className=\"bg-amber-100 text-amber-950 border border-amber-400 font-bold text-[10px] px-1.5 py-0.2 rounded-full shrink-0\">\n                Có lộ trình\n              </span>\n            )}\n          </div>\n          <div className=\"text-[11px] md:text-xs text-gray-600 line-clamp-2 leading-relaxed mb-2\">\n            {block.description}\n          </div>\n        </div>\n\n        <div className=\"flex justify-between items-center pt-2 border-t border-black/5 text-xs\">\n          <span className=\"font-semibold text-gray-700 bg-white/80 px-2 py-0.5 rounded border border-black/5 text-[10px] md:text-xs\">\n            {items.length > 0 ? `${items.length} hệ thống/CSDL` : \"Quy chuẩn mục tiêu\"}\n          </span>\n          <span className=\"font-bold flex items-center gap-0.5 group-hover:translate-x-0.5 transition-transform text-[11px]\" style={{ color: block.color }}>\n            Chi tiết <RightOutlined className=\"text-[9px]\" />\n          </span>\n        </div>\n      </div>\n    );\n  };\n\n  if (loading) {\n    return (\n      <div className=\"flex justify-center items-center min-h-[60vh]\">\n        <Spin size=\"large\" />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"max-w-7xl mx-auto space-y-6 pb-16\">\n      {/* Header Banner */}\n      <div className=\"bg-gradient-to-r from-blue-950 via-slate-900 to-indigo-950 text-white p-6 rounded-2xl shadow-md flex flex-col md:flex-row justify-between items-start md:items-center gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-2\">\n            <span className=\"bg-amber-400/30 text-amber-200 border border-amber-400/40 text-xs px-2.5 py-0.5 rounded-full font-bold flex items-center gap-1\">\n              <ApartmentOutlined /> Chuẩn QĐ 1425/QĐ-TTg (PB 1.0)\n            </span>\n            <span className=\"text-xs text-blue-300\">Khung Kiến Trúc Chính Quyền Số Tỉnh Vĩnh Long</span>\n          </div>\n          <h1 className=\"text-2xl font-bold tracking-tight text-white m-0\">\n            Sơ Đồ Khung Kiến Trúc Tổng Thể Chính Quyền Số\n          </h1>\n          <p className=\"text-sm text-blue-200/90 mt-1 mb-0 max-w-3xl\">\n            Mô hình cấu trúc <b>04 Lớp Chuẩn</b> kết hợp <b>04 Thành Phần Xuyên Suốt</b> (Quản trị • Quy chuẩn • AI First • Data-Centric) theo chuẩn Khung Kiến trúc tổng thể quốc gia số phiên bản 1.0.\n          </p>\n        </div>\n\n        <div className=\"flex gap-2 shrink-0\">\n          <Link href=\"/kts/hien-trang\">\n            <Button className=\"bg-white/15 border-white/30 text-white hover:bg-white/25\">\n              Xem Hiện Trạng (389 HT)\n            </Button>\n          </Link>\n          <Link href=\"/kts/lo-trinh\">\n            <Button type=\"primary\" className=\"bg-blue-600 border-blue-500 font-semibold\">\n              Xem Lộ Trình (9 NV)\n            </Button>\n          </Link>\n        </div>\n      </div>\n\n      {/* ARCHITECTURE BLUEPRINT DIAGRAM */}\n      <Card className=\"shadow-md rounded-2xl border-gray-200 overflow-hidden p-2\">\n        <div className=\"text-center mb-6\">\n          <div className=\"inline-block bg-blue-900 text-white px-5 py-1 rounded-full text-xs font-bold uppercase tracking-wider shadow-xs\">\n            🏛️ MÔ HÌNH KIẾN TRÚC TỔNG THỂ CHÍNH QUYỀN SỐ (04 LỚP CHUẨN THEO QĐ 1425/QĐ-TTg)\n          </div>\n          <div className=\"text-xs text-gray-500 mt-1.5\">\n            💡 Nhấp chuột vào bất kỳ khối nào trên sơ đồ để xem các hệ thống hiện trạng và nhiệm vụ lộ trình liên quan\n          </div>\n        </div>\n\n        {/* 3-Column Master Layout: Left Cross-cutting Pillar | 4 Central Horizontal Layers | Right Cross-cutting Pillar */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-4 items-stretch\">\n          \n          {/* ========================================================================= */}\n          {/* CỘT TRÁI: 2 THÀNH PHẦN XUYÊN SUỐT (QUẢN TRỊ & TIÊU CHUẨN) */}\n          {/* ========================================================================= */}\n          <div className=\"lg:col-span-2 bg-gradient-to-b from-slate-100 via-gray-100 to-slate-200 p-4 rounded-2xl border-2 border-slate-300 flex flex-col justify-between shadow-2xs space-y-4\">\n            <div>\n              <div className=\"flex items-center gap-1.5 font-bold text-slate-900 text-xs mb-3 border-b-2 border-slate-300 pb-2\">\n                <SlidersOutlined className=\"text-blue-800 text-base\" />\n                <span>THÀNH PHẦN XUYÊN SUỐT (I & II)</span>\n              </div>\n\n              {/* 1. Quản trị điều phối */}\n              <div className=\"mb-4 bg-white/80 p-3 rounded-xl border border-slate-300\">\n                <div className=\"font-bold text-slate-900 text-xs flex items-center gap-1 mb-1.5\">\n                  <BankOutlined className=\"text-blue-700\" />\n                  <span>1. Quản trị & Điều phối</span>\n                </div>\n                <ul className=\"text-[11px] text-slate-700 space-y-1.5 pl-3.5 list-disc m-0\">\n                  <li>Ban chỉ đạo CĐS tỉnh</li>\n                  <li>Quyết định 1425/QĐ-TTg</li>\n                  <li>Luật Chuyển đổi số 2025</li>\n                  <li>Kế hoạch CĐS 2026–2030</li>\n                  <li>Giám sát KPIs thực thi</li>\n                </ul>\n              </div>\n\n              {/* 2. Tiêu chuẩn quy chuẩn */}\n              <div className=\"bg-white/80 p-3 rounded-xl border border-slate-300\">\n                <div className=\"font-bold text-slate-900 text-xs flex items-center gap-1 mb-1.5\">\n                  <SafetyCertificateOutlined className=\"text-blue-700\" />\n                  <span>2. Tiêu chuẩn & Quy chuẩn</span>\n                </div>\n                <ul className=\"text-[11px] text-slate-700 space-y-1.5 pl-3.5 list-disc m-0\">\n                  <li>Kiến trúc số dùng chung</li>\n                  <li>Quy chế chia sẻ dữ liệu</li>\n                  <li>Chuẩn dữ liệu mở & API</li>\n                  <li>Định mức kinh tế - kỹ thuật</li>\n                </ul>\n              </div>\n            </div>\n\n            <div className=\"pt-2 border-t border-slate-300 text-[11px] text-slate-600 text-center font-bold uppercase tracking-wider\">\n              Khung Thể Chế & Chuẩn Hóa\n            </div>\n          </div>\n\n          {/* ========================================================================= */}\n          {/* TRUNG TÂM: 04 LỚP KIẾN TRÚC CHUẨN QUỐC GIA (TOP-DOWN: LỚP 4 -> LỚP 1) */}\n          {/* ========================================================================= */}\n          <div className=\"lg:col-span-8 space-y-4\">\n            \n            {/* ------------------------------------------------------------- */}\n            {/* LỚP 4: KÊNH TƯƠNG TÁC VÀ ĐO LƯỜNG HIỆU QUẢ */}\n            {/* ------------------------------------------------------------- */}\n            <div className=\"bg-orange-50/60 p-3.5 rounded-2xl border-2 border-orange-300 shadow-2xs\">\n              <div className=\"flex items-center justify-between mb-2.5\">\n                <span className=\"font-bold text-xs uppercase tracking-wide text-orange-950 flex items-center gap-1.5\">\n                  <TeamOutlined className=\"text-orange-600 text-sm\" /> LỚP 4: KÊNH TƯƠNG TÁC VÀ ĐO LƯỜNG HIỆU QUẢ (OMNI-CHANNEL & KPIS)\n                </span>\n                <span className=\"text-[11px] text-orange-900 font-bold bg-orange-200/80 px-2 py-0.5 rounded border border-orange-300\">\n                  Phục vụ Người dân • Doanh nghiệp • Cán bộ CCVC\n                </span>\n              </div>\n              <div className=\"grid grid-cols-1 md:grid-cols-4 gap-2.5\">\n                {renderBlockCard(\"lop4_dvc\")}\n                {renderBlockCard(\"lop4_app_mobile\")}\n                {renderBlockCard(\"lop4_portal\")}\n                {renderBlockCard(\"lop4_kpi_metric\")}\n              </div>\n            </div>\n\n            {/* ------------------------------------------------------------- */}\n            {/* LỚP 3: ỨNG DỤNG VÀ NGHIỆP VỤ DÙNG CHUNG (CHIA 2 CỘT SONG SONG) */}\n            {/* ------------------------------------------------------------- */}\n            <div className=\"bg-emerald-50/60 p-3.5 rounded-2xl border-2 border-emerald-300 shadow-2xs\">\n              <div className=\"flex items-center justify-between mb-2.5\">\n                <span className=\"font-bold text-xs uppercase tracking-wide text-emerald-950 flex items-center gap-1.5\">\n                  <DesktopOutlined className=\"text-emerald-700 text-sm\" /> LỚP 3: ỨNG DỤNG VÀ NGHIỆP VỤ DÙNG CHUNG (389+ HỆ THỐNG & CSDL)\n                </span>\n                <span className=\"text-[11px] text-emerald-900 font-bold bg-emerald-200/80 px-2 py-0.5 rounded border border-emerald-300\">\n                  Tổ chức 2 Nhánh song song: Chính quyền số VS. Kinh tế số & Xã hội số\n                </span>\n              </div>\n\n              {/* 2 Sub-Columns for Layer 3 */}\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3.5\">\n                \n                {/* CỘT TRÁI CỦA LỚP 3: CHÍNH QUYỀN SỐ */}\n                <div className=\"bg-white/80 p-3 rounded-xl border border-emerald-300 space-y-2\">\n                  <div className=\"font-bold text-xs text-emerald-950 flex items-center justify-between border-b border-emerald-200 pb-1.5\">\n                    <span className=\"flex items-center gap-1\">🏛️ NHÁNH 1: CHÍNH QUYỀN SỐ</span>\n                    <span className=\"text-[10px] font-normal text-emerald-700\">(Nội bộ & TTHC)</span>\n                  </div>\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n                    {renderBlockCard(\"lop3_chidao_dieuhanh\")}\n                    {renderBlockCard(\"lop3_tthc_sohoa\")}\n                    {renderBlockCard(\"lop3_ioc_tinh\")}\n                    {renderBlockCard(\"lop3_nghiepvu_chuyennganh\")}\n                  </div>\n                </div>\n\n                {/* CỘT PHẢI CỦA LỚP 3: KINH TẾ SỐ & XÃ HỘI SỐ */}\n                <div className=\"bg-white/80 p-3 rounded-xl border border-emerald-300 space-y-2\">\n                  <div className=\"font-bold text-xs text-emerald-950 flex items-center justify-between border-b border-emerald-200 pb-1.5\">\n                    <span className=\"flex items-center gap-1\">🌾 NHÁNH 2: KINH TẾ SỐ & XÃ HỘI SỐ</span>\n                    <span className=\"text-[10px] font-normal text-emerald-700\">(Phát triển ngành & Đời sống)</span>\n                  </div>\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n                    {renderBlockCard(\"lop3_nongnghiep_so\")}\n                    {renderBlockCard(\"lop3_yte_so\")}\n                    {renderBlockCard(\"lop3_datdai_tnmt\")}\n                    {renderBlockCard(\"lop3_dothi_kinhte\")}\n                  </div>\n                </div>\n\n              </div>\n            </div>\n\n            {/* ------------------------------------------------------------- */}\n            {/* LỚP 2: DỮ LIỆU VÀ NỀN TẢNG LÕI */}\n            {/* ------------------------------------------------------------- */}\n            <div className=\"bg-blue-50/60 p-3.5 rounded-2xl border-2 border-blue-300 shadow-2xs\">\n              <div className=\"flex items-center justify-between mb-2.5\">\n                <span className=\"font-bold text-xs uppercase tracking-wide text-blue-950 flex items-center gap-1.5\">\n                  <NodeIndexOutlined className=\"text-blue-700 text-sm\" /> LỚP 2: DỮ LIỆU VÀ NỀN TẢNG LÕI (LGSP / NDXP • KHO DỮ LIỆU • CSDL QUỐC GIA)\n                </span>\n                <span className=\"text-[11px] text-blue-900 font-bold bg-blue-200/80 px-2 py-0.5 rounded border border-blue-300\">\n                  Trục liên thông • Master Data • Nền tảng dùng chung\n                </span>\n              </div>\n              <div className=\"grid grid-cols-1 md:grid-cols-4 gap-2.5\">\n                {renderBlockCard(\"lop2_lgsp_ndxp\")}\n                {renderBlockCard(\"lop2_kho_dulieu_master\")}\n                {renderBlockCard(\"lop2_csdl_quocgia\")}\n                {renderBlockCard(\"lop2_nentang_loi\")}\n              </div>\n            </div>\n\n            {/* ------------------------------------------------------------- */}\n            {/* LỚP 1: HẠ TẦNG SỐ VÀ AN NINH MẠNG DÙNG CHUNG */}\n            {/* ------------------------------------------------------------- */}\n            <div className=\"bg-purple-50/60 p-3.5 rounded-2xl border-2 border-purple-300 shadow-2xs\">\n              <div className=\"flex items-center justify-between mb-2.5\">\n                <span className=\"font-bold text-xs uppercase tracking-wide text-purple-950 flex items-center gap-1.5\">\n                  <CloudServerOutlined className=\"text-purple-700 text-sm\" /> LỚP 1: HẠ TẦNG SỐ VÀ AN NINH MẠNG DÙNG CHUNG (CLOUD • MẠNG TSLCD • SOC 4 LỚP)\n                </span>\n                <span className=\"text-[11px] text-purple-900 font-bold bg-purple-200/80 px-2 py-0.5 rounded border border-purple-300\">\n                  Hạ tầng tính toán • Mạng truyền dẫn • An toàn thông tin\n                </span>\n              </div>\n              <div className=\"grid grid-cols-1 md:grid-cols-4 gap-2.5\">\n                {renderBlockCard(\"lop1_idc_cloud\")}\n                {renderBlockCard(\"lop1_mang_tslcd\")}\n                {renderBlockCard(\"lop1_soc_anm\")}\n                {renderBlockCard(\"lop1_iot_bien\")}\n              </div>\n            </div>\n\n          </div>\n\n          {/* ========================================================================= */}\n          {/* CỘT PHẢI: 2 THÀNH PHẦN XUYÊN SUỐT (AI FIRST & DATA-CENTRIC) */}\n          {/* ========================================================================= */}\n          <div className=\"lg:col-span-2 bg-gradient-to-b from-indigo-50 via-purple-50 to-blue-100 p-4 rounded-2xl border-2 border-indigo-300 flex flex-col justify-between shadow-2xs space-y-4\">\n            <div>\n              <div className=\"flex items-center gap-1.5 font-bold text-indigo-950 text-xs mb-3 border-b-2 border-indigo-300 pb-2\">\n                <ThunderboltOutlined className=\"text-indigo-700 text-base\" />\n                <span>THÀNH PHẦN XUYÊN SUỐT (III & IV)</span>\n              </div>\n\n              {/* 3. AI First */}\n              <div className=\"mb-4 bg-white/80 p-3 rounded-xl border border-indigo-300\">\n                <div className=\"font-bold text-indigo-950 text-xs flex items-center gap-1 mb-1.5\">\n                  <RobotOutlined className=\"text-indigo-600\" />\n                  <span>3. Ưu tiên AI (AI First)</span>\n                </div>\n                <ul className=\"text-[11px] text-indigo-900 space-y-1.5 pl-3.5 list-disc m-0\">\n                  <li>Trợ lý ảo AI phục vụ CCVC</li>\n                  <li>Trợ lý ảo AI hỗ trợ DVC</li>\n                  <li>Tự động hóa bóc tách hồ sơ</li>\n                  <li>Phân tích dự báo & điều hành</li>\n                </ul>\n              </div>\n\n              {/* 4. Data Centric */}\n              <div className=\"bg-white/80 p-3 rounded-xl border border-indigo-300\">\n                <div className=\"font-bold text-indigo-950 text-xs flex items-center gap-1 mb-1.5\">\n                  <DatabaseOutlined className=\"text-blue-700\" />\n                  <span>4. Dữ liệu trung tâm (Data-Centric)</span>\n                </div>\n                <ul className=\"text-[11px] text-indigo-900 space-y-1.5 pl-3.5 list-disc m-0\">\n                  <li>Dữ liệu \"Đúng-Đủ-Sạch-Sống\"</li>\n                  <li>Mở và chia sẻ theo mặc định</li>\n                  <li>Xóa bỏ cát cứ dữ liệu</li>\n                  <li>Khai thác giá trị dữ liệu số</li>\n                </ul>\n              </div>\n            </div>\n\n            <div className=\"pt-2 border-t border-indigo-300 text-[11px] text-indigo-700 text-center font-bold uppercase tracking-wider\">\n              Động Lực Công Nghệ & Dữ Liệu\n            </div>\n          </div>\n\n        </div>\n      </Card>\n\n      {/* DETAIL MODAL WHEN CLICKING ANY BLOCK */}\n      <Modal\n        title={\n          <div className=\"flex items-center gap-2 pr-6\">\n            <span className=\"text-xl\" style={{ color: selectedBlock?.color }}>{selectedBlock?.icon}</span>\n            <span className=\"font-bold text-base text-gray-800\">{selectedBlock?.title}</span>\n          </div>\n        }\n        open={!!selectedBlock}\n        onCancel={() => setSelectedBlock(null)}\n        footer={[\n          <Button key=\"close\" type=\"primary\" onClick={() => setSelectedBlock(null)}>\n            Đóng\n          </Button>,\n        ]}\n        width={750}\n        destroyOnHidden\n      >\n        {selectedBlock && (\n          <div className=\"space-y-4 mt-3\">\n            <div className=\"bg-slate-50 p-3 rounded-lg border border-slate-200 text-xs text-gray-700 leading-relaxed\">\n              <b>Phân loại kiến trúc:</b> <Tag color=\"blue\">{selectedBlock.category}</Tag>\n              <div className=\"mt-1\">{selectedBlock.description}</div>\n            </div>\n\n            {/* Nhiệm vụ lộ trình liên quan */}\n            <div>\n              <div className=\"font-bold text-gray-800 text-sm mb-2 flex items-center gap-1.5\">\n                <ThunderboltOutlined className=\"text-amber-500\" />\n                <span>Nhiệm vụ & Đề án Lộ trình liên quan ({getMatchedTasks(selectedBlock).length}):</span>\n              </div>\n              {getMatchedTasks(selectedBlock).length > 0 ? (\n                <div className=\"space-y-2\">\n                  {getMatchedTasks(selectedBlock).map((nv) => (\n                    <div key={nv.id} className=\"p-3 bg-amber-50/60 rounded-lg border border-amber-200 flex justify-between items-center\">\n                      <div>\n                        <div className=\"font-semibold text-gray-800 text-xs\">\n                          <span className=\"font-mono bg-amber-100 text-amber-800 px-1.5 py-0.5 rounded mr-1.5\">{nv.ma}</span>\n                          {nv.ten}\n                        </div>\n                        <div className=\"text-[11px] text-gray-500 mt-1\">\n                          Chủ trì: {nv.donViChuTri?.ten || \"UBND tỉnh\"} • Hạn: {nv.thoiHan ? new Date(nv.thoiHan).toLocaleDateString(\"vi-VN\") : \"—\"}\n                        </div>\n                      </div>\n                      <span className=\"font-bold text-xs text-blue-600 bg-white px-2 py-1 rounded border border-blue-200\">\n                        {nv.tienDo}%\n                      </span>\n                    </div>\n                  ))}\n                </div>\n              ) : (\n                <div className=\"text-xs text-gray-400 italic bg-gray-50 p-2 rounded\">\n                  (Khối này hiện đang vận hành ổn định, không có dự án nâng cấp quy mô lớn trong lộ trình hiện tại)\n                </div>\n              )}\n            </div>\n\n            {/* Danh sách hệ thống số hiện trạng */}\n            <div>\n              <div className=\"font-bold text-gray-800 text-sm mb-2 flex items-center gap-1.5\">\n                <DatabaseOutlined className=\"text-blue-500\" />\n                <span>Hệ thống số & CSDL Hiện trạng thuộc khối này ({getMatchedItems(selectedBlock).length}):</span>\n              </div>\n              {getMatchedItems(selectedBlock).length > 0 ? (\n                <div className=\"max-h-60 overflow-y-auto space-y-1.5 pr-1\">\n                  {getMatchedItems(selectedBlock).slice(0, 30).map((ht) => (\n                    <div key={ht.id} className=\"p-2 bg-white rounded border border-gray-200 hover:border-blue-300 text-xs flex justify-between items-center\">\n                      <div className=\"flex-1 pr-2\">\n                        <span className=\"font-mono font-bold text-slate-800 bg-slate-200 px-1.5 py-0.5 rounded mr-1.5 text-[10px]\">\n                          {ht.ma}\n                        </span>\n                        <span className=\"font-medium text-gray-800\">{ht.ten}</span>\n                        <div className=\"text-[10px] text-gray-400 mt-0.5\">\n                          {ht.donVi?.ten || ht.chuQuan || \"Chưa xác định\"} {ht.namTrienKhai ? `• Năm ${ht.namTrienKhai}` : \"\"}\n                        </div>\n                      </div>\n                      <span className={`text-[10px] font-bold px-2 py-0.5 rounded border ${TRANG_THAI_CONFIG[ht.trangThai]?.badgeClass || \"\"}`}>\n                        {TRANG_THAI_CONFIG[ht.trangThai]?.label || ht.trangThai}\n                      </span>\n                    </div>\n                  ))}\n                  {getMatchedItems(selectedBlock).length > 30 && (\n                    <div className=\"text-center text-xs text-blue-600 py-2\">\n                      ...và còn {getMatchedItems(selectedBlock).length - 30} CSDL/phần mềm chuyên ngành khác.\n                    </div>\n                  )}\n                </div>\n              ) : (\n                <div className=\"text-xs text-gray-400 italic bg-gray-50 p-2 rounded\">\n                  (Khối này đóng vai trò quy chuẩn mục tiêu kết nối liên thông)\n                </div>\n              )}\n            </div>\n          </div>\n        )}\n      </Modal>\n    </div>\n  );\n}\n","Description":"Update Sơ đồ Khung KTS to match QĐ 1425/QĐ-TTg standard 4 layers and 4 cross-cutting elements","Overwrite":true,"TargetFile":"e:/KTS/123/src/app/(portal)/kts/so-do/page.tsx","toolAction":"Updating Architecture Blueprint Diagram","toolSummary":"Rewrite SoDoKhungKTS to match QD 1425 PB 1.0"}}]}
