00\">\n    <div class=\"flex h-screen overflow-hidden\">\n        \n        <!-- Sidebar -->\n        <aside class=\"w-64 bg-blue-900 text-white flex-shrink-0 flex flex-col\">\n            <div class=\"p-4 border-b border-blue-800 flex items-center gap-3\">\n    