     return (\r\n79:           <Tag style={{ color: cfg.color, borderColor: cfg.borderColor, backgroundColor: cfg.bgColor }}>\r\n80:             {cfg.icon} Lớp {lop}\r\n81:           </Tag>\r\n82:         );\r\n83:       },\r\n84:     },\r\n85:     {\r\n86:       title: \"Đơn vị\",\r\n87:       dataIndex: [\"donViChuTri\", \"ten\"],\r\n88:       width: 160,\r\n89:       render: (_, rec) => rec.donViChuTri?.ten || \"—\",\r\n90:     },\r\n91:     {\r\n92:       title: \"Ưu tiên\",\r\n93:       dataIndex: \"uuTien\",\r\n94:       width: 100,\r\n95:       render: (uuTien) => {\r\n96:         const cfg = UU_TIEN_CONFIG[uuTien] || { label: uuTien, color: \"#8c8c8c\" };\r\n97:         return <Tag color={uuTien === \"cao\" ? \"red\" : uuTien === \"trung-binh\" ? \"orange\" : \"green\"}>{cfg.label}</Tag>;\r\n98:       },\r\n99:     },\r\n100:     {\r\n101:       title: \"Thời hạn\",\r\n102:       dataIndex: \"thoiHan\",\r\n103:       width: 120,\r\n104:       render: (thoiHan, rec) => {\r\n105:         if (!thoiHan) return \"—\";\r\n106:         const overdue = isOverdue(thoiHan) && rec.trangThai !== \"hoan-thanh\";\r\n107:         const days = getDaysRemaining(thoiHan);\r\n108:         return (\r\n109:           <Tooltip title={days !== null ? (overdue ? `Trễ ${Math.abs(days)} ngày` : `Còn ${days} ngày`) : \"\"}>\r\n110:             <span className={overdue ? \"text-red-500 font-semibold\" : days !== null && days <= 30 ? \"text-orange-500\" : \"text-gray-600\"}>\r\n111:               {overdue && <WarningOutlined className=\"mr-1\" />}\r\n112:               {formatDate(thoiHan)}\r\n113:             </span>\r\n114:           </Tooltip>\r\n115:         );\r\n116:       },\r\n117:     },\r\n118:     {\r\n119:       title: \"Tiến độ\",\r\n120:       dataIndex: \"tienDo\",\r\n121:       width: 160,\r\n122:       render: (tienDo, rec) => (\r\n123:         <div>\r\n124:           <Progress\r\n125:             percent={tienDo}\r\n126:             size=\"small\"\r\n127:             s