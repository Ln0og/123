ns.Item label=\"Đơn vị chủ quản\">\r\n166:             <div className=\"flex items-center gap-2\">\r\n167:               <BankOutlined className=\"text-gray-400\" />\r\n168:               {selectedItem.donVi?.ten || selectedItem.chuQuan || \"Chưa xác định\"}\r\n169:             </div>\r\n170:           </Descriptions.Item>\r\n171:           \r\n172:           <Descriptions.Item label=\"Năm triển khai\">\r\n173:             {selectedItem.namTrienKhai || \"Chưa xác định\"}\r\n174:           </Descriptions.Item>\r\n175: \r\n176:           {tenMienAttr && (\r\n177:             <Descriptions.Item label=\"Tên miền truy cập\">\r\n178:               <div className=\"flex items-center gap-2\">\r\n179:                 <GlobalOutlined className=\"text-blue-500\" />\r\n180:                 <a href={tenMienAttr.value.startsWith('http') ? tenMienAttr.value : `https://${tenMienAttr.value}`} target=\"_blank\" rel=\"noreferrer\" className=\"text-blue-600 hover:underline\">\r\n181:                   {tenMienAttr.value}\r\n182:                 </a>\r\n183:               </div>\r\n184:             </Descriptions.Item>\r\n185:           )}\r\n186: \r\n187:           {otherAttributes.map((attr, idx) => (\r\n188:             <Descriptions.Item key={idx} label={attr.key}>\r\n189:               <span className=\"whitespace-pre-wrap\">{attr.value}</span>\r\n190:             </Descriptions.Item>\r\n191:           ))}\r\n192:           \r\n193:           {selectedItem.nhiemVus && selectedItem.nhiemVus.length > 0 && (\r\n194:             <Descriptions.Item label=\"Nhiệm vụ lộ trình liên quan\">\r\n195:               <div className=\"flex flex-col gap-2\">\r\n196:                 {selectedItem.nhiemVus.map((nv, idx) => (\r\n197:                   <div key={idx} className=\"bg-blue-50 p-2 rounded border border-blue-100\">\r\n198:                     <div className=\"font-semibold text-blue-800 text-sm\">{nv.ten}</div>\r\n199:                     <div className=\"text-xs text-blue-600 mt-1 flex justify-between\">\r\n200:                       <span>Tiến độ: {nv.tienDo}%</span>\r\n201:                       <span>Hạn chót: {nv.thoiHan ? new Date(nv.thoiHan).toLocaleDateString(\"vi-VN\") : \"Chưa xác định\"}</span>\r\n202:                     </div>\r\n203:                   </div>\r\n204:                 ))}\r\n205:               </div>\r\n206:             </Descriptions.Item>\r\n207:           )}\r\n208:         </Descriptions>\r\n209:       </div>\r\n210:     );\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
{"step_index":163,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-21T00:37:55Z","thinking":"Considering how to add state to track a selected task, a state variable `selectedTask` will store task data. Then a modal component will render the details of the `selectedTask`, including specific task fields like code, name, architecture, priority, status, and descriptions. Description details will be formatted to display the responsible unit, deadline, and remaining days.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"use client\";\nimport { useEffect, useState } from \"react\";\nimport { Table, Tag, Progress, Select, Card, Badge, Tooltip, Modal, Descriptions, Button } from \"antd\";\nimport { \n  WarningOutlined, \n  CheckCircleOutlined, \n  ClockCircleOutlined, \n  BankOutlined, \n  CalendarOutlined, \n  ApartmentOutlined,\n  ThunderboltOutlined,\n  FileTextOutlined,\n  CheckSquareOutlined,\n  EyeOutlined\n} from \"@ant-design/icons\";\nimport type { ColumnsType } from \"antd/es/table\";\nimport { NhiemVuData } from \"@/types\";\nimport { LOP_CONFIG, TRANG_THAI_CONFIG, UU_TIEN_CONFIG, PHUONG_AN_CONFIG, formatDate, isOverdue, getDaysRemaining } from \"@/lib/utils\";\n\nexport default function LoTrinhPage() {\n  const [data, setData] = useState<NhiemVuData[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [filterLop, setFilterLop] = useState<string>(\"\");\n  const [filterTrangThai, setFilterTrangThai] = useState<string>(\"\");\n  const [selectedTask, setSelectedTask] = useState<NhiemVuData | null>(null);\n\n  useEffect(() => {\n    fetch(\"/api/nhiem-vu\")\n      .then((r) => r.json())\n      .then((d) => {\n        setData(Array.isArray(d) ? d : []);\n        setLoading(false);\n      })\n      .catch(() => {\n        setData([]);\n        setLoading(false);\n      });\n  }, []);\n\n  const filtered = data.filter((d) => {\n    if (filterLop && d.lop !== parseInt(filterLop)) return false;\n    if (filterTrangThai && d.trangThai !== filterTrangThai) return false;\n    return true;\n  });\n\n  const columns: ColumnsType<NhiemVuData> = [\n    {\n      title: \"Mã\",\n      dataIndex: \"ma\",\n      width: 90,\n      render: (ma) => <span className=\"font-mono text-xs bg-gray-100 font-semibold text-gray-700 px-2 py-1 rounded\">{ma}</span>,\n    },\n    {\n      title: \"Nhiệm vụ\",\n      dataIndex: \"ten\",\n      render: (ten, rec) => (\n        <div className=\"group\">\n          <div className=\"font-medium text-gray-800 group-hover:text-blue-600 transition-colors flex items-center gap-1.5\">\n            <span>{ten}</span>\n            <EyeOutlined className=\"text-gray-300 group-hover:text-blue-500 text-xs opacity-0 group-hover:opacity-100 transition-opacity\" />\n          </div>\n          {rec.moTa && <div className=\"text-xs text-gray-400 mt-0.5 line-clamp-2\">{rec.moTa}</div>}\n          {rec.phuongAnXuLy && (\n            <div className=\"text-xs mt-1 text-blue-600 flex items-center gap-1\">\n              <span className=\"inline-block w-1.5 h-1.5 rounded-full bg-blue-500\"></span>\n              {PHUONG_AN_CONFIG[rec.phuongAnXuLy] || rec.phuongAnXuLy}\n            </div>\n          )}\n          {rec.heThongSos && rec.heThongSos.length > 0 && (\n            <div className=\"mt-2 text-xs border-t border-dashed pt-1\">\n              <span className=\"text-gray-500 mr-1\">Tác động đến Hệ thống:</span>\n              <div className=\"flex flex-wrap gap-1 mt-1\">\n                {rec.heThongSos.map(ht => (\n                  <Tooltip key={ht.id} title={ht.ten}>\n                    <Tag className=\"m-0 text-[10px] bg-blue-50 border-blue-200 text-blue-600\">\n                      {ht.ma}\n                    </Tag>\n                  </Tooltip>\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n      ),\n    },\n    {\n      title: \"Lớp\",\n      dataIndex: \"lop\",\n      width: 120,\n      filters: [1, 2, 3, 4].map((l) => ({ text: LOP_CONFIG[l as 1|2|3|4].shortLabel, value: l })),\n      onFilter: (value, record) => record.lop === value,\n      render: (lop) => {\n        const cfg = LOP_CONFIG[lop as 1|2|3|4];\n        return (\n          <Tag style={{ color: cfg.color, borderColor: cfg.borderColor, backgroundColor: cfg.bgColor }}>\n            {cfg.icon} Lớp {lop}\n          </Tag>\n        );\n      },\n    },\n    {\n      title: \"Đơn vị chủ trì\",\n      dataIndex: [\"donViChuTri\", \"ten\"],\n      width: 180,\n      render: (_, rec) => rec.donViChuTri?.ten || \"—\",\n    },\n    {\n      title: \"Ưu tiên\",\n      dataIndex: \"uuTien\",\n      width: 110,\n      render: (uuTien) => {\n        const cfg = UU_TIEN_CONFIG[uuTien] || { label: uuTien, color: \"#8c8c8c\" };\n        return <Tag color={uuTien === \"cao\" ? \"red\" : uuTien === \"trung-binh\" ? \"orange\" : \"green\"}>{cfg.label}</Tag>;\n      },\n    },\n    {\n      title: \"Thời hạn\",\n      dataIndex: \"thoiHan\",\n      width: 130,\n      render: (thoiHan, rec) => {\n        if (!thoiHan) return \"—\";\n        const overdue = isOverdue(thoiHan) && rec.trangThai !== \"hoan-thanh\";\n        const days = getDaysRemaining(thoiHan);\n        return (\n          <Tooltip title={days !== null ? (overdue ? `Trễ ${Math.abs(days)} ngày` : `Còn ${days} ngày`) : \"\"}>\n            <span className={overdue ? \"text-red-500 font-semibold\" : days !== null && days <= 30 ? \"text-orange-500\" : \"text-gray-600\"}>\n              {overdue && <WarningOutlined className=\"mr-1\" />}\n              {formatDate(thoiHan)}\n            </span>\n          </Tooltip>\n        );\n      },\n    },\n    {\n      title: \"Tiến độ\",\n      dataIndex: \"tienDo\",\n      width: 160,\n      render: (tienDo, rec) => (\n        <div>\n          <Progress\n            percent={tienDo}\n            size=\"small\"\n            status={rec.trangThai === \"tre-han\" ? \"exception\" : rec.trangThai === \"hoan-thanh\" ? \"success\" : \"active\"}\n            strokeColor={\n              rec.trangThai === \"hoan-thanh\" ? \"#52c41a\" :\n              rec.trangThai === \"tre-han\" ? \"#ff4d4f\" :\n              tienDo > 50 ? \"#1677ff\" : \"#faad14\"\n            }\n          />\n          <div className=\"text-xs text-gray-400 mt-0.5\">\n            {TRANG_THAI_CONFIG[rec.trangThai]?.label || rec.trangThai}\n          </div>\n        </div>\n      ),\n    },\n  ];\n\n  const tongHT = data.filter(d => d.trangThai === 'hoan-thanh').length;\n  const tongDT = data.filter(d => d.trangThai === 'dang-thuc-hien').length;\n  const tongTH = data.filter(d => d.trangThai === 'tre-han' || (d.thoiHan && isOverdue(d.thoiHan) && d.trangThai !== 'hoan-thanh')).length;\n\n  const renderModalContent = () => {\n    if (!selectedTask) return null;\n    const lopCfg = LOP_CONFIG[selectedTask.lop as 1 | 2 | 3 | 4] || LOP_CONFIG[1];\n    const overdue = selectedTask.thoiHan ? isOverdue(selectedTask.thoiHan) && selectedTask.trangThai !== \"hoan-thanh\" : false;\n    const days = selectedTask.thoiHan ? getDaysRemaining(selectedTask.thoiHan) : null;\n\n    return (\n      <div className=\"mt-3 space-y-4\">\n        {/* Badges and Tags */}\n        <div className=\"flex flex-wrap gap-2 items-center\">\n          <Tag className=\"font-mono font-bold text-sm bg-gray-100 text-gray-800 px-2 py-0.5\">\n            {selectedTask.ma}\n          </Tag>\n          <Tag style={{ color: lopCfg.color, borderColor: lopCfg.borderColor, backgroundColor: lopCfg.bgColor }}>\n            {lopCfg.icon} Lớp {selectedTask.lop}: {lopCfg.title}\n          </Tag>\n          <Tag color={selectedTask.uuTien === \"cao\" ? \"red\" : selectedTask.uuTien === \"trung-binh\" ? \"orange\" : \"green\"}>\n            Ưu tiên: {UU_TIEN_CONFIG[selectedTask.uuTien]?.label || selectedTask.uuTien}\n          </Tag>\n          <Tag color={TRANG_THAI_CONFIG[selectedTask.trangThai]?.antdColor || \"default\"}>\n            {TRANG_THAI_CONFIG[selectedTask.trangThai]?.label || selectedTask.trangThai}\n          </Tag>\n        </div>\n\n        {/* Descriptions Details */}\n        <Descriptions bordered column={1} size=\"small\" labelStyle={{ width: '32%', backgroundColor: '#f8fafc', fontWeight: 600 }}>\n          <Descriptions.Item label=\"Đơn vị chủ trì\">\n            <div className=\"flex items-center gap-2 font-medium text-gray-800\">\n              <BankOutlined className=\"text-blue-500\" />\n              {selectedTask.donViChuTri?.ten || \"UBND tỉnh Vĩnh Long\"}\n            </div>\n          </Descriptions.Item>\n\n          <Descriptions.Item label=\"Thời hạn hoàn thành\">\n            <div className=\"flex items-center gap-2\">\n              <CalendarOutlined className=\"text-gray-400\" />\n              <span>{selectedTask.thoiHan ? formatDate(selectedTask.thoiHan) : \"Chưa xác định\"}</span>\n              {days !== null && (\n                <Tag color={overdue ? \"error\" : days <= 30 ? \"warning\" : \"processing\"} className=\"ml-2\">\n                  {overdue ? `Trễ hạn ${Math.abs(days)} ngày` : `Còn lại ${days} ngày`}\n                </Tag>\n              )}\n            </div>\n          </Descriptions.Item>\n\n          {selectedTask.giaiDoan && (\n            <Descriptions.Item label=\"Giai đoạn áp dụng\">\n              {selectedTask.giaiDoan}\n            </Descriptions.Item>\n          )}\n\n          <Descriptions.Item label=\"Phương án xử lý\">\n            <div className=\"flex items-center gap-2 text-blue-700 font-semibold\">\n              <ThunderboltOutlined />\n              <span>{PHUONG_AN_CONFIG[selectedTask.phuongAnXuLy || \"\"] || selectedTask.phuongAnXuLy || \"Nâng cấp, phát triển mới\"}</span>\n            </div>\n          </Descriptions.Item>\n\n          <Descriptions.Item label=\"Tiến độ thực tế\">\n            <div className=\"w-full max-w-md py-1\">\n              <div className=\"flex justify-between text-xs text-gray-500 mb-1\">\n                <span>Mức độ hoàn thành</span>\n                <span className=\"font-bold text-gray-800\">{selectedTask.tienDo}%</span>\n              </div>\n              <Progress\n                percent={selectedTask.tienDo}\n                status={selectedTask.trangThai === \"tre-han\" ? \"exception\" : selectedTask.trangThai === \"hoan-thanh\" ? \"success\" : \"active\"}\n                strokeColor={\n                  selectedTask.trangThai === \"hoan-thanh\" ? \"#52c41a\" :\n                  selectedTask.trangThai === \"tre-han\" ? \"#ff4d4f\" :\n                  selectedTask.tienDo > 50 ? \"#1677ff\" : \"#faad14\"\n                }\n              />\n            </div>\n          </Descriptions.Item>\n\n          {selectedTask.moTa && (\n            <Descriptions.Item label=\"Mục tiêu & Mô tả\">\n              <div className=\"whitespace-pre-wrap text-gray-700 leading-relaxed\">\n                {selectedTask.moTa}\n              </div>\n            </Descriptions.Item>\n          )}\n\n          {selectedTask.kpi && (\n            <Descriptions.Item label=\"Chỉ số KPI / Kết quả đầu ra\">\n              <div className=\"flex items-start gap-2 text-gray-700\">\n                <CheckSquareOutlined className=\"text-green-500 mt-0.5\" />\n                <span>{selectedTask.kpi}</span>\n              </div>\n            </Descriptions.Item>\n          )}\n\n          {selectedTask.nguonKiemChung && (\n            <Descriptions.Item label=\"Nguồn kiểm chứng / Căn cứ\">\n              <div className=\"flex items-start gap-2 text-gray-600\">\n                <FileTextOutlined className=\"text-blue-500 mt-0.5\" />\n                <span>{selectedTask.nguonKiemChung}</span>\n              </div>\n            </Descriptions.Item>\n          )}\n\n          {selectedTask.ghiChu && (\n            <Descriptions.Item label=\"Ghi chú\">\n              <span className=\"italic text-gray-500\">{selectedTask.ghiChu}</span>\n            </Descriptions.Item>\n          )}\n        </Descriptions>\n\n        {/* Impacted Systems List */}\n        <div className=\"bg-slate-50 p-3 rounded-lg border border-slate-200\">\n          <div className=\"font-semibold text-gray-800 text-sm mb-2 flex items-center gap-2\">\n            <ApartmentOutlined className=\"text-blue-600\" />\n            <span>Các Hệ Thống Số Hiện Trạng Chịu Tác Động / Liên Quan:</span>\n          </div>\n\n          {selectedTask.heThongSos && selectedTask.heThongSos.length > 0 ? (\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-2 mt-2\">\n              {selectedTask.heThongSos.map((ht) => (\n                <div key={ht.id} className=\"bg-white p-2.5 rounded border border-gray-200 shadow-xs flex justify-between items-start\">\n                  <div>\n                    <div className=\"font-semibold text-gray-800 text-xs line-clamp-1\">{ht.ten}</div>\n                    <div className=\"text-[11px] text-gray-500 mt-0.5\">{ht.donVi?.ten || ht.chuQuan || \"Chưa xác định\"}</div>\n                  </div>\n                  <Tag className=\"m-0 font-mono text-[10px] bg-blue-50 text-blue-600 border-blue-200\">\n                    {ht.ma}\n                  </Tag>\n                </div>\n              ))}\n            </div>\n          ) : (\n            <div className=\"text-xs text-gray-500 italic py-1\">\n              (Nhiệm vụ này là đề án xây dựng nền tảng mới hoặc tác động tổng thể trên toàn tỉnh)\n            </div>\n          )}\n        </div>\n      </div>\n    );\n  };\n\n  return (\n    <div className=\"max-w-6xl mx-auto space-y-4\">\n      {/* Quick stats */}\n      <div className=\"flex gap-4 mb-4\">\n        <Badge count={data.length} color=\"#1677ff\" overflowCount={99}>\n          <Card size=\"small\" className=\"px-4 py-2 min-w-[100px] text-center\">\n            <div className=\"text-lg font-bold text-gray-800\">{data.length}</div>\n            <div className=\"text-xs text-gray-400\">Tổng nhiệm vụ</div>\n          </Card>\n        </Badge>\n        <Card size=\"small\" className=\"px-4 py-2 min-w-[100px] text-center bg-green-50 border-green-200\">\n          <div className=\"text-lg font-bold text-green-600\"><CheckCircleOutlined /> {tongHT}</div>\n          <div className=\"text-xs text-gray-400\">Hoàn thành</div>\n        </Card>\n        <Card size=\"small\" className=\"px-4 py-2 min-w-[100px] text-center bg-blue-50 border-blue-200\">\n          <div className=\"text-lg font-bold text-blue-600\"><ClockCircleOutlined /> {tongDT}</div>\n          <div className=\"text-xs text-gray-400\">Đang thực hiện</div>\n        </Card>\n        <Card size=\"small\" className=\"px-4 py-2 min-w-[100px] text-center bg-red-50 border-red-200\">\n          <div className=\"text-lg font-bold text-red-600\"><WarningOutlined /> {tongTH}</div>\n          <div className=\"text-xs text-gray-400\">Cảnh báo</div>\n        </Card>\n      </div>\n\n      {/* Filters */}\n      <Card className=\"mb-4 shadow-sm\" size=\"small\">\n        <div className=\"flex gap-4 items-center flex-wrap\">\n          <span className=\"text-gray-600 font-medium text-sm\">Lọc:</span>\n          <Select\n            placeholder=\"Tất cả lớp\"\n            allowClear\n            style={{ width: 190 }}\n            onChange={setFilterLop}\n          >\n            {[1, 2, 3, 4].map((l) => (\n              <Select.Option key={l} value={String(l)}>\n                {LOP_CONFIG[l as 1|2|3|4].icon} {LOP_CONFIG[l as 1|2|3|4].shortLabel}\n              </Select.Option>\n            ))}\n          </Select>\n          <Select\n            placeholder=\"Tất cả trạng thái\"\n            allowClear\n            style={{ width: 190 }}\n            onChange={setFilterTrangThai}\n          >\n            {Object.entries(TRANG_THAI_CONFIG).map(([k, v]) => (\n              <Select.Option key={k} value={k}>{v.label}</Select.Option>\n            ))}\n          </Select>\n          <span className=\"text-gray-400 text-xs ml-auto\">\n            💡 Nhấp vào bất kỳ hàng nào để xem thông tin chi tiết nhiệm vụ\n          </span>\n        </div>\n      </Card>\n\n      <Card className=\"shadow-sm\">\n        <Table\n          columns={columns}\n          dataSource={filtered}\n          rowKey=\"id\"\n          loading={loading}\n          pagination={{ pageSize: 20 }}\n          onRow={(record) => ({\n            onClick: () => setSelectedTask(record),\n            className: \"cursor-pointer hover:bg-blue-50/50 transition-colors\",\n          })}\n          rowClassName={(record) => {\n            if (record.trangThai === \"hoan-thanh\") return \"bg-green-50/30\";\n            if (isOverdue(record.thoiHan) && record.trangThai !== \"hoan-thanh\") return \"bg-red-50/30\";\n            return \"\";\n          }}\n        />\n      </Card>\n\n      {/* Detail Modal */}\n      <Modal\n        title={\n          <div className=\"text-base font-bold text-gray-800 pr-6 leading-normal\">\n            {selectedTask?.ten}\n          </div>\n        }\n        open={!!selectedTask}\n        onCancel={() => setSelectedTask(null)}\n        footer={[\n          <Button key=\"close\" type=\"primary\" onClick={() => setSelectedTask(null)}>\n            Đóng\n          </Button>\n        ]}\n        width={750}\n        destroyOnClose\n      >\n        {renderModalContent()}\n      </Modal>\n    </div>\n  );\n}\n","Description":"Add detail popup modal for tasks in lo-trinh page","Overwrite":true,"TargetFile":"e:\\KTS\\123\\src\\app\\(portal)\\kts\\lo-trinh\\page.tsx","toolAction":"Updating lo-trinh page","toolSummary":"Add popup modal to lo-trinh"}}]}
