ld text-green-600\"><CheckCircleOutlined /> {tongHT}</div>\r\n165:           <div className=\"text-xs text-gray-400\">Hoàn thành</div>\r\n166:         </Card>\r\n167:         <Card size=\"small\" className=\"px-4 py-2 min-w-[100px] text-center bg-blue-50 border-blue-200\">\r\n168:           <div className=\"text-lg font-bold text-blue-600\"><ClockCircleOutlined /> {tongDT}</div>\r\n169:           <div className=\"text-xs text-gray-400\">Đang thực hiện</div>\r\n170:         </Card>\r\n171:         <Card size=\"small\" className=\"px-4 py-2 min-w-[100px] text-center bg-red-50 border-red-200\">\r\n172:           <div className=\"text-lg font-bold text-red-600\"><WarningOutlined /> {tongTH}</div>\r\n173:           <div className=\"text-xs text-gray-400\">Cảnh báo</div>\r\n174:         </Card>\r\n175:       </div>\r\n176: \r\n177:       {/* Filters */}\r\n178:       <Card className=\"mb-4 shadow-sm\">\r\n179:         <div className=\"flex gap-4 items-center\">\r\n180:           <span className=\"text-gray-600 font-medium\">Lọc:</span>\r\n181:           <Select\r\n182:             placeholder=\"Tất cả lớp\"\r\n183:             allowClear\r\n184:             style={{ width: 200 }}\r\n185:             onChange={setFilterLop}\r\n186:           >\r\n187:             {[1, 2, 3, 4].map((l) => (\r\n188:               <Select.Option key={l} value={String(l)}>\r\n189:                 {LOP_CONFIG[l as 1|2|3|4].icon} {LOP_CONFIG[l as 1|2|3|4].shortLabel}\r\n190:               </Select.Option>\r\n191:             ))}\r\n192:           </Select>\r\n193:           <Select\r\n194:             placeholder=\"Tất cả trạng thái\"\r\n195:             allowClear\r\n196:             style={{ width: 200 }}\r\n197:             onChange={setFilterTrangThai}\r\n198:           >\r\n199:             {Object.entries(TRANG_THAI_CONFIG).map(([k, v]) => (\r\n200:               <Select.Option key={k} value={k}>{v.label}</Select.Option>\r\n201:             ))}\r\n202:           </Select>\r\n203:          