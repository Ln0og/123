{"step_index":457,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-20T16:39:29Z","content":"Created At: 2026-09-20T23:39:29+07:00\nCompleted At: 2026-09-20T23:39:30+07:00\nFile Path: `file:///C:/Delta%20Force/kts-vinhlong/import_snn.js`\nTotal Lines: 97\nTotal Bytes: 3067\nShowing lines 1 to 97\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: const XLSX = require(\"xlsx\");\n2: const { PrismaClient } = require(\"@prisma/client\");\n3: \n4: const prisma = new PrismaClient();\n5: \n6: async function importExcel() {\n7:   const filePath = \"C:\\\\Delta Force\\\\v4. ten mien - snnmt - bo_sung_CSDL_theo_ND278_15.9.2026 (1).xlsx\";\n8:   console.log(\"Reading file:\", filePath);\n9:   \n10:   const workbook = XLSX.readFile(filePath);\n11:   const sheetName = workbook.SheetNames[0];\n12:   const sheet = workbook.Sheets[sheetName];\n13:   const rows = XLSX.utils.sheet_to_json(sheet, { header: 1 });\n14: \n15:   // Get or create the \"Sở Nông nghiệp và Môi trường\" unit\n16:   let donVi = await prisma.donVi.findFirst({\n17:     where: { ten: { contains: \"Sở Nông nghiệp\" } }\n18:   });\n19: \n20:   if (!donVi) {\n21:     const tinh = await prisma.donVi.findFirst({ where: { loai: \"tinh\" } });\n22:     donVi = await prisma.donVi.create({\n23:       data: {\n24:         ten: \"Sở Nông nghiệp và Phát triển nông thôn\",\n25:         loai: \"so\",\n26:         parentId: tinh ? tinh.id : null,\n27:       }\n28:     });\n29:     console.log(\"Created Đơn vị:\", donVi.ten);\n30:   } else {\n31:     console.log(\"Found Đơn vị:\", donVi.ten);\n32:   }\n33: \n34:   let successCount = 0;\n35: \n36:   for (let i = 1; i < rows.length; i++) {\n37:     const row = rows[i];\n38:     if (!row || !row[1]) continue; // Skip empty rows\n39: \n40:     const ten = String(row[1]).trim();\n41:     const ma = `SNN-${String(row[0] || i).padStart(2, \"0\")}`;\n42:     const tenMien = row[2] ? String(row[2]).trim() : \"\";\n43:     const donViQuanLy = row[4] ? String(row[4]).trim() : \"\";\n44:     const donViCon = row[5] ? String(row[5]).trim() : \"\";\n45:     \n46:     let chuQuan = donViQuanLy;\n47:     if (donViCon) chuQuan += ` - ${donViCon}`;\n48: \n49:     const rawTrangThai = String(row[9] || \"\").toLowerCase();\n50:     let trangThai = \"dang-van-hanh\";\n51:     if (rawTrangThai.includes(\"không\") || rawTrangThai.includes(\"dừng\")) {\n52:       trangThai = \"can-thay-the\";\n53:     }\n54: \n55:     const namStr = String(row[6] || \"\");\n56:     const namTrienKhai = parseInt(namStr) || null;\n57: \n58:     // Build moTa from domain and data sharing info\n59:     let moTaParts = [];\n60:     if (tenMien && tenMien !== \"Không có\") moTaParts.push(`Tên miền: ${tenMien}`);\n61:     if (row[13]) moTaParts.push(`Dữ liệu chia sẻ: ${String(row[13]).substring(0, 200)}...`);\n62:     if (row[14]) moTaParts.push(`Phạm vi: ${String(row[14]).substring(0, 200)}...`);\n63: \n64:     const isDuLieu = ten.toLowerCase().includes(\"csdl\") || ten.toLowerCase().includes(\"dữ liệu\");\n65:     const loai = isDuLieu ? \"du-lieu\" : \"ung-dung\";\n66:     const lop = isDuLieu ? 2 : 3;\n67: \n68:     try {\n69:       await prisma.heThongSo.create({\n70:         data: {\n71:           ma,\n72:           ten,\n73:           loai,\n74:           lop,\n75:           moTa: moTaParts.join(\"\\\\n\"),\n76:           chuQuan,\n77:           trangThai,\n78:           namTrienKhai,\n79:           donViId: donVi.id\n80:         }\n81:       });\n82:       successCount++;\n83:       console.log(`Imported: ${ma} - ${ten.substring(0, 30)}...`);\n84:     } catch (e) {\n85:       console.error(`Error importing row ${i}:`, e.message);\n86:     }\n87:   }\n88: \n89:   console.log(`\\\\n✅ Import completed: ${successCount} systems added.`);\n90:   await prisma.$disconnect(