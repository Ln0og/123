Link href=\"/admin\">Dashboard</Link> },\n44:     { key: \"/admin/khung\", icon: <ApartmentOutlined />, label: <Link href=\"/admin/khung\">Thông tin Khung KTS</Link> },\n45:     { key: \"/admin/he-thong\", icon: <AppstoreOutlined />, label: <Link href=\"/admin/he-thong\">Hệ thống số</Link> },\n46:     { key: \"/admin/nhiem-vu\", icon: <OrderedListOutlined />, label: <Link href=\"/admin/nhiem-vu\">Nhiệm vụ & Lộ trình</Link> },\n47:     { key: \"/admin/import\", icon: <UploadOutlined />, label: <Link href=\"/admin/import\">Import XLSX</Link> },\n48:   ];\n49: \n50:   const userMenu = {\n51:     items: [\n52:       { key: \"portal\", icon: <HomeOutlined />, label: <Link href=\"/\">Về trang portal</Link> },\n53:       { key: \"logout\", icon: <LogoutOutlined />, label: \"Đăng xuất\", danger: true, onClick: () => signOut({ callbackUrl: \"/login\" }) },\n54:     ],\n55:   };\n56: \n57:   const user = session.user as { name: string; email: string; role: string };\n58: \n59:   return (\n60:     <Layout style={{ minHeight: \"100vh\" }}>\n61:       <Sider width={220} theme=\"dark\" style={{ background: \"#001a3e\" }}>\n62:         <div className=\"p-4 border-b border-blue-900\">\n63:           <div className=\"flex items-center gap-2\">\n64:             <div className=\"w-8 h-8 bg-blue-500 rounded-lg flex items-center justify-center\">\n65:               <ApartmentOutlined className=\"text-white text-sm\" />\n66:             </div>\n67:             <div>\n68:               <div className=\"text-white text-sm font-bold leading-tight\">KTS Vĩnh Long</div>\n69:               <div className=\"text-blue-300 text-xs\">Quản trị hệ thống</div>\n70:             </div>\n71:           </div>\n72:         </div>\n73:         <Menu\n74:           theme=\"dark\"\n75:           mode=\"inline\"\n76:           selectedKeys={[pathname]}\n77:           items={menuItems}\n78:           style={{ background: \"#001a3e\", border: \"none\", marginTop: 8 }}\n79:         />\n80:       </Sider>\n81:   