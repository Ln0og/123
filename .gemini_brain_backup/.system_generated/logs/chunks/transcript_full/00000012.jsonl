{"step_index":633,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-20T17:42:09Z","content":"Created At: 2026-09-21T00:42:09+07:00\nCompleted At: 2026-09-21T00:42:10+07:00\nFile Path: `file:///C:/Delta%20Force/kts-vinhlong/src/app/%28portal%29/kts/lo-trinh/page.tsx`\nTotal Lines: 206\nTotal Bytes: 7758\nShowing lines 1 to 206\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"use client\";\n2: import { useEffect, useState } from \"react\";\n3: import { Table, Tag, Progress, Select, Card, Badge, Tooltip } from \"antd\";\n4: import { WarningOutlined, CheckCircleOutlined, ClockCircleOutlined } from \"@ant-design/icons\";\n5: import type { ColumnsType } from \"antd/es/table\";\n6: import { NhiemVuData } from \"@/types\";\n7: import { LOP_CONFIG, TRANG_THAI_CONFIG, UU_TIEN_CONFIG, PHUONG_AN_CONFIG, formatDate, isOverdue, getDaysRemaining } from \"@/lib/utils\";\n8: \n9: export default function LoTrinhPage() {\n10:   const [data, setData] = useState<NhiemVuData[]>([]);\n11:   const [loading, setLoading] = useState(true);\n12:   const [filterLop, setFilterLop] = useState<string>(\"\");\n13:   const [filterTrangThai, setFilterTrangThai] = useState<string>(\"\");\n14: \n15:   useEffect(() => {\n16:     fetch(\"/api/nhiem-vu\")\n17:       .then((r) => r.json())\n18:       .then((d) => { setData(d); setLoading(false); });\n19:   }, []);\n20: \n21:   const filtered = data.filter((d) => {\n22:     if (filterLop && d.lop !== parseInt(filterLop)) return false;\n23:     if (filterTrangThai && d.trangThai !== filterTrangThai) return false;\n24:     return true;\n25:   });\n26: \n27:   const columns: ColumnsType<NhiemVuData> = [\n28:     {\n29:       title: \"Mã\",\n30:       dataIndex: \"ma\",\n31:       width: 80,\n32:       render: (ma) => <span className=\"font-mono text-xs bg-gray-100 px-2 py-1 rounded\">{ma}</span>,\n33:     },\n34:     {\n35:       title: \"Nhiệm vụ\",\n36:       dataIndex: \"ten\",\n37:       render: (ten, rec) => (\n38:         <div>\n39:           <div className=\"font-medium text-gray-800\">{ten}</div>\n40:           {rec.moTa && <div className=\"text-xs text-gray-400 mt-0.5 line-clamp-2\">{rec.moTa}</div>}\n41:           {rec.phuongAnXuLy && (\n42:             <div className=\"text-xs mt-1 text-blue-600\">\n43:               {PHUONG_AN_CONFIG[rec.phuongAnXuLy] || rec.phuongAnXuLy}\n44:             </div>\n45:           )}\n46:         </div>\n47:       ),\n48:     },\n49:     {\n50:       title: \"Lớp\",\n51:       dataIndex: \"lop\",\n52:       width: 120,\n53:       filters: [1, 2, 3, 4].map((l) => ({ text: LOP_CONFIG[l as 1|2|3|4].shortLabel, value: l })),\n54:       onFilter: (value, record) => record.lop === value,\n55:       render: (lop) => {\n56:         const cfg = LOP_CONFIG[lop as 1|2|3|4];\n57:         return (\n58:           <Tag style={{ color: cfg.color, borderColor: cfg.borderColor, backgroundColor: cfg.bgColor }}>\n59:             {cfg.icon} Lớp {lop}\n60:           </Tag>\n61:         );\n62:       },\n63:     },\n64:     {\n65:       title: \"Đơn vị\",\n66:       dataIndex: [\"donViChuTri\", \"ten\"],\n67:       width: 160,\n68:       render: (_, rec) => rec.donViChuTri?.ten || \"—\",\n69:     },\n70:     {\n71:       title: \"Ưu tiên\",\n72:       dataIndex: \"uuTien\",\n73:       width: 100,\n74:       render: (uuTien) => {\n75:         const cfg = UU_TIEN_CONFIG[uuTien] || { label: uuTien, color: \"#8c8c8c\" };\n76:         return <Tag color={uuTien === \"cao\" ? \"red\" : uuTien === \"trung-binh\" ? \"orange\" : \"green\"}>{cfg.label}</Tag>;\n77:       },\n78:     },\n79:     {\n80:       title: \"Thời hạn\",\n81:       dataIndex: \"thoiHan\",\n82:       width: 120,\n83:       render: (thoiHan, rec) => {\n84:         if (!thoiHan) return \"—\";\n85:         const overdue = isOverdue(thoiHan) && rec.trangThai !== \"hoan-thanh\";\n86:         const days = getDaysRemaining(thoiHan);\n87:         return (\n88:           <Tooltip title={days !== null ? (overdue ? `Trễ ${Math.abs(days)} ngày` : `Còn ${days} ngày`) : \"\"}>\n89:             <span className={overdue ? \"text-red-500 font-semibold\" : days !== null && days <= 30 ? \"text-orange-500\" : \"text-gray-600\"}>\n90:               {overdue && <WarningOutlined className=\"mr-1\" />}\n91:               {formatDate(thoiHan)}\n92:             </span>\n93:           </Tooltip>\n94:         );\n95:       },\n96:     },\n97:     {\n98:       title: \"Tiến độ\",\n99:       dataIndex: \"tienDo\",\n100:       width: 160,\n101:       render: (tienDo, rec) => (\n102:         <div>\n103:           <Progress\n104:             percent={tienDo}\n105:             size=\"small\"\n106:             status={rec.trangThai === \"tre-han\" ? \"exception\" : rec.trangThai === \"hoan-thanh\" ? \"success\" : \"active\"}\n107:             strokeColor={\n108:               rec.trangThai === \"hoan-thanh\" ? \"#52c41a\" :\n109:               rec.trangThai === \"tre-han\" ? \"#ff4d4f\" :\n110:               tienDo > 50 ? \"#1677ff\" : \"#faad14\"\n111:             }\n112:           />\n113:           <div className=\"text-xs text-gray-400 mt-0.5\">\n114:             {TRANG_THAI_CONFIG[rec.trangThai]?.label || rec.trangThai}\n115:           </div>\n116:         </div>\n117:       ),\n118:     },\n119:   ];\n120: \n121:   const tongHT = data.filter(d => d.trangThai === 'hoan-thanh').length;\n122:   const tongDT = data.filter(d => d.trangThai === 'dang-thuc-hien').length;\n123:   const tongTH = data.filter(d => d.trangThai === 'tre-han' || (d.thoiHan && isOverdue(d.thoiHan) && d.trangThai !== 'hoan-thanh')).length;\n124: \n125:   return (\n126:     <div>\n127:       <div className=\"page-header mb-6\">\n128:         <h1 className=\"text-2xl font-bold\">Lộ trình Nhiệm vụ Chuyển đổi Kiến trúc</h1>\n129:         <p className=\"text-blue-200 mt-1\">\n130:           Theo dõi tiến độ các nhiệm vụ chuyển đổi kiến trúc số theo lộ trình 2026–2028\n131:         </p>\n132:       </div>\n133: \n134:       {/* Quick stats */}\n135:       <div className=\"flex gap-4 mb-4\">\n136:         <Badge count={data.length} color=\"#1677ff\" overflowCount={99}>\n137:           <Card size=\"small\" className=\"px-4 py-2 min-w-[100px] text-center\">\n138:             <div className=\"text-lg font-bold text-gray-800\">{data.length}</div>\n139:             <div className=\"text-xs text-gray-400\">Tổng nhiệm vụ</div>\n140:           </Card>\n141:         </Badge>\n142:         <Card size=\"small\" className=\"px-4 py-2 min-w-[100px] text-center bg-green-50 border-green-200\">\n143:           <div className=\"text-lg font-bold text-green-600\"><CheckCircleOutlined /> {tongHT}</div>\n144:           <div className=\"text-xs text-gray-400\">Hoàn thành</div>\n145:         </Card>\n146:         <Card size=\"small\" className=\"px-4 py-2 min-w-[100px] text-center bg-blue-50 border-blue-200\">\n147:           <div className=\"text-lg font-bold text-blue-600\"><ClockCircleOutlined /> {tongDT}</div>\n148:           <div className=\"text-xs text-gray-400\">Đang thực hiện</div>\n149:         </Card>\n150:         <Card size=\"small\" className=\"px-4 py-2 min-w-[100px] text-center bg-red-50 border-red-200\">\n151:           <div className=\"text-lg font-bold text-red-600\"><WarningOutlined /> {tongTH}</div>\n152:           <div className=\"text-xs text-gray-400\">Cảnh báo</div>\n153:         </Card>\n154:       </div>\n155: \n156:       {/* Filters */}\n157:       <Card className=\"mb-4 shadow-sm\">\n158:         <div className=\"flex gap-4 items-center\">\n159:           <span className=\"text-gray-600 font-medium\">Lọc:</span>\n160:           <Select\n161:             placeholder=\"Tất cả lớp\"\n162:             allowClear\n163:             style={{ width: 200 }}\n164:             onChange={setFilterLop}\n165:           >\n166:             {[1, 2, 3, 4].map((l) => (\n167:               <Select.Option key={l} value={String(l)}>\n168:                 {LOP_CONFIG[l as 1|2|3|4].icon} {LOP_CONFIG[l as 1|2|3|4].shortLabel}\n169:               </Select.Option>\n170:             ))}\n171:           </Select>\n172:           <Select\n173:             placeholder=\"Tất cả trạng thái\"\n174:             allowClear\n175:             style={{ width: 200 }}\n176:             onChange={setFilterTrangThai}\n177:           >\n178:             {Object.entries(TRANG_THAI_CONFIG).map(([k, v]) => (\n179:               <Select.Option key={k} value={k}>{v.label}</Select.Option>\n180:             ))}\n181:           </Select>\n182:           <span className=\"text-gray-400 text-sm ml-auto\">\n183:             Hiển thị {filtered.length}/{data.length} nhiệm vụ\n184:           </span>\n185:         </div>\n186:       </Card>\n187: \n188:       <Card className=\"shadow-sm\">\n189:         <Table\n190:           columns={columns}\n191:           dataSource={filtered}\n192:           rowKey=\"id\"\n193:           loading={loading}\n194:           pagination={{ pageSize: 20 }}\n195:           rowClassName={(record) => {\n196:             if (record.trangThai === \"hoan-thanh\") return \"bg-green-50\";\n197:             if (isOverdue(record.thoiHan) && record.trangThai !== \"hoan-thanh\") return \"bg-red-50\";\n198:             return \"\";\n199:           }}\n200:           size=\"middle\"\n201:         />\n202:       </Card>\n203:     </div>\n204:   );\n205: }\n206: \nThe above content shows the entire, complete file contents of the requested file.\n"}
