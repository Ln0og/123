).length;\n204:   const lop4Count = data.filter((d) => d.lop === 4).length;\n205: \n206:   return (\n207:     <div className=\"space-y-6 max-w-6xl mx-auto\">\n208:       <div className=\"page-header\">\n209:         <h1 className=\"text-2xl font-bold\">Đánh giá Hiện trạng Kiến trúc Số</h1>\n210:         <p className=\"text-blue-200 mt-1\">Kiểm kê và đánh giá các thành phần số hiện có theo 4 lớp kiến trúc</p>\n211:       </div>\n212: \n213:       <div className=\"grid grid-cols-4 gap-4 mb-6\">\n214:         {[\n215:           { lop: 1, count: lop1Count, total: 50 },\n216:           { lop: 2, count: lop2Count, total: 300 },\n217:           { lop: 3, count: lop3Count, total: 150 },\n218:           { lop: 4, count: lop4Count, total: 20 },\n219:         ].map((stat) => {\n220:           const cfg = LOP_CONFIG[stat.lop as 1|2|3|4];\n221:           const pct = Math.min(100, Math.round((stat.count / stat.total) * 100));\n222:           return (\n223:             <Card key={stat.lop} size=\"small\" className=\"text-center shadow-sm border border-gray-100\">\n224:               <div className=\"text-2xl mb-1\">{cfg.icon}</div>\n225:               <div className=\"text-xs font-bold mb-2\" style={{ color: cfg.color }}>{cfg.shortLabel}</div>\n226:               <Progress percent={pct} size=\"small\" strokeColor={cfg.color} showInfo={false} />\n227:               <div className=\"text-[10px] text-gray-400 mt-1\">{stat.count} hệ thống</div>\n228:             </Card>\n229:           );\n230:         })}\n231:       </div>\n232: \n233:       <Card className=\"shadow-sm\">\n234:         <Tabs\n235:           activeKey={selectedLop}\n236:           onChange={(key) => { setSelectedLop(key); setCurrentPage(1); }}\n237:           items={[\n238:             {\n239:               key: \"1\",\n240:               label: <span className=\"font-semibold\"><Badge count={lop1Count} color={LOP_CONFIG[1].color} className=\"mr-2\" /> Hạ tầng số</span>,\n241:               children: renderLop(1),\n2