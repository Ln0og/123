n                <span className=\"bg-emerald-700 text-white font-black text-xs px-2.5 py-0.5 rounded-md shadow-xs\">\n                  LỚP 3\n                </span>\n                <span className=\"font-extrabold text-sm text-slate-900 uppercase tracking-wide\">\n                  ỨNG DỤNG VÀ NGHIỆP VỤ DÙNG CHUNG\n                </span>\n                <span className=\"text-[11px] text-emerald-800 bg-emerald-100 font-bold px-2 py-0.5 rounded\">\n                  389+ Hệ thống\n                </span>\n              </div>\n              <span className=\"text-[11px] text-emerald-900 font-semibold bg-emerald-100/90 px-2.5 py-0.5 rounded-full\">\n                2 Nhánh song song\n              </span>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3.5\">\n              \n              {/* Nhánh 1: Chính quyền số */}\n              <div className=\"space-y-2\">\n                <div className=\"font-bold text-xs text-slate-700 flex items-center justify-between px-1\">\n                  <span>🏛️ CHÍNH QUYỀN SỐ (Nội bộ & TTHC)</span>\n                </div>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n                  {renderTile(\"lop3_chidao_dieuhanh\")}\n                  {renderTile(\"lop3_tthc_sohoa\")}\n                  {renderTile(\"lop3_ioc_tinh\")}\n                  {renderTile(\"lop3_nghiepvu_chuyennganh\")}\n                </div>\n              </div>\n\n              {/* Nhánh 2: Kinh tế số & Xã hội số */}\n              <div className=\"space-y-2\">\n                <div className=\"font-bold text-xs text-slate-700 flex items-center justify-between px-1\">\n                  <span>🌾 KINH TẾ SỐ & XÃ HỘI SỐ (Ngành & Đời sống)</span>\n                </div>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n                  {renderTile(\"lop3_nongnghiep_so\")}\n                  {renderTile(\"lop3_yte_so\")}\n                  {renderTile(\"lop3_datdai_tnmt\")}\n                  {renderTile(\"lop3_dothi_kinhte\")}\n                </div>\n              </div>\n\n            </div>\n          </div>\n\n          {/* ------------------------------------------------------------- */}\n          {/* LỚP 2: DỮ LIỆU VÀ NỀN TẢNG LÕI */}\n          {/* ------------------------------------------------------------- */}\n          <div className=\"bg-blue-50/40 rounded-2xl border border-blue-200 p-3.5 shadow-xs\">\n            \n            <div className=\"flex flex-wrap items-center justify-between gap-2 mb-3 pb-2 border-b border-blue-200\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"bg-blue-700 text-white font-black text-xs px-2.5 py-0.5 rounded-md shadow-xs\">\n                  LỚP 2\n                </span>\n                <span className=\"font-extrabold text-sm text-slate-900 uppercase tracking-wide\">\n                  DỮ LIỆU VÀ NỀN TẢNG LÕI\n                </span>\n              </div>\n              <span className=\"text-[11px] text-blue-900 font-semibold bg-blue-100/90 px-2.5 py-0.5 rounded-full\">\n                Trục liên thông LGSP/NDXP • Master Data • CSDL Quốc gia\n              </span>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5\">\n              {renderTile(\"lop2_lgsp_ndxp\")}\n              {renderTile(\"lop2_kho_dulieu_master\")}\n              {renderTile(\"lop2_csdl_quocgia\")}\n              {renderTile(\"lop2_nentang_loi\")}\n            </div>\n          </div>\n\n          {/* ------------------------------------------------------------- */}\n          {/* LỚP 1: HẠ TẦNG SỐ VÀ AN NINH MẠNG */}\n          {/* ------------------------------------------------------------- */}\n          <div className=\"bg-purple-50/40 rounded-2xl border border-purple-200 p-3.5 shadow-xs\">\n            \n            <div className=\"flex flex-wrap items-center justify-between gap-2 mb-3 pb-2 bor