{"step_index":348,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-21T01:32:56Z","thinking":"Examining the specified file, the existing container is replaced with a full-width structure and spacing adjustments. A grid layout is implemented for improved proportions across different screen sizes, defining the left, center, and right columns. Card elements are then updated with increased padding and refined font sizing for the title.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"use client\";\nimport { useState, useEffect } from \"react\";\nimport Link from \"next/link\";\nimport { Tag, Modal, Button, Spin } from \"antd\";\nimport {\n  ApartmentOutlined,\n  DatabaseOutlined,\n  GlobalOutlined,\n  BankOutlined,\n  SafetyCertificateOutlined,\n  ThunderboltOutlined,\n  RightOutlined,\n  FileProtectOutlined,\n  CloudServerOutlined,\n  MobileOutlined,\n  NodeIndexOutlined,\n  LockOutlined,\n  DesktopOutlined,\n  TeamOutlined,\n  FundProjectionScreenOutlined,\n  RobotOutlined,\n  DeploymentUnitOutlined,\n  AuditOutlined,\n  SlidersOutlined,\n  ShopOutlined,\n  MedicineBoxOutlined,\n  EnvironmentOutlined,\n  EyeOutlined,\n  CompassOutlined,\n} from \"@ant-design/icons\";\nimport { HeThongSoData, NhiemVuData } from \"@/types\";\nimport { TRANG_THAI_CONFIG } from \"@/lib/utils\";\n\ninterface FrameworkBlock {\n  id: string;\n  title: string;\n  subtitle: string;\n  description: string;\n  icon: React.ReactNode;\n  lop: number;\n  category: string;\n  itemsMatch: (ht: HeThongSoData) => boolean;\n  tasksMatch: (nv: NhiemVuData) => boolean;\n  color: string;\n  accentBg: string;\n}\n\nexport default function SoDoKhungKTSPage() {\n  const [heThongs, setHeThongs] = useState<HeThongSoData[]>([]);\n  const [nhiemVus, setNhiemVus] = useState<NhiemVuData[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [selectedBlock, setSelectedBlock] = useState<FrameworkBlock | null>(null);\n\n  useEffect(() => {\n    Promise.all([\n      fetch(\"/api/he-thong\").then((r) => r.json()),\n      fetch(\"/api/nhiem-vu\").then((r) => r.json()),\n    ])\n      .then(([htData, nvData]) => {\n        setHeThongs(Array.isArray(htData) ? htData : []);\n        setNhiemVus(Array.isArray(nvData) ? nvData : []);\n        setLoading(false);\n      })\n      .catch(() => {\n        setHeThongs([]);\n        setNhiemVus([]);\n        setLoading(false);\n      });\n  }, []);\n\n  // 4 Standard Layers according to Decision 1425/QĐ-TTg (Version 1.0 - Provincial Model)\n  const frameworkBlocks: Record<string, FrameworkBlock> = {\n    // ==========================================\n    // LỚP 4: KÊNH TƯƠNG TÁC VÀ ĐO LƯỜNG HIỆU QUẢ\n    // ==========================================\n    lop4_dvc: {\n      id: \"lop4_dvc\",\n      title: \"Cổng DVC & Một Cửa\",\n      subtitle: \"DVC Trực tuyến • Cổng DVC Quốc gia\",\n      description: \"Cổng Dịch vụ công trực tuyến tỉnh tích hợp kết nối Cổng DVC Quốc gia và Hệ thống Một cửa điện tử\",\n      icon: <GlobalOutlined />,\n      lop: 4,\n      category: \"Lớp 4: Kênh tương tác & Đo lường\",\n      itemsMatch: (ht) => ht.lop === 4 || ht.ten.toLowerCase().includes(\"dịch vụ công\") || ht.ten.toLowerCase().includes(\"một cửa\"),\n      tasksMatch: (nv) => nv.ma === \"NV-04\" || nv.lop === 4,\n      color: \"#c2410c\",\n      accentBg: \"#fff7ed\",\n    },\n    lop4_app_mobile: {\n      id: \"lop4_app_mobile\",\n      title: \"App Vĩnh Long Smart\",\n      subtitle: \"App Di động • Zalo Mini App • VNeID\",\n      description: \"Ứng dụng công dân số đa tiện ích, tích hợp Zalo Mini App và tài khoản định danh điện tử VNeID\",\n      icon: <MobileOutlined />,\n      lop: 4,\n      category: \"Lớp 4: Kênh tương tác & Đo lường\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"di động\") || ht.ten.toLowerCase().includes(\"app\") || ht.ten.toLowerCase().includes(\"smart\") || ht.ma === \"DL-01\",\n      tasksMatch: (nv) => nv.ma === \"NV-07\" || nv.ma === \"NV-03\",\n      color: \"#ea580c\",\n      accentBg: \"#fff7ed\",\n    },\n    lop4_portal: {\n      id: \"lop4_portal\",\n      title: \"Cổng Thông Tin Điện Tử\",\n      subtitle: \"Portal Tỉnh & Trang TTĐT Sở Ngành\",\n      description: \"Hệ thống Cổng thông tin điện tử tỉnh và các trang thành phần của các Sở, Ban, Ngành, UBND cấp huyện\",\n      icon: <ApartmentOutlined />,\n      lop: 4,\n      category: \"Lớp 4: Kênh tương tác & Đo lường\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"cổng thông tin\") || ht.ten.toLowerCase().includes(\"portal\"),\n      tasksMatch: (nv) => false,\n      color: \"#b45309\",\n      accentBg: \"#fefce8\",\n    },\n    lop4_kpi_metric: {\n      id: \"lop4_kpi_metric\",\n      title: \"Đo Lường & Dashboard KPI\",\n      subtitle: \"Chất lượng DVC • Mức độ hài lòng\",\n      description: \"Hệ thống giám sát, đo lường mức độ hài lòng, tỷ lệ DVC trực tuyến toàn trình và KPIs phục vụ người dân, doanh nghiệp\",\n      icon: <FundProjectionScreenOutlined />,\n      lop: 4,\n      category: \"Lớp 4: Kênh tương tác & Đo lường\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"đo lường\") || ht.ten.toLowerCase().includes(\"kpi\") || ht.ten.toLowerCase().includes(\"đánh giá\"),\n      tasksMatch: (nv) => nv.ma === \"NV-04\",\n      color: \"#9a3412\",\n      accentBg: \"#fff7ed\",\n    },\n\n    // =========================================================================\n    // LỚP 3: ỨNG DỤNG VÀ NGHIỆP VỤ DÙNG CHUNG (2 NHÁNH SONG SONG)\n    // =========================================================================\n    // Nhánh 1: Chính quyền số\n    lop3_chidao_dieuhanh: {\n      id: \"lop3_chidao_dieuhanh\",\n      title: \"Chỉ Đạo & Điều Hành Số\",\n      subtitle: \"iOffice • e-Cabinet • Báo cáo số\",\n      description: \"Quản lý văn bản điều hành iOffice, phòng họp không giấy e-Cabinet, hệ thống thông tin báo cáo tỉnh\",\n      icon: <FileProtectOutlined />,\n      lop: 3,\n      category: \"Lớp 3: Chính quyền số (Nội bộ & TTHC)\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"văn bản\") || ht.ten.toLowerCase().includes(\"điều hành\") || ht.ten.toLowerCase().includes(\"báo cáo\"),\n      tasksMatch: (nv) => nv.ten.toLowerCase().includes(\"văn bản\"),\n      color: \"#15803d\",\n      accentBg: \"#f0fdf4\",\n    },\n    lop3_tthc_sohoa: {\n      id: \"lop3_tthc_sohoa\",\n      title: \"Giải Quyết TTHC & Số Hóa\",\n      subtitle: \"Quy trình TTHC • Số hóa hồ sơ\",\n      description: \"Quy trình giải quyết TTHC liên thông, số hóa hồ sơ và trả kết quả bản điện tử toàn tỉnh\",\n      icon: <DesktopOutlined />,\n      lop: 3,\n      category: \"Lớp 3: Chính quyền số (Nội bộ & TTHC)\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"thủ tục\") || ht.ten.toLowerCase().includes(\"tthc\"),\n      tasksMatch: (nv) => nv.ma === \"NV-04\",\n      color: \"#047857\",\n      accentBg: \"#ecfdf5\",\n    },\n    lop3_ioc_tinh: {\n      id: \"lop3_ioc_tinh\",\n      title: \"Trung Tâm IOC Tỉnh\",\n      subtitle: \"Giám sát & Điều hành thông minh\",\n      description: \"Trung tâm Giám sát, Điều hành thông minh tỉnh Vĩnh Long kết nối dữ liệu liên ngành phục vụ lãnh đạo\",\n      icon: <FundProjectionScreenOutlined />,\n      lop: 3,\n      category: \"Lớp 3: Chính quyền số (Nội bộ & TTHC)\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"ioc\") || ht.ten.toLowerCase().includes(\"điều hành thông minh\"),\n      tasksMatch: (nv) => nv.ma === \"NV-08\",\n      color: \"#065f46\",\n      accentBg: \"#f0fdf4\",\n    },\n    lop3_nghiepvu_chuyennganh: {\n      id: \"lop3_nghiepvu_chuyennganh\",\n      title: \"Nghiệp Vụ Sở, Ban, Ngành\",\n      subtitle: \"Nội vụ • Tư pháp • Tài chính...\",\n      description: \"Phần mềm nghiệp vụ quản lý cán bộ công chức, tư pháp hộ tịch, thanh tra, tài chính ngân sách\",\n      icon: <AuditOutlined />,\n      lop: 3,\n      category: \"Lớp 3: Chính quyền số (Nội bộ & TTHC)\",\n      itemsMatch: (ht) => (ht.lop === 3 && !ht.ma.startsWith(\"SNN-\") && ht.ma !== \"UD-03\") || ht.ten.toLowerCase().includes(\"cán bộ\"),\n      tasksMatch: (nv) => false,\n      color: \"#166534\",\n      accentBg: \"#f0fdf4\",\n    },\n\n    // Nhánh 2: Kinh tế số & Xã hội số\n    lop3_nongnghiep_so: {\n      id: \"lop3_nongnghiep_so\",\n      title: \"Nông Nghiệp & PTNT Số\",\n      subtitle: \"380+ CSDL • Bản đồ số • OCOP\",\n      description: \"Bản đồ số canh tác, trạm quan trắc VnEmisoft, CSDL trồng trọt, chăn nuôi, thủy sản, OCOP, truy xuất nguồn gốc\",\n      icon: <ShopOutlined />,\n      lop: 3,\n      category: \"Lớp 3: Kinh tế số & Xã hội số\",\n      itemsMatch: (ht) => ht.ma.startsWith(\"SNN-\") || (ht.donVi?.ten || \"\").includes(\"Nông nghiệp\"),\n      tasksMatch: (nv) => false,\n      color: \"#047857\",\n      accentBg: \"#dcfce7\",\n    },\n    lop3_yte_so: {\n      id: \"lop3_yte_so\",\n      title: \"Y Tế & Sức Khỏe Số\",\n      subtitle: \"HIS Bệnh viện • EMR • Trạm Y tế\",\n      description: \"Quản lý bệnh viện HIS, Bệnh án điện tử EMR, quản lý trạm y tế xã phường, hồ sơ sức khỏe điện tử\",\n      icon: <MedicineBoxOutlined />,\n      lop: 3,\n      category: \"Lớp 3: Kinh tế số & Xã hội số\",\n      itemsMatch: (ht) => ht.ma === \"UD-03\" || ht.ten.toLowerCase().includes(\"y tế\") || ht.ten.toLowerCase().includes(\"his\"),\n      tasksMatch: (nv) => nv.ma === \"NV-09\",\n      color: \"#0e7490\",\n      accentBg: \"#ecfeff\",\n    },\n    lop3_datdai_tnmt: {\n      id: \"lop3_datdai_tnmt\",\n      title: \"Đất Đai, TN&MT (NDOP)\",\n      subtitle: \"CSDL Đất đai • Quan trắc MT\",\n      description: \"CSDL Đất đai tỉnh kết nối nền tảng điều phối dữ liệu đất đai quốc gia (NDOP), quan trắc môi trường\",\n      icon: <EnvironmentOutlined />,\n      lop: 3,\n      category: \"Lớp 3: Kinh tế số & Xã hội số\",\n      itemsMatch: (ht) => ht.ma === \"DL-02\" || ht.ten.toLowerCase().includes(\"đất đai\") || ht.ten.toLowerCase().includes(\"môi trường\"),\n      tasksMatch: (nv) => nv.ma === \"NV-01\",\n      color: \"#1d4ed8\",\n      accentBg: \"#eff6ff\",\n    },\n    lop3_dothi_kinhte: {\n      id: \"lop3_dothi_kinhte\",\n      title: \"Đô Thị, Du Lịch & Giáo Dục\",\n      subtitle: \"Du lịch số • Giáo dục số • Đô thị\",\n      description: \"Cổng du lịch thông minh, giáo dục số, chiếu sáng/giao thông thông minh, thương mại điện tử\",\n      icon: <CompassOutlined />,\n      lop: 3,\n      category: \"Lớp 3: Kinh tế số & Xã hội số\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"du lịch\") || ht.ten.toLowerCase().includes(\"giáo dục\") || ht.ten.toLowerCase().includes(\"thương mại\"),\n      tasksMatch: (nv) => false,\n      color: \"#4338ca\",\n      accentBg: \"#eef2ff\",\n    },\n\n    // ==========================================\n    // LỚP 2: DỮ LIỆU VÀ NỀN TẢNG LÕI\n    // ==========================================\n    lop2_lgsp_ndxp: {\n      id: \"lop2_lgsp_ndxp\",\n      title: \"Trục Liên Thông LGSP / NDXP\",\n      subtitle: \"LGSP Cấp Tỉnh • NDXP Quốc Gia\",\n      description: \"Nền tảng tích hợp, chia sẻ dữ liệu cấp tỉnh (LGSP) liên thông Trục Quốc gia (NDXP)\",\n      icon: <NodeIndexOutlined />,\n      lop: 2,\n      category: \"Lớp 2: Dữ liệu & Nền tảng lõi\",\n      itemsMatch: (ht) => ht.ma === \"DL-03\" || ht.ten.toLowerCase().includes(\"lgsp\") || ht.ten.toLowerCase().includes(\"chia sẻ\"),\n      tasksMatch: (nv) => nv.ma === \"NV-04\" || nv.ma === \"NV-06\",\n      color: \"#1e40af\",\n      accentBg: \"#dbeafe\",\n    },\n    lop2_kho_dulieu_master: {\n      id: \"lop2_kho_dulieu_master\",\n      title: \"Kho Dữ Liệu & Master Data\",\n      subtitle: \"Kho Dữ liệu tổng hợp • Danh mục\",\n      description: \"Kho dữ liệu tổng hợp tỉnh, từ điển danh mục dùng chung và nền tảng dữ liệu mở (Open Data)\",\n      icon: <DatabaseOutlined />,\n      lop: 2,\n      category: \"Lớp 2: Dữ liệu & Nền tảng lõi\",\n      itemsMatch: (ht) => ht.ma.startsWith(\"DL-\") || ht.ten.toLowerCase().includes(\"kho dữ liệu\") || ht.ten.toLowerCase().includes(\"danh mục\"),\n      tasksMatch: (nv) => nv.ma === \"NV-06\",\n      color: \"#2563eb\",\n      accentBg: \"#eff6ff\",\n    },\n    lop2_csdl_quocgia: {\n      id: \"lop2_csdl_quocgia\",\n      title: \"Kết Nối CSDL Quốc Gia\",\n      subtitle: \"Dân cư (Đề án 06) • Doanh nghiệp\",\n      description: \"Kết nối CSDL Quốc gia về Dân cư, CSDL Đất đai, CSDL Đăng ký doanh nghiệp, Bảo hiểm xã hội\",\n      icon: <ApartmentOutlined />,\n      lop: 2,\n      category: \"Lớp 2: Dữ liệu & Nền tảng lõi\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"dân cư\") || ht.ma === \"DL-01\" || ht.ma === \"DL-02\",\n      tasksMatch: (nv) => nv.ma === \"NV-03\" || nv.ma === \"NV-01\",\n      color: \"#1d4ed8\",\n      accentBg: \"#eff6ff\",\n    },\n    lop2_nentang_loi: {\n      id: \"lop2_nentang_loi\",\n      title: \"Nền Tảng Định Danh & GIS\",\n      subtitle: \"VNeID / SSO • Payment • GIS Tỉnh\",\n      description: \"Nền tảng xác thực định danh (VNeID/SSO), Nền tảng thanh toán số Payment, Nền tảng Bản đồ số GIS\",\n      icon: <DeploymentUnitOutlined />,\n      lop: 2,\n      category: \"Lớp 2: Dữ liệu & Nền tảng lõi\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"định danh\") || ht.ten.toLowerCase().includes(\"gis\") || ht.ten.toLowerCase().includes(\"thanh toán\"),\n      tasksMatch: (nv) => nv.ma === \"NV-03\",\n      color: \"#0284c7\",\n      accentBg: \"#f0f9ff\",\n    },\n\n    // ==========================================\n    // LỚP 1: HẠ TẦNG SỐ VÀ AN NINH MẠNG DÙNG CHUNG\n    // ==========================================\n    lop1_idc_cloud: {\n      id: \"lop1_idc_cloud\",\n      title: \"Trung Tâm Dữ Liệu (IDC / Cloud)\",\n      subtitle: \"Hạ tầng tính toán • Cloud Tỉnh\",\n      description: \"Trung tâm tích hợp dữ liệu tỉnh, chuyển đổi sang kiến trúc Cloud kết nối Cloud Quốc gia\",\n      icon: <CloudServerOutlined />,\n      lop: 1,\n      category: \"Lớp 1: Hạ tầng số & An ninh mạng dùng chung\",\n      itemsMatch: (ht) => ht.ma === \"HT-02\" || ht.ten.toLowerCase().includes(\"idc\") || ht.ten.toLowerCase().includes(\"trung tâm tích hợp\"),\n      tasksMatch: (nv) => nv.ma === \"NV-02\",\n      color: \"#4c1d95\",\n      accentBg: \"#f3e8ff\",\n    },\n    lop1_mang_tslcd: {\n      id: \"lop1_mang_tslcd\",\n      title: \"Mạng TSLCD & Internet BR\",\n      subtitle: \"Mạng chuyên dùng cấp I, II\",\n      description: \"Mạng Truyền số liệu chuyên dùng cấp I, II kết nối 100% cơ quan Đảng, chính quyền 3 cấp\",\n      icon: <NodeIndexOutlined />,\n      lop: 1,\n      category: \"Lớp 1: Hạ tầng số & An ninh mạng dùng chung\",\n      itemsMatch: (ht) => ht.ma === \"HT-01\" || ht.ten.toLowerCase().includes(\"wan\") || ht.ten.toLowerCase().includes(\"mạng\"),\n      tasksMatch: (nv) => false,\n      color: \"#581c87\",\n      accentBg: \"#faf5ff\",\n    },\n    lop1_soc_anm: {\n      id: \"lop1_soc_anm\",\n      title: \"SOC Tỉnh (ATTT 4 Lớp)\",\n      subtitle: \"Giám sát 24/7 • Kết nối SOC BCA\",\n      description: \"Mô hình bảo vệ 4 lớp ATTT, kết nối SOC Quốc gia của Bộ Công an, chữ ký số PKI, sao lưu dự phòng\",\n      icon: <LockOutlined />,\n      lop: 1,\n      category: \"Lớp 1: Hạ tầng số & An ninh mạng dùng chung\",\n      itemsMatch: (ht) => ht.ma === \"HT-03\" || ht.ten.toLowerCase().includes(\"soc\") || ht.ten.toLowerCase().includes(\"an toàn\"),\n      tasksMatch: (nv) => nv.ma === \"NV-05\",\n      color: \"#991b1b\",\n      accentBg: \"#fef2f2\",\n    },\n    lop1_iot_bien: {\n      id: \"lop1_iot_bien\",\n      title: \"Hạ Tầng IoT & Camera Biên\",\n      subtitle: \"Camera an ninh • Trạm cảm biến\",\n      description: \"Hệ thống camera giám sát an ninh đô thị, trạm quan trắc IoT môi trường, nông nghiệp\",\n      icon: <EyeOutlined />,\n      lop: 1,\n      category: \"Lớp 1: Hạ tầng số & An ninh mạng dùng chung\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"camera\") || ht.ten.toLowerCase().includes(\"quan trắc\") || ht.ten.toLowerCase().includes(\"iot\"),\n      tasksMatch: (nv) => false,\n      color: \"#701a75\",\n      accentBg: \"#fdf2f8\",\n    },\n  };\n\n  const getMatchedItems = (block: FrameworkBlock) => {\n    return heThongs.filter(block.itemsMatch);\n  };\n\n  const getMatchedTasks = (block: FrameworkBlock) => {\n    return nhiemVus.filter(block.tasksMatch);\n  };\n\n  // Render a spacious, crisp, elegant card\n  const renderSpaciousCard = (blockKey: string) => {\n    const block = frameworkBlocks[blockKey];\n    if (!block) return null;\n    const items = getMatchedItems(block);\n    const tasks = getMatchedTasks(block);\n    const hasUpgrade = items.some((i) => i.trangThai === \"can-nang-cap\") || tasks.length > 0;\n\n    return (\n      <div\n        onClick={() => setSelectedBlock(block)}\n        className=\"bg-white hover:bg-slate-50/90 rounded-xl p-3.5 md:p-4 border border-slate-200 shadow-2xs hover:shadow-lg hover:border-blue-400 transition-all cursor-pointer flex flex-col justify-between group relative overflow-hidden\"\n      >\n        {/* Top colored indicator bar */}\n        <div\n          className=\"absolute top-0 left-0 right-0 h-1.5 transition-all group-hover:h-2\"\n          style={{ backgroundColor: block.color }}\n        />\n\n        <div className=\"pt-1\">\n          {/* Header row */}\n          <div className=\"flex items-start justify-between gap-2 mb-2\">\n            <div className=\"flex items-center gap-2 font-bold text-slate-900 text-sm md:text-[15px] leading-snug\">\n              <span\n                className=\"w-7 h-7 rounded-lg flex items-center justify-center text-sm shrink-0 shadow-xs\"\n                style={{ backgroundColor: block.accentBg, color: block.color }}\n              >\n                {block.icon}\n              </span>\n              <span className=\"group-hover:text-blue-700 transition-colors\">{block.title}</span>\n            </div>\n\n            {hasUpgrade && (\n              <span className=\"inline-flex items-center gap-1 bg-amber-50 text-amber-950 border border-amber-300 font-bold text-[10px] px-2 py-0.5 rounded-full shrink-0\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse\"></span>\n                Lộ trình\n              </span>\n            )}\n          </div>\n\n          {/* Subtitle / keywords */}\n          <div className=\"text-xs text-slate-500 font-medium line-clamp-1 mb-3\">\n            {block.subtitle}\n          </div>\n        </div>\n\n        {/* Footer row: Count + Detail link */}\n        <div className=\"flex items-center justify-between pt-2.5 border-t border-slate-100 text-xs\">\n          <span className=\"font-semibold text-slate-700 bg-slate-100/90 px-2.5 py-0.5 rounded-md text-[11px]\">\n            {items.length > 0 ? `${items.length} HT / CSDL` : \"Quy chuẩn mục tiêu\"}\n          </span>\n          <span\n            className=\"font-bold flex items-center gap-1 text-xs group-hover:translate-x-1 transition-transform\"\n            style={{ color: block.color }}\n          >\n            Xem chi tiết <RightOutlined className=\"text-[10px]\" />\n          </span>\n        </div>\n      </div>\n    );\n  };\n\n  if (loading) {\n    return (\n      <div className=\"flex justify-center items-center min-h-[60vh]\">\n        <Spin size=\"large\" />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"w-full space-y-6 pb-16\">\n      {/* Header Banner */}\n      <div className=\"bg-gradient-to-r from-blue-950 via-slate-900 to-indigo-950 text-white p-6 md:p-8 rounded-2xl shadow-md flex flex-col md:flex-row justify-between items-start md:items-center gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-2\">\n            <span className=\"bg-amber-400/25 text-amber-200 border border-amber-400/40 text-xs px-3 py-0.5 rounded-full font-bold flex items-center gap-1\">\n              <ApartmentOutlined /> Chuẩn QĐ 1425/QĐ-TTg (PB 1.0)\n            </span>\n            <span className=\"text-xs text-blue-300\">Khung Kiến Trúc Chính Quyền Số Tỉnh Vĩnh Long</span>\n          </div>\n          <h1 className=\"text-2xl md:text-3xl font-bold tracking-tight text-white m-0\">\n            Sơ Đồ Khung Kiến Trúc Tổng Thể Chính Quyền Số\n          </h1>\n          <p className=\"text-sm text-blue-200/90 mt-1.5 mb-0 max-w-4xl\">\n            Mô hình cấu trúc <b>04 Lớp Chuẩn Quốc Gia</b> kết hợp <b>04 Thành Phần Xuyên Suốt</b> (Quản trị • Quy chuẩn • AI First • Data-Centric) theo chuẩn Khung kiến trúc tổng thể quốc gia số PB 1.0.\n          </p>\n        </div>\n\n        <div className=\"flex gap-3 shrink-0\">\n          <Link href=\"/kts/hien-trang\">\n            <Button size=\"large\" className=\"bg-white/15 border-white/30 text-white hover:bg-white/25 font-semibold\">\n              Hiện Trạng (389 HT)\n            </Button>\n          </Link>\n          <Link href=\"/kts/lo-trinh\">\n            <Button type=\"primary\" size=\"large\" className=\"bg-blue-600 border-blue-500 font-bold shadow-md\">\n              Lộ Trình (9 NV)\n            </Button>\n          </Link>\n        </div>\n      </div>\n\n      {/* ARCHITECTURE BLUEPRINT DIAGRAM - WIDE FULL CANVAS */}\n      <div className=\"bg-white rounded-2xl border border-slate-200 shadow-sm p-4 md:p-7\">\n        \n        {/* Diagram title header */}\n        <div className=\"text-center mb-7\">\n          <div className=\"inline-flex items-center gap-2 bg-blue-900 text-white px-6 py-2 rounded-full text-xs md:text-sm font-bold uppercase tracking-wider shadow-xs\">\n            <ApartmentOutlined /> MÔ HÌNH KIẾN TRÚC TỔNG THỂ CHÍNH QUYỀN SỐ (04 LỚP CHUẨN QĐ 1425)\n          </div>\n          <p className=\"text-xs md:text-sm text-slate-500 mt-2 mb-0\">\n            💡 Nhấp chuột vào bất kỳ khối nào trên sơ đồ để xem toàn bộ hệ thống hiện trạng và nhiệm vụ lộ trình bên trong\n          </p>\n        </div>\n\n        {/* 3-Column Master Grid */}\n        <div className=\"grid grid-cols-1 xl:grid-cols-12 gap-5 items-stretch\">\n          \n          {/* ========================================================================= */}\n          {/* CỘT TRÁI: 2 THÀNH PHẦN XUYÊN SUỐT (QUẢN TRỊ & TIÊU CHUẨN) */}\n          {/* ========================================================================= */}\n          <div className=\"xl:col-span-2 bg-slate-50/90 rounded-2xl border border-slate-200 p-4 flex flex-col justify-between space-y-4\">\n            <div className=\"space-y-4\">\n              <div className=\"flex items-center gap-2 font-bold text-slate-900 text-xs md:text-sm border-b border-slate-200 pb-2.5\">\n                <SlidersOutlined className=\"text-blue-700 text-base\" />\n                <span>THÀNH PHẦN XUYÊN SUỐT (I & II)</span>\n              </div>\n\n              {/* 1. Quản trị & Điều phối */}\n              <div className=\"bg-white p-3.5 rounded-xl border border-slate-200/90 shadow-2xs\">\n                <div className=\"font-bold text-slate-900 text-xs md:text-sm flex items-center gap-1.5 mb-2 text-blue-900\">\n                  <BankOutlined className=\"text-blue-600\" />\n                  <span>1. Quản trị & Điều phối</span>\n                </div>\n                <ul className=\"text-xs text-slate-600 space-y-2 pl-3.5 list-disc m-0\">\n                  <li>Ban chỉ đạo CĐS tỉnh</li>\n                  <li>Quyết định 1425/QĐ-TTg</li>\n                  <li>Luật Chuyển đổi số 2025</li>\n                  <li>Kế hoạch CĐS 2026–2030</li>\n                  <li>Giám sát KPIs thực thi</li>\n                </ul>\n              </div>\n\n              {/* 2. Tiêu chuẩn & Quy chuẩn */}\n              <div className=\"bg-white p-3.5 rounded-xl border border-slate-200/90 shadow-2xs\">\n                <div className=\"font-bold text-slate-900 text-xs md:text-sm flex items-center gap-1.5 mb-2 text-blue-900\">\n                  <SafetyCertificateOutlined className=\"text-blue-600\" />\n                  <span>2. Tiêu chuẩn & Quy chuẩn</span>\n                </div>\n                <ul className=\"text-xs text-slate-600 space-y-2 pl-3.5 list-disc m-0\">\n                  <li>Kiến trúc số dùng chung</li>\n                  <li>Quy chế chia sẻ dữ liệu</li>\n                  <li>Chuẩn dữ liệu mở & API</li>\n                  <li>Định mức KT - kỹ thuật</li>\n                </ul>\n              </div>\n            </div>\n\n            <div className=\"pt-3 border-t border-slate-200 text-xs text-slate-500 text-center font-bold uppercase tracking-wider\">\n              Khung Thể Chế & Chuẩn Hóa\n            </div>\n          </div>\n\n          {/* ========================================================================= */}\n          {/* TRUNG TÂM: 04 LỚP KIẾN TRÚC CHUẨN QUỐC GIA (TOP-DOWN: LỚP 4 -> LỚP 1) */}\n          {/* ========================================================================= */}\n          <div className=\"xl:col-span-8 space-y-4\">\n            \n            {/* ------------------------------------------------------------- */}\n            {/* LỚP 4: KÊNH TƯƠNG TÁC VÀ ĐO LƯỜNG HIỆU QUẢ */}\n            {/* ------------------------------------------------------------- */}\n            <div className=\"bg-amber-50/50 rounded-2xl border border-amber-200 p-4 shadow-2xs\">\n              <div className=\"flex items-center justify-between mb-3 px-1\">\n                <span className=\"font-bold text-xs md:text-sm uppercase tracking-wide text-amber-950 flex items-center gap-2\">\n                  <TeamOutlined className=\"text-amber-600 text-base\" /> LỚP 4: KÊNH TƯƠNG TÁC & ĐO LƯỜNG HIỆU QUẢ (OMNI-CHANNEL & KPIS)\n                </span>\n                <span className=\"text-xs text-amber-900 font-bold bg-amber-100/90 px-3 py-1 rounded-md border border-amber-200\">\n                  Người dân • Doanh nghiệp • Cán bộ CCVC\n                </span>\n              </div>\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3\">\n                {renderSpaciousCard(\"lop4_dvc\")}\n                {renderSpaciousCard(\"lop4_app_mobile\")}\n                {renderSpaciousCard(\"lop4_portal\")}\n                {renderSpaciousCard(\"lop4_kpi_metric\")}\n              </div>\n            </div>\n\n            {/* ------------------------------------------------------------- */}\n            {/* LỚP 3: ỨNG DỤNG VÀ NGHIỆP VỤ DÙNG CHUNG */}\n            {/* ------------------------------------------------------------- */}\n            <div className=\"bg-emerald-50/40 rounded-2xl border border-emerald-200 p-4 shadow-2xs space-y-3\">\n              <div className=\"flex items-center justify-between px-1\">\n                <span className=\"font-bold text-xs md:text-sm uppercase tracking-wide text-emerald-950 flex items-center gap-2\">\n                  <DesktopOutlined className=\"text-emerald-600 text-base\" /> LỚP 3: ỨNG DỤNG VÀ NGHIỆP VỤ DÙNG CHUNG (389+ HỆ THỐNG & CSDL)\n                </span>\n                <span className=\"text-xs text-emerald-900 font-bold bg-emerald-100/90 px-3 py-1 rounded-md border border-emerald-200\">\n                  Tổ chức 2 Nhánh song song: Chính quyền số VS. Kinh tế số & Xã hội số\n                </span>\n              </div>\n\n              {/* 2 Parallel Clean Sections */}\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                \n                {/* Nhánh 1: Chính quyền số */}\n                <div className=\"bg-white/90 p-3.5 rounded-xl border border-emerald-200 space-y-3\">\n                  <div className=\"flex items-center justify-between px-1 pb-2 border-b border-slate-100\">\n                    <span className=\"font-bold text-xs md:text-sm text-emerald-900 flex items-center gap-1.5\">\n                      🏛️ NHÁNH 1: CHÍNH QUYỀN SỐ\n                    </span>\n                    <span className=\"text-xs text-slate-500 font-medium\">(Nội bộ & TTHC)</span>\n                  </div>\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                    {renderSpaciousCard(\"lop3_chidao_dieuhanh\")}\n                    {renderSpaciousCard(\"lop3_tthc_sohoa\")}\n                    {renderSpaciousCard(\"lop3_ioc_tinh\")}\n                    {renderSpaciousCard(\"lop3_nghiepvu_chuyennganh\")}\n                  </div>\n                </div>\n\n                {/* Nhánh 2: Kinh tế số & Xã hội số */}\n                <div className=\"bg-white/90 p-3.5 rounded-xl border border-emerald-200 space-y-3\">\n                  <div className=\"flex items-center justify-between px-1 pb-2 border-b border-slate-100\">\n                    <span className=\"font-bold text-xs md:text-sm text-emerald-900 flex items-center gap-1.5\">\n                      🌾 NHÁNH 2: KINH TẾ SỐ & XÃ HỘI SỐ\n                    </span>\n                    <span className=\"text-xs text-slate-500 font-medium\">(Phát triển ngành & Đời sống)</span>\n                  </div>\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                    {renderSpaciousCard(\"lop3_nongnghiep_so\")}\n                    {renderSpaciousCard(\"lop3_yte_so\")}\n                    {renderSpaciousCard(\"lop3_datdai_tnmt\")}\n                    {renderSpaciousCard(\"lop3_dothi_kinhte\")}\n                  </div>\n                </div>\n\n              </div>\n            </div>\n\n            {/* ------------------------------------------------------------- */}\n            {/* LỚP 2: DỮ LIỆU VÀ NỀN TẢNG LÕI */}\n            {/* ------------------------------------------------------------- */}\n            <div className=\"bg-blue-50/50 rounded-2xl border border-blue-200 p-4 shadow-2xs\">\n              <div className=\"flex items-center justify-between mb-3 px-1\">\n                <span className=\"font-bold text-xs md:text-sm uppercase tracking-wide text-blue-950 flex items-center gap-2\">\n                  <NodeIndexOutlined className=\"text-blue-600 text-base\" /> LỚP 2: DỮ LIỆU VÀ NỀN TẢNG LÕI (LGSP / NDXP • MASTER DATA • CSDL QUỐC GIA)\n                </span>\n                <span className=\"text-xs text-blue-900 font-bold bg-blue-100/90 px-3 py-1 rounded-md border border-blue-200\">\n                  Trục liên thông • Dữ liệu dùng chung • Nền tảng lõi\n                </span>\n              </div>\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3\">\n                {renderSpaciousCard(\"lop2_lgsp_ndxp\")}\n                {renderSpaciousCard(\"lop2_kho_dulieu_master\")}\n                {renderSpaciousCard(\"lop2_csdl_quocgia\")}\n                {renderSpaciousCard(\"lop2_nentang_loi\")}\n              </div>\n            </div>\n\n            {/* ------------------------------------------------------------- */}\n            {/* LỚP 1: HẠ TẦNG SỐ VÀ AN NINH MẠNG DÙNG CHUNG */}\n            {/* ------------------------------------------------------------- */}\n            <div className=\"bg-purple-50/50 rounded-2xl border border-purple-200 p-4 shadow-2xs\">\n              <div className=\"flex items-center justify-between mb-3 px-1\">\n                <span className=\"font-bold text-xs md:text-sm uppercase tracking-wide text-purple-950 flex items-center gap-2\">\n                  <CloudServerOutlined className=\"text-purple-600 text-base\" /> LỚP 1: HẠ TẦNG SỐ VÀ AN NINH MẠNG DÙNG CHUNG (CLOUD • TSLCD • SOC 4 LỚP)\n                </span>\n                <span className=\"text-xs text-purple-900 font-bold bg-purple-100/90 px-3 py-1 rounded-md border border-purple-200\">\n                  IDC Cloud • Mạng TSLCD • Giám sát ATTT 24/7\n                </span>\n              </div>\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3\">\n                {renderSpaciousCard(\"lop1_idc_cloud\")}\n                {renderSpaciousCard(\"lop1_mang_tslcd\")}\n                {renderSpaciousCard(\"lop1_soc_anm\")}\n                {renderSpaciousCard(\"lop1_iot_bien\")}\n              </div>\n            </div>\n\n          </div>\n\n          {/* ========================================================================= */}\n          {/* CỘT PHẢI: 2 THÀNH PHẦN XUYÊN SUỐT (AI FIRST & DATA-CENTRIC) */}\n          {/* ========================================================================= */}\n          <div className=\"xl:col-span-2 bg-indigo-50/80 rounded-2xl border border-indigo-200 p-4 flex flex-col justify-between space-y-4\">\n            <div className=\"space-y-4\">\n              <div className=\"flex items-center gap-2 font-bold text-indigo-950 text-xs md:text-sm border-b border-indigo-200 pb-2.5\">\n                <ThunderboltOutlined className=\"text-indigo-600 text-base\" />\n                <span>THÀNH PHẦN XUYÊN SUỐT (III & IV)</span>\n              </div>\n\n              {/* 3. AI First */}\n              <div className=\"bg-white p-3.5 rounded-xl border border-indigo-200/90 shadow-2xs\">\n                <div className=\"font-bold text-indigo-950 text-xs md:text-sm flex items-center gap-1.5 mb-2 text-indigo-900\">\n                  <RobotOutlined className=\"text-indigo-600\" />\n                  <span>3. Ưu tiên AI (AI First)</span>\n                </div>\n                <ul className=\"text-xs text-slate-600 space-y-2 pl-3.5 list-disc m-0\">\n                  <li>Trợ lý ảo AI CCVC</li>\n                  <li>Trợ lý ảo hỗ trợ DVC</li>\n                  <li>Tự động bóc tách hồ sơ</li>\n                  <li>Dự báo & hỗ trợ điều hành</li>\n                </ul>\n              </div>\n\n              {/* 4. Data Centric */}\n              <div className=\"bg-white p-3.5 rounded-xl border border-indigo-200/90 shadow-2xs\">\n                <div className=\"font-bold text-indigo-950 text-xs md:text-sm flex items-center gap-1.5 mb-2 text-indigo-900\">\n                  <DatabaseOutlined className=\"text-indigo-600\" />\n                  <span>4. Dữ liệu trung tâm</span>\n                </div>\n                <ul className=\"text-xs text-slate-600 space-y-2 pl-3.5 list-disc m-0\">\n                  <li>Dữ liệu \"Đúng-Đủ-Sạch-Sống\"</li>\n                  <li>Mở và chia sẻ mặc định</li>\n                  <li>Xóa bỏ cát cứ dữ liệu</li>\n                  <li>Khai thác giá trị dữ liệu số</li>\n                </ul>\n              </div>\n            </div>\n\n            <div className=\"pt-3 border-t border-indigo-200 text-xs text-indigo-700 text-center font-bold uppercase tracking-wider\">\n              Động Lực Công Nghệ & Dữ Liệu\n            </div>\n          </div>\n\n        </div>\n      </div>\n\n      {/* DETAIL MODAL WHEN CLICKING ANY BLOCK */}\n      <Modal\n        title={\n          <div className=\"flex items-center gap-2 pr-6\">\n            <span className=\"text-xl\" style={{ color: selectedBlock?.color }}>{selectedBlock?.icon}</span>\n            <span className=\"font-bold text-base text-gray-800\">{selectedBlock?.title}</span>\n          </div>\n        }\n        open={!!selectedBlock}\n        onCancel={() => setSelectedBlock(null)}\n        footer={[\n          <Button key=\"close\" type=\"primary\" onClick={() => setSelectedBlock(null)}>\n            Đóng\n          </Button>,\n        ]}\n        width={750}\n        destroyOnHidden\n      >\n        {selectedBlock && (\n          <div className=\"space-y-4 mt-3\">\n            <div className=\"bg-slate-50 p-3 rounded-lg border border-slate-200 text-xs text-gray-700 leading-relaxed\">\n              <b>Phân loại kiến trúc:</b> <Tag color=\"blue\">{selectedBlock.category}</Tag>\n              <div className=\"mt-1\">{selectedBlock.description}</div>\n            </div>\n\n            {/* Nhiệm vụ lộ trình liên quan */}\n            <div>\n              <div className=\"font-bold text-gray-800 text-sm mb-2 flex items-center gap-1.5\">\n                <ThunderboltOutlined className=\"text-amber-500\" />\n                <span>Nhiệm vụ & Đề án Lộ trình liên quan ({getMatchedTasks(selectedBlock).length}):</span>\n              </div>\n              {getMatchedTasks(selectedBlock).length > 0 ? (\n                <div className=\"space-y-2\">\n                  {getMatchedTasks(selectedBlock).map((nv) => (\n                    <div key={nv.id} className=\"p-3 bg-amber-50/60 rounded-lg border border-amber-200 flex justify-between items-center\">\n                      <div>\n                        <div className=\"font-semibold text-gray-800 text-xs\">\n                          <span className=\"font-mono bg-amber-100 text-amber-800 px-1.5 py-0.5 rounded mr-1.5\">{nv.ma}</span>\n                          {nv.ten}\n                        </div>\n                        <div className=\"text-[11px] text-gray-500 mt-1\">\n                          Chủ trì: {nv.donViChuTri?.ten || \"UBND tỉnh\"} • Hạn: {nv.thoiHan ? new Date(nv.thoiHan).toLocaleDateString(\"vi-VN\") : \"—\"}\n                        </div>\n                      </div>\n                      <span className=\"font-bold text-xs text-blue-600 bg-white px-2 py-1 rounded border border-blue-200\">\n                        {nv.tienDo}%\n                      </span>\n                    </div>\n                  ))}\n                </div>\n              ) : (\n                <div className=\"text-xs text-gray-400 italic bg-gray-50 p-2 rounded\">\n                  (Khối này hiện đang vận hành ổn định, không có dự án nâng cấp quy mô lớn trong lộ trình hiện tại)\n                </div>\n              )}\n            </div>\n\n            {/* Danh sách hệ thống số hiện trạng */}\n            <div>\n              <div className=\"font-bold text-gray-800 text-sm mb-2 flex items-center gap-1.5\">\n                <DatabaseOutlined className=\"text-blue-500\" />\n                <span>Hệ thống số & CSDL Hiện trạng thuộc khối này ({getMatchedItems(selectedBlock).length}):</span>\n              </div>\n              {getMatchedItems(selectedBlock).length > 0 ? (\n                <div className=\"max-h-60 overflow-y-auto space-y-1.5 pr-1\">\n                  {getMatchedItems(selectedBlock).slice(0, 30).map((ht) => (\n                    <div key={ht.id} className=\"p-2 bg-white rounded border border-gray-200 hover:border-blue-300 text-xs flex justify-between items-center\">\n                      <div className=\"flex-1 pr-2\">\n                        <span className=\"font-mono font-bold text-slate-800 bg-slate-200 px-1.5 py-0.5 rounded mr-1.5 text-[10px]\">\n                          {ht.ma}\n                        </span>\n                        <span className=\"font-medium text-gray-800\">{ht.ten}</span>\n                        <div className=\"text-[10px] text-gray-400 mt-0.5\">\n                          {ht.donVi?.ten || ht.chuQuan || \"Chưa xác định\"} {ht.namTrienKhai ? `• Năm ${ht.namTrienKhai}` : \"\"}\n                        </div>\n                      </div>\n                      <span className={`text-[10px] font-bold px-2 py-0.5 rounded border ${TRANG_THAI_CONFIG[ht.trangThai]?.badgeClass || \"\"}`}>\n                        {TRANG_THAI_CONFIG[ht.trangThai]?.label || ht.trangThai}\n                      </span>\n                    </div>\n                  ))}\n                  {getMatchedItems(selectedBlock).length > 30 && (\n                    <div className=\"text-center text-xs text-blue-600 py-2\">\n                      ...và còn {getMatchedItems(selectedBlock).length - 30} CSDL/phần mềm chuyên ngành khác.\n                    </div>\n                  )}\n                </div>\n              ) : (\n                <div className=\"text-xs text-gray-400 italic bg-gray-50 p-2 rounded\">\n                  (Khối này đóng vai trò quy chuẩn mục tiêu kết nối liên thông)\n                </div>\n              )}\n            </div>\n          </div>\n        )}\n      </Modal>\n    </div>\n  );\n}\n","Description":"Expand container to full width and make font sizes larger and clearer","Overwrite":true,"TargetFile":"e:/KTS/123/src/app/(portal)/kts/so-do/page.tsx","toolActi