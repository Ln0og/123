389:             <span className=\"bg-blue-500/30 text-blue-200 border border-blue-400/40 text-xs px-2.5 py-0.5 rounded-full font-semibold\">\r\n390:               Khung KTS Vĩnh Long (PB 1.0)\r\n391:             </span>\r\n392:             <span className=\"text-xs text-blue-300\">Cập nhật theo QĐ 1425/QĐ-TTg</span>\r\n393:           </div>\r\n394:           <h1 className=\"text-2xl font-bold tracking-tight text-white m-0\">\r\n395:             Đánh Giá & Quản Lý Hiện Trạng Kiến Trúc Số\r\n396:           </h1>\r\n397:           <p className=\"text-sm text-blue-200/90 mt-1 mb-0 max-w-2xl\">\r\n398:             Tổng hợp kiểm kê <b>{totalCount} thành phần số</b> trên toàn tỉnh, phân tích theo 4 lớp chuẩn kiến trúc và trạng thái hoạt động.\r\n399:           </p>\r\n400:         </div>\r\n401: \r\n402:         {/* View Mode Toggle */}\r\n403:         <div className=\"bg-white/10 p-1.5 rounded-xl backdrop-blur-md border border-white/20\">\r\n404:           <Segmented\r\n405:             value={viewMode}\r\n406:             onChange={(val) => setViewMode(val as \"list\" | \"dashboard\")}\r\n407:             options={[\r\n408:               { label: \"📋 Danh mục Kiểm kê\", value: \"list\", icon: <TableOutlined /> },\r\n409:               { label: \"📊 Tổng quan Thống kê\", value: \"dashboard\", icon: <PieChartOutlined /> },\r\n410:             ]}\r\n411:             className=\"bg-white/20 text-white font-bold\"\r\n412:           />\r\n413:         </div>\r\n414:       </div>\r\n415: \r\n416:       {/* 4 KPI Summary Cards */}\r\n417:       <Row gutter={[16, 16]}>\r\n418:         <Col xs={24} sm={12} lg={6}>\r\n419:           <Card className=\"shadow-xs hover:shadow-md transition-all border-l-4 border-l-purple-600 bg-white\" size=\"small\">\r\n420:             <div className=\"flex justify-between items-center\">\r\n421:               <div>\r\n422:                 <div className=\"text-xs font-semibold text-gray-500 uppercase tracking-wider\">Lớp 1: Hạ tầng & ATTT</div>\r\n423:                 <div className=\"text-2xl font-bold text-gray-800 mt-1\">{lop1Count} <span className=\"text-xs font-normal text-gray-400\">hệ thống</span></div>\r\n424:               </div>\r\n425:               <div className=\"w-10 h-10 rounded-lg bg-purple-50 flex items-center justify-center text-purple-600 text-lg\">\r\n426:                 🏗️\r\n427:               </div>\r\n428:             </div>\r\n429:             <Progress percent={Math.round((lop1Count / totalCount) * 100)} strokeColor=\"#722ed1\" size=\"small\" className=\"mt-2 mb-0\" />\r\n430:           </Card>\r\n431:         </Col>\r\n432: \r\n433:         <Col xs={24} sm={12} lg={6}>\r\n434:           <Card className=\"shadow-xs hover:shadow-md transition-all border-l-4 border-l-blue-600 bg-white\" size=\"small\">\r\n435:             <div className=\"flex justify-between items-center\">\r\n436:               <div>\r\n437:                 <div className=\"text-xs font-semibold text-gray-500 uppercase tracking-wider\">Lớp 2: Dữ liệu & Nền tảng</div>\r\n438:                 <div className=\"text-2xl font-bold text-gray-800 mt-1\">{lop2Count} <span className=\"text-xs font-normal text-gray-400\">hệ thống</span></div>\r\n439:               </div>\r\n440:               <div className=\"w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center text-blue-600 text-lg\">\r\n441:                 🗄️\r\n442:               </div>\r\n443:             </div>\r\n444:             <Progress percent={Math.round((lop2Count / totalCount) * 100)} strokeColor=\"#1677ff\" size=\"small\" className=\"mt-2 mb-0\" />\r\n445:           </Card>\r\n446:         </Col>\r\n447: \r\n448:         <Col xs={24} sm={12} lg={6}>\r\n449:           <Card className=\"shadow-xs hover:shadow-md transition-all border-l-4 border-l-green-600 bg-white\" size=\"small\">\r\n450:             <div className=\"flex justify-between items-center\">\r\n451:               <div>\r\n452:                 <div className=\"text-xs font-semibold text-gray-500 uppercase tracking-wider\">Lớp 3: Ứng dụng & Nghiệp vụ</div>\r\n453:                 <div className=\"text-2xl font-bold text-gray-800 mt-1\">{lop3Count} <span className=\"text-xs font-normal text-gray-400\">hệ thống</span></div>\r\n454:               </div>\r\n455:               <div className=\"w-10 h-10 rounded-lg bg-green-50 flex items-center justify-center text-green-600 text-lg\">\r\n456:                 📱\r\n457:               </div>\r\n458:             </div>\r\n459:             <Progress percent={Math.round((lop3Count / totalCount) * 100)} strokeColor=\"#52c41a\" size=\"small\" className=\"mt-2 mb-0\" />\r\n460:           </Card>\r\n461:         </Col>\r\n462: \r\n463:         <Col xs={24} sm={12} lg={6}>\r\n464:           <Card className=\"shadow-xs hover:shadow-md transition-all border-l-4 border-l-orange-500 bg-white\" size=\"small\">\r\n465:             <div className=\"flex justify-between items-center\">\r\n466:               <div>\r\n467:                 <div className=\"text-xs font-semibold text-gray-500 uppercase tracking-wider\">Lớp 4: Kênh tương tác</div>\r\n468:                 <div className=\"text-2xl font-bold text-gray-800 mt-1\">{lop4Count} <span className=\"text-xs font-normal text-gray-400\">hệ thống</span></div>\r\n469:               </div>\r\n470:               <div className=\"w-10 h-10 rounded-lg bg-orange-50 flex items-center justify-center text-orange-600 text-lg\">\r\n471:                 🌐\r\n472:               </div>\r\n473:             </div>\r\n474:             <Progress percent={Math.round((lop4Count / totalCount) * 100)} strokeColor=\"#fa8c16\" size=\"small\" className=\"mt-2 mb-0\" />\r\n475:           </Card>\r\n476:         </Col>\r\n477:       </Row>\r\n478: \r\n479:       {/* DASHBOARD VIEW */}\r\n480:       {viewMode === \"dashboard\" && (\r\n481:         <div className=\"space-y-6\">\r\n482:           {/* Status highlight summary */}\r\n483:           <Row gutter={[16, 16]}>\r\n484:             <Col xs={24} md={8}>\r\n485:               <Card className=\"bg-gradient-to-br from-green-50 to-emerald-50 border-green-200 shadow-xs\" size=\"small\">\r\n486:                 <div className=\"flex items-center gap-3\">\r\n487:                   <CheckCircleOutlined className=\"text-3xl text-green-600\" />\r\n488:                   <div>\r\n489:                     <div className=\"text-xs text-green-700 font-semibold uppercase\">Đang vận hành ổn định</div>\r\n490:                     <div className=\"text-2xl font-bold text-green-800\">{dangVanHanhCount} <span className=\"text-xs font-normal text-green-600\">({Math.round((dangVanHanhCount / totalCount) * 100)}%)</span></div>\r\n491:                   </div>\r\n492:                 </div>\r\n493:               </Card>\r\n494:             </Col>\r\n495:             <Col xs={24} md={8}>\r\n496:               <Card className=\"bg-gradient-to-br from-amber-50 to-yellow-50 border-amber-200 shadow-xs\" size=\"small\">\r\n497:                 <div className=\"flex items-center gap-3\">\r\n498:                   <WarningOutlined className=\"text-3xl text-amber-500\" />\r\n499:                   <div>\r\n500:                     <div className=\"text-xs text-amber-700 font-semibold uppercase\">Cần nâng cấp / Hoàn thiện</div>\r\n501:                     <div className=\"text-2xl font-bold text-amber-800\">{canNangCapCount} <span className=\"text-xs font-normal text-amber-600\">({Math.round((canNangCapCount / totalCount) * 100)}%)</span></div>\r\n502:                   </div>\r\n503:                 </div>\r\n504:               </Card>\r\n505:             </Col>\r\n506:             <Col xs={24} md={8}>\r\n507:               <Card className=\"bg-gradient-to-br from-red-50 to-rose-50 border-red-200 shadow-xs\" size=\"small\">\r\n508:                 <div className=\"flex items-center gap-3\">\r\n509:                   <CloseCircleOutlined className=\"text-3xl text-red-500\" />\r\n510:                   <div>\r\n511:                     <div className=\"text-xs text-red-700 font-semibold uppercase\">Cần thay thế / Hợp nhất</div>\r\n512:                     <div className=\"text-2xl font-bold text-red-800\">{canThayTheCount} <span className=\"text-xs font-normal text-red-600\">({Math.round((canThayTheCount / totalCount) * 100)}%)</span></div>\r\n513:                   </div>\r\n514:                 </div>\r\n515:               </Card>\r\n516:             </Col>\r\n517:           </Row>\r\n518: \r\n519:           {/* Charts Row */}\r\n520:           <Row gutter={[16, 16]}>\r\n521:             <Col xs={24} lg={12}>\r\n522:               <Card title={<span className=\"font-bold text-gray-800\">📊 Phân Bổ Hệ Thống Theo 4 Lớp Kiến Trúc</span>} className=\"shadow-xs h-full\">\r\n523:                 <div className=\"h-64 w-full\">\r\n524:                   <ResponsiveContainer width=\"100%\" height=\"100%\">\r\n525:                     <PieChart>\r\n526:                       <Pie\r\n527:                         data={layerChartData}\r\n528:                         cx=\"50%\"\r\n529:                         cy=\"50%\"\r\n530:                         innerRadius={60}\r\n531:                         outerRadius={90}\r\n532:                         paddingAngle={4}\r\n533:                         dataKey=\"value\"\r\n534:                         label={({ percent }: { percent?: number }) => `${((percent || 0) * 100).toFixed(0)}%`}\r\n535:                       >\r\n536:                         {layerChartData.map((entry, index) => (\r\n537:                           <Cell key={`cell-${index}`} fill={entry.color} />\r\n538:                         ))}\r\n539:                       </Pie>\r\n540:                       <RechartsTooltip />\r\n541:                       <Legend />\r\n542:                     </PieChart>\r\n543:                   </ResponsiveContainer>\r\n544:                 </div>\r\n545:               </Card>\r\n546:             </Col>\r\n547: \r\n548:             <Col xs={24} lg={12}>\r\n549:               <Card title={<span className=\"font-bold text-gray-800\">🏛️ Top Sở / Ngành Có Nhiều Hệ Thống & CSDL Nhất</span>} className=\"shadow-xs h-full\">\r\n550:                 <div className=\"h-64 w-full\">\r\n551:                   <ResponsiveContainer width=\"100%\" height=\"100%\">\r\n552:                     <BarChart data={deptChartData} layout=\"vertical\" margin={{ top: 5, right: 30, left: 40, bottom: 5 }}>\r\n553:                       <XAxis type=\"number\" />\r\n554:                       <YAxis type=\"category\" dataKey=\"name\" tick={{ fontSize: 11 }} width={120} />\r\n555:                       <RechartsTooltip />\r\n556:                       <Bar dataKey=\"count\" name=\"Số lượng hệ thống\" fill=\"#3b82f6\" radius={[0, 4, 4, 0]} />\r\n557:                     </BarChart>\r\n558:                   </ResponsiveContainer>\r\n559:                 </div>\r\n560:               </Card>\r\n561:             </Col>\r\n562:           </Row>\r\n563: \r\n564:           {/* Additional Trends & Quick Action */}\r\n565:           <Card \r\n566:             title={<span className=\"font-bold text-gray-800\">📅 Phân Bố Theo Năm Đưa Vào Khai Thác</span>}\r\n567:             extra={<Button type=\"link\" onClick={() => setViewMode(\"list\")}>Xem chi tiết từng hệ thống →</Button>}\r\n568:             className=\"shadow-xs\"\r\n569:           >\r\n570:             <div className=\"h-56 w-full\">\r\n571:               <ResponsiveContainer width=\"100%\" height=\"100%\">\r\n572:                 <BarChart data={yearChartData} margin={{ top: 10, right: 30, left: 0, bottom: 5 }}>\r\n573:                   <XAxis dataKey=\"year\" />\r\n574:                   <YAxis />\r\n575:                   <RechartsTooltip />\r\n576:                   <Bar dataKey=\"count\" name=\"Số lượng đưa vào vận hành\" fill=\"#10b981\" radius={[4, 4, 0, 0]} />\r\n577:                 </BarChart>\r\n578:               </ResponsiveContainer>\r\n579:             </div>\r\n580:           </Card>\r\n581:     