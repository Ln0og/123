{"step_index":434,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-21T02:24:46Z","content":"Created At: 2026-09-21T09:24:46+07:00\nCompleted At: 2026-09-21T09:24:46+07:00\nFile Path: `file:///e:/KTS/123/src/app/%28portal%29/kts/hien-trang/page.tsx`\nTotal Lines: 823\nTotal Bytes: 35390\nShowing lines 1 to 300\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"use client\";\n2: import { useEffect, useState, useMemo } from \"react\";\n3: import { \n4:   Card, \n5:   Tag, \n6:   Progress, \n7:   Tabs, \n8:   Badge, \n9:   Spin, \n10:   Empty, \n11:   Pagination, \n12:   Modal, \n13:   Descriptions, \n14:   Input, \n15:   Select, \n16:   Button, \n17:   Segmented, \n18:   Table, \n19:   Tooltip,\n20:   Row,\n21:   Col,\n22:   Statistic\n23: } from \"antd\";\n24: import { HeThongSoData } from \"@/types\";\n25: import { LOP_CONFIG, TRANG_THAI_CONFIG, PHUONG_AN_CONFIG } from \"@/lib/utils\";\n26: import { \n27:   DatabaseOutlined, \n28:   GlobalOutlined, \n29:   BankOutlined,\n30:   CalendarOutlined,\n31:   SearchOutlined,\n32:   AppstoreOutlined,\n33:   TableOutlined,\n34:   PieChartOutlined,\n35:   CheckCircleOutlined,\n36:   WarningOutlined,\n37:   CloseCircleOutlined,\n38:   ApartmentOutlined,\n39:   LinkOutlined,\n40:   FilterOutlined,\n41:   EyeOutlined,\n42:   FileExcelOutlined\n43: } from \"@ant-design/icons\";\n44: import { \n45:   ResponsiveContainer, \n46:   PieChart, \n47:   Pie, \n48:   Cell, \n49:   BarChart, \n50:   Bar, \n51:   XAxis, \n52:   YAxis, \n53:   Tooltip as RechartsTooltip, \n54:   Legend \n55: } from \"recharts\";\n56: \n57: const { Search } = Input;\n58: \n59: export default function HienTrangPage() {\n60:   const [data, setData] = useState<HeThongSoData[]>([]);\n61:   const [loading, setLoading] = useState(true);\n62:   const [viewMode, setViewMode] = useState<\"cards\" | \"dashboard\" | \"table\">(\"dashboard\");\n63:   const [selectedLop, setSelectedLop] = useState(\"all\");\n64:   const [searchQuery, setSearchQuery] = useState(\"\");\n65:   const [filterTrangThai, setFilterTrangThai] = useState<string>(\"\");\n66:   const [filterDonVi, setFilterDonVi] = useState<string>(\"\");\n67:   const [currentPage, setCurrentPage] = useState(1);\n68:   const [selectedItem, setSelectedItem] = useState<HeThongSoData | null>(null);\n69:   const PAGE_SIZE = 9;\n70: \n71:   useEffect(() => {\n72:     fetch(\"/api/he-thong\")\n73:       .then((r) => r.json())\n74:       .then((d) => {\n75:         setData(Array.isArray(d) ? d : []);\n76:         setLoading(false);\n77:       })\n78:       .catch(() => {\n79:         setData([]);\n80:         setLoading(false);\n81:       });\n82:   }, []);\n83: \n84:   // Filter options\n85:   const donViOptions = useMemo(() => {\n86:     const set = new Set<string>();\n87:     data.forEach((d) => {\n88:       const name = d.donVi?.ten || d.chuQuan;\n89:       if (name) set.add(name.trim());\n90:     });\n91:     return Array.from(set).sort();\n92:   }, [data]);\n93: \n94:   // Filtered dataset\n95:   const filteredData = useMemo(() => {\n96:     return data.filter((item) => {\n97:       if (selectedLop !== \"all\" && item.lop !== parseInt(selectedLop)) return false;\n98:       if (filterTrangThai && item.trangThai !== filterTrangThai) return false;\n99:       if (filterDonVi) {\n100:         const dvName = item.donVi?.ten || item.chuQuan || \"\";\n101:         if (!dvName.includes(filterDonVi)) return false;\n102:       }\n103:       if (searchQuery.trim()) {\n104:         const q = searchQuery.toLowerCase();\n105:         const matchMa = item.ma.toLowerCase().includes(q);\n106:         const matchTen = item.ten.toLowerCase().includes(q);\n107:         const matchMoTa = (item.moTa || \"\").toLowerCase().includes(q);\n108:         const matchDonVi = (item.donVi?.ten || item.chuQuan || \"\").toLowerCase().includes(q);\n109:         if (!matchMa && !matchTen && !matchMoTa && !matchDonVi) return false;\n110:       }\n111:       return true;\n112:     });\n113:   }, [data, selectedLop, filterTrangThai, filterDonVi, searchQuery]);\n114: \n115:   // Statistics\n116:   const totalCount = data.length;\n117:   const lop1Count = data.filter((d) => d.lop === 1).length;\n118:   const lop2Count = data.filter((d) => d.lop === 2).length;\n119:   const lop3Count = data.filter((d) => d.lop === 3).length;\n120:   const lop4Count = data.filter((d) => d.lop === 4).length;\n121: \n122:   const dangVanHanhCount = data.filter((d) => d.trangThai === \"dang-van-hanh\").length;\n123:   const canNangCapCount = data.filter((d) => d.trangThai === \"can-nang-cap\").length;\n124:   const canThayTheCount = data.filter((d) => d.trangThai === \"can-thay-the\").length;\n125: \n126:   // Chart data: by Layer\n127:   const layerChartData = [\n128:     { name: \"Lớp 1: Hạ tầng\", value: lop1Count, color: \"#722ed1\" },\n129:     { name: \"Lớp 2: Dữ liệu\", value: lop2Count, color: \"#1677ff\" },\n130:     { name: \"Lớp 3: Ứng dụng\", value: lop3Count, color: \"#52c41a\" },\n131:     { name: \"Lớp 4: Kênh tương tác\", value: lop4Count, color: \"#fa8c16\" },\n132:   ];\n133: \n134:   // Chart data: by Status\n135:   const statusChartData = [\n136:     { name: \"Đang vận hành\", value: dangVanHanhCount, color: \"#52c41a\" },\n137:     { name: \"Cần nâng cấp\", value: canNangCapCount, color: \"#faad14\" },\n138:     { name: \"Cần thay thế\", value: canThayTheCount, color: \"#ff4d4f\" },\n139:   ];\n140: \n141:   // Chart data: top Departments\n142:   const deptChartData = useMemo(() => {\n143:     const counts: Record<string, number> = {};\n144:     data.forEach((d) => {\n145:       let dept = d.donVi?.ten || d.chuQuan || \"Khác\";\n146:       if (dept.length > 25) dept = dept.substring(0, 22) + \"...\";\n147:       counts[dept] = (counts[dept] || 0) + 1;\n148:     });\n