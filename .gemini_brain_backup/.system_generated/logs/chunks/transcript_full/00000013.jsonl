    confirmLoading={saving}\n124:         okText={editing ? \"Cập nhật\" : \"Thêm mới\"}\n125:         width={640}\n126:       >\n127:         <Form form={form} layout=\"vertical\" className=\"mt-4\">\n128:           <div className=\"grid grid-cols-2 gap-4\">\n129:             <Form.Item label=\"Mã\" name=\"ma\" rules={[{ required: true }]}>\n130:               <Input placeholder=\"HT-01\" />\n131:             </Form.Item>\n132:             <Form.Item label=\"Lớp kiến trúc\" name=\"lop\" rules={[{ required: true }]}>\n133:               <Select>\n134:                 {[1,2,3,4].map(l => <Select.Option key={l} value={l}>{LOP_CONFIG[l as 1|2|3|4].icon} Lớp {l} — {LOP_CONFIG[l as 1|2|3|4].shortLabel}</Select.Option>)}\n135:               </Select>\n136:             </Form.Item>\n137:           </div>\n138:           <Form.Item label=\"Tên hệ thống\" name=\"ten\" rules={[{ required: true }]}>\n139:             <Input placeholder=\"Tên đầy đủ của hệ thống\" />\n140:           </Form.Item>\n141:           <Form.Item label=\"Mô tả\" name=\"moTa\">\n142:             <TextArea rows={3} placeholder=\"Mô tả ngắn gọn về hệ thống, phạm vi, chức năng...\" />\n143:           </Form.Item>\n144:           <div className=\"grid grid-cols-2 gap-4\">\n145:             <Form.Item label=\"Loại\" name=\"loai\" rules={[{ required: true }]}>\n146:               <Select>\n147:                 <Select.Option value=\"ha-tang\">Hạ tầng số</Select.Option>\n148:                 <Select.Option value=\"du-lieu\">Dữ liệu & NTL</Select.Option>\n149:                 <Select.Option value=\"ung-dung\">Ứng dụng & NV</Select.Option>\n150:                 <Select.Option value=\"kenh-tuong-tac\">Kênh tương tác</Select.Option>\n151:               </Select>\n152:             </Form.Item>\n153:             <Form.Item label=\"Trạng thái\" name=\"trangThai\">\n154:               <Select>\n155:                 <Select.Option value=\"dang-van-hanh\">Đang vận hành</Select.Option>\n156:                 <Select.Optio