  fetchNhiemVu();\n34:     // eslint-disable-next-line react-hooks/exhaustive-deps\n35:   }, []);\n36: \n37:   const openEdit = (record: NhiemVuData) => {\n38:     setEditing(record);\n39:     form.setFieldsValue({ ...record, thoiHan: record.thoiHan ? dayjs(record.thoiHan) : null });\n40:     setModalOpen(true);\n41:   };\n42: \n43:   const openCreate = () => {\n44:     setEditing(null);\n45:     form.resetFields();\n46:     form.setFieldsValue({ trangThai: \"chua-bat-dau\", uuTien: \"trung-binh\", tienDo: 0, lop: 2 });\n47:     setModalOpen(true);\n48:   };\n49: \n50:   const handleSave = async () => {\n51:     try {\n52:       const values = await form.validateFields();\n53:       setSaving(true);\n54:       const payload = { ...values, thoiHan: values.thoiHan ? values.thoiHan.toISOString() : null };\n55:       const url = editing ? `/api/nhiem-vu/${editing.id}` : \"/api/nhiem-vu\";\n56:       const method = editing ? \"PUT\" : \"POST\";\n57:       const res = await fetch(url, { method, headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify(payload) });\n58:       if (res.ok) { message.success(editing ? \"Đã cập nhật!\" : \"Đã thêm!\"); setModalOpen(false);        fetchNhiemVu();\n59:       } else {\n60:         message.error(\"Lỗi khi lưu!\");\n61:       }\n62:     } catch {\n63:       // validation error\n64:     }\n65:     setSaving(false);\n66:   };\n67: \n68:   const handleDelete = async (id: string) => {\n69:     const res = await fetch(`/api/nhiem-vu/${id}`, { method: \"DELETE\" });\n70:     if (res.ok) { message.success(\"Đã xóa!\"); fetchNhiemVu(); }\n71:     else message.error(\"Lỗi khi xóa!\");\n72:   };\n73: \n74:   const columns: ColumnsType<NhiemVuData> = [\n75:     { title: \"Mã\", dataIndex: \"ma\", width: 80, render: ma => <span className=\"font-mono text-xs bg-gray-100 px-2 py-1 rounded\">{ma}</span> },\n76:     { title: \"Nhiệm vụ\", dataIndex: \"ten\", render: (ten, rec) => (\n77:       <div>\n78:         <div className=\"font-medium text-gray-800\">{ten}</div>\n79:         {rec.phuongAnXuLy && <div className=\"text-xs text-blue-500\">{PHUONG_AN_CONFIG[rec.phuongAnXuLy]}</div>}\n80:       </div>\n81:     )},\n82:     { title: \"Lớp\", dataIndex: \"lop\", width: 100, render: lop => {\n83:       const cfg = LOP_CONFIG[lop as 1|2|3|4];\n84:       return <Tag style={{ color: cfg.color, backgroundColor: cfg.bgColor, borderColor: cfg.borderColor }}>{cfg.icon} L{lop}</Tag>;\n85:     }},\n86:     { title: \"Ưu tiên\", dataIndex: \"uuTien\", width: 90, render: uuTien => (\n87:       <Tag color={uuTien === \"cao\" ? \"red\" : uuTien === \"trung-binh\" ? \"orange\" : \"green\"}>\n88:         {UU_TIEN_CONFIG[uuTien]?.label || uuTien}\n89:       </Tag>\n90:     )},\n91:     { title: \"Thời hạn\", dataIndex: \"thoiHan\", width: 110, render: (d, rec) => {\n92:       const overdue = isOverdue(d) && rec.trangThai !== \"hoan-thanh\";\n93:       return <span className={overdue ? \"text-red-500 font-semibold\" : \"text-gray-600\"}>\n94:         {overdue && <WarningOutlined className=\"mr-1\" />}{formatDate(d)}\n95:       </span>;\n96:     }},\n97:     { title: \"Tiến độ\", dataIndex: \"tienDo\", width: 150, render: (p, rec) => (\n98:       <div>\n99:         <Progress percent={p} size=\"small\" status={rec.trangThai === \"hoan-thanh\" ? \"success\" : isOverdue(rec.thoiHan) && rec.trangThai !== \"hoan-thanh\" ? \"exception\" : \"active\"} />\n100:         <div className=\"text-xs text-gray-400\">{TRANG_THAI_CONFIG[rec.trangThai]?.label}</div>\n101:       </div>\n102:     )},\n103:     { title: \"Thao tác\", width: 90, render: (_, rec) => (\n104:       <div className=\"flex gap-1\">\n105:         <Button icon={<EditOutlined />} size=\"small\" onClick={() => openEdit(rec)} />\n106:         <Popconfirm title=\"Xóa nhiệm vụ này?\" onConfirm={() => handleDelete(rec.id)} okText=\"Xóa\" cancelText=\"Hủy\" okButtonProps={{ danger: true }}>\n107:           <Button icon={<DeleteOutlined />} size=\"small\" danger />\n108:         </Popconfirm>\n109:       </div>\n110:     )},\n111:   ];\n112: \n113:   return (\n114:     <div>\n115:       <div className=\"flex justify-between items-center mb-6\">\n116:         <div>\n117:           <h1 className=\"text-xl font-bold text-gray-800\">Nhiệm vụ & Lộ trình</h1>\n118:           <p className=\"text-gray-400 text-sm\">Quản lý các nhiệm vụ chuyển đổi kiến trúc số (tương ứng bảng HOANTHIEN_NV trong Mẫu 03)</p>\n119:         </div>\n120:         <Button type=\"primary\" icon={<PlusOutlined />} onClick={openCreate} style={{ backgroundColor: \"#003087\" }}>\n121:           Thêm nhiệm vụ\n122:         </Button>\n123:       </div>\n124:       <Card className=\"shadow-sm\">\n125:         <Table columns={columns} dataSource={data} rowKey=\"id\" loading={loading} size=\"middle\" pagination={{ pageSize: 20 }}\n126:           rowClassName={r => isOverdue(r.thoiHan) && r.trangThai !== \"hoan-thanh\" ? \"bg-red-50\" : r.trangThai === \"hoan-thanh\" ? \"bg-green-50\" : \"\"} />\n127:       </Card>\n128: \n129:       <Modal title={editing ? \"Sửa nhiệm vụ\" : \"Thêm nhiệm vụ mới\"} open={modalOpen} onOk={handleSave} onCancel={() => setModalOpen(false)} confirmLoading={saving} okText={editing ? \"Cập nhật\" : \"Thêm mới\"} width={720}>\n130:         <Form form={form} layout=\"vertical\" className=\"mt-4\">\n131:           <div className=\"grid grid-cols-3 gap-4\">\n132:             <Form.Item label=\"Mã\" name=\"ma\" rules={[{ required: true }]}><Input placeholder=\"NV-01\" /></Form.Item>\n133:             <Form.Item label=\"Lớp\" name=\"lop\" rules={[{ required: true }]}>\n134:               <Select>{[1,2,3,4].map(l => <Select.Option key={l} value={l}>{LOP_CONFIG[l as 1|2|3|4].icon} Lớp {l}</Select.Option>)}</Select>\n135:             </Form.Item>\n136:             <Form.Item label=\"Ưu tiên\" name=\"uuTien\"><Select><Select.Option value=\"cao\">🔴 Cao</Select.Option><Select.Option value=\"trung-binh\">🟡 Trung bình</Select.Option><Select.Option value=\"thap\">🟢 Thấp</Select.Option></Select></Form.Item>\n137:           </div>\n138:           <Form.Item label=\"Tên nhiệm vụ\" name=\"ten\" rules={[{ required: true }]}><Input /></Form.Item>\n139:           <Form.Item label=\"Mô tả\" name=\"moTa\"><TextArea rows={3} /></Form.Item>\n140:           <div className=\"grid grid-cols-2 gap-4\">\n141:             <Form.Item label=\"Đơn vị chủ trì\" name=\"donViChuTriId\">\n142:               <Select allowClear placeholder=\"Chọn đơn vị\">\n143:                 {donVis.map(dv => <Select.Option key={dv.id} value={dv.id}>{dv.ten}</Select.Option>)}\n144:               </Select>\n145:             </Form.Item>\n146:             <Form.Item label=\"Thời hạn hoàn thành\" name=\"thoiHan\"><DatePicker style={{ width: \"100%\" }} format=\"DD/MM/YYYY\" /></Form.Item>\n147:             <Form.Item label=\"Giai đoạn\" name=\"giaiDoan\"><Input placeholder=\"2026-2027\" /></Form.Item>\n148:             <Form.Item label=\"Trạng thái\" name=\"trangThai\">\n149:               <Select>\n150:                 <Select.Option value=\"chua-bat-dau\">Chưa bắt đầu</Select.Option>\n151:                 <Select.Option value=\"dang-thuc-hien\">Đang thực hiện</Select.Option>\n152:                 <Select.Option value=\"hoan-thanh\">Hoàn thành</Select.Option>\n153:                 <Select.Option value=\"tre-han\">Trễ hạn</Select.Option>\n154:               </Select>\n155:             </Form.Item>\n156:           </div>\n157:           <Form.Item label=\"Phương án xử lý\" name=\"phuongAnXuLy\">\n158:             <Select allowClear placeholder=\"Chọn phương án\">\n159:               {Object.entries(PHUONG_AN_CONFIG).map(([k, v]) => <Select.Option key={k} value={k}>{v}</Select.Option>)}\n160:             </Select>\n161:           </Form.Item>\n162:           <Form.Item label=\"KPI / Tiêu chí kiểm chứng\" name=\"kpi\"><TextArea rows={2} /></Form.Item>\n163:           <Form.Item label={`Tiến độ thực hiện`} name=\"tienDo\">\n164:             <Slider marks={{ 0: \"0%\", 25: \"25%\", 50: \"50%\", 75: \"75%\", 100: \"100%\" }} />\n165:           </Form.Item>\n166:           <Form.Item label=\"Ghi chú\" name=\"ghiChu\"><TextArea rows={2} /></Form.Item>\n167:         </Form>\n168:       </Modal>\n169:     </div>\n170:   );\n171: }\n172: \nThe above content shows the entire, complete file contents of the requested file.\n"}
