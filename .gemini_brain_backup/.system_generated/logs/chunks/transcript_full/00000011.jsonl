asks = (block: FrameworkBlock) => {\n358:     return nhiemVus.filter(block.tasksMatch);\n359:   };\n360: \n361:   // Render an ultra-clean, minimalist tile\n362:   const renderTile = (blockKey: string) => {\n363:     const block = frameworkBlocks[blockKey];\n364:     if (!block) return null;\n365:     const items = getMatchedItems(block);\n366:     const tasks = getMatchedTasks(block);\n367:     const hasUpgrade = items.some((i) => i.trangThai === \"can-nang-cap\") || tasks.length > 0;\n368: \n369:     return (\n370:       <div\n371:         onClick={() => setSelectedBlock(block)}\n372:         className=\"bg-white hover:bg-blue-50/50 rounded-xl px-4 py-3.5 border border-slate-200 hover:border-blue-500 shadow-2xs hover:shadow-md transition-all cursor-pointer flex items-center justify-between gap-2 group\"\n373:       >\n374:         <div className=\"flex items-center gap-3 min-w-0\">\n375:           <div\n376:             className=\"w-9 h-9 rounded-lg flex items-center justify-center text-base shrink-0 transition-transform group-hover:scale-105\"\n377:             style={{ backgroundColor: block.bgColor, color: block.color }}\n378:           >\n379:             {block.icon}\n380:           </div>\n381:           <span className=\"font-bold text-slate-800 text-sm group-hover:text-blue-700 transition-colors truncate\">\n382:             {block.title}\n383:           </span>\n384:         </div>\n385: \n386:         <div className=\"flex items-center gap-1.5 shrink-0\">\n387:           {items.length > 0 && (\n388:             <span className=\"text-[11px] font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded\">\n389:               {items.length} HT\n390:             </span>\n391:           )}\n392:           {hasUpgrade && (\n393:             <span className=\"w-2 h-2 rounded-full bg-amber-500 animate-pulse\" title=\"Có nhiệm vụ lộ trình\" />\n394:           )}\n395:           <RightOutlined className=\"text-[10px] text-slate-300 group-hover:text-blue-500 grou