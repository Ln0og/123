{"step_index":366,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-21T01:41:40Z","thinking":"Initial design focuses on a clean, executive-ready blueprint for `page.tsx`. The goal is a 3-column layout with a header banner and distinct left, center, and right pillars. The left pillar will contain two blocks: \"Quản trị & Thể chế,\" with \"Ban chỉ đạo C\" as a focus.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"use client\";\nimport { useState, useEffect } from \"react\";\nimport Link from \"next/link\";\nimport { Tag, Modal, Button, Spin } from \"antd\";\nimport {\n  ApartmentOutlined,\n  DatabaseOutlined,\n  GlobalOutlined,\n  BankOutlined,\n  SafetyCertificateOutlined,\n  ThunderboltOutlined,\n  RightOutlined,\n  FileProtectOutlined,\n  CloudServerOutlined,\n  MobileOutlined,\n  NodeIndexOutlined,\n  LockOutlined,\n  DesktopOutlined,\n  TeamOutlined,\n  FundProjectionScreenOutlined,\n  RobotOutlined,\n  DeploymentUnitOutlined,\n  AuditOutlined,\n  SlidersOutlined,\n  ShopOutlined,\n  MedicineBoxOutlined,\n  EnvironmentOutlined,\n  EyeOutlined,\n  CompassOutlined,\n} from \"@ant-design/icons\";\nimport { HeThongSoData, NhiemVuData } from \"@/types\";\nimport { TRANG_THAI_CONFIG } from \"@/lib/utils\";\n\ninterface FrameworkBlock {\n  id: string;\n  title: string;\n  description: string;\n  icon: React.ReactNode;\n  lop: number;\n  category: string;\n  itemsMatch: (ht: HeThongSoData) => boolean;\n  tasksMatch: (nv: NhiemVuData) => boolean;\n  color: string;\n  bgColor: string;\n  borderColor: string;\n}\n\nexport default function SoDoKhungKTSPage() {\n  const [heThongs, setHeThongs] = useState<HeThongSoData[]>([]);\n  const [nhiemVus, setNhiemVus] = useState<NhiemVuData[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [selectedBlock, setSelectedBlock] = useState<FrameworkBlock | null>(null);\n\n  useEffect(() => {\n    Promise.all([\n      fetch(\"/api/he-thong\").then((r) => r.json()),\n      fetch(\"/api/nhiem-vu\").then((r) => r.json()),\n    ])\n      .then(([htData, nvData]) => {\n        setHeThongs(Array.isArray(htData) ? htData : []);\n        setNhiemVus(Array.isArray(nvData) ? nvData : []);\n        setLoading(false);\n      })\n      .catch(() => {\n        setHeThongs([]);\n        setNhiemVus([]);\n        setLoading(false);\n      });\n  }, []);\n\n  // 4 Standard Layers according to Decision 1425/QĐ-TTg (Version 1.0)\n  const frameworkBlocks: Record<string, FrameworkBlock> = {\n    // ==========================================\n    // LỚP 4: KÊNH TƯƠNG TÁC VÀ ĐO LƯỜNG HIỆU QUẢ\n    // ==========================================\n    lop4_dvc: {\n      id: \"lop4_dvc\",\n      title: \"Cổng DVC & Một Cửa\",\n      description: \"Cổng Dịch vụ công trực tuyến tỉnh tích hợp kết nối Cổng DVC Quốc gia và Hệ thống Một cửa điện tử\",\n      icon: <GlobalOutlined />,\n      lop: 4,\n      category: \"Lớp 4: Kênh tương tác & Đo lường\",\n      itemsMatch: (ht) => ht.lop === 4 || ht.ten.toLowerCase().includes(\"dịch vụ công\") || ht.ten.toLowerCase().includes(\"một cửa\"),\n      tasksMatch: (nv) => nv.ma === \"NV-04\" || nv.lop === 4,\n      color: \"#c2410c\",\n      bgColor: \"#fff7ed\",\n      borderColor: \"#fed7aa\",\n    },\n    lop4_app_mobile: {\n      id: \"lop4_app_mobile\",\n      title: \"App Vĩnh Long Smart\",\n      description: \"Ứng dụng công dân số đa tiện ích, tích hợp Zalo Mini App và tài khoản định danh điện tử VNeID\",\n      icon: <MobileOutlined />,\n      lop: 4,\n      category: \"Lớp 4: Kênh tương tác & Đo lường\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"di động\") || ht.ten.toLowerCase().includes(\"app\") || ht.ten.toLowerCase().includes(\"smart\") || ht.ma === \"DL-01\",\n      tasksMatch: (nv) => nv.ma === \"NV-07\" || nv.ma === \"NV-03\",\n      color: \"#ea580c\",\n      bgColor: \"#fff7ed\",\n      borderColor: \"#fed7aa\",\n    },\n    lop4_portal: {\n      id: \"lop4_portal\",\n      title: \"Cổng Thông Tin Tỉnh\",\n      description: \"Hệ thống Cổng thông tin điện tử tỉnh và các trang thành phần của các Sở, Ban, Ngành, UBND cấp huyện\",\n      icon: <ApartmentOutlined />,\n      lop: 4,\n      category: \"Lớp 4: Kênh tương tác & Đo lường\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"cổng thông tin\") || ht.ten.toLowerCase().includes(\"portal\"),\n      tasksMatch: (nv) => false,\n      color: \"#b45309\",\n      bgColor: \"#fefce8\",\n      borderColor: \"#fde68a\",\n    },\n    lop4_kpi_metric: {\n      id: \"lop4_kpi_metric\",\n      title: \"Dashboard Đo Lường KPI\",\n      description: \"Hệ thống giám sát, đo lường mức độ hài lòng, tỷ lệ DVC trực tuyến toàn trình và KPIs phục vụ người dân, doanh nghiệp\",\n      icon: <FundProjectionScreenOutlined />,\n      lop: 4,\n      category: \"Lớp 4: Kênh tương tác & Đo lường\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"đo lường\") || ht.ten.toLowerCase().includes(\"kpi\") || ht.ten.toLowerCase().includes(\"đánh giá\"),\n      tasksMatch: (nv) => nv.ma === \"NV-04\",\n      color: \"#9a3412\",\n      bgColor: \"#fff7ed\",\n      borderColor: \"#fdba74\",\n    },\n\n    // =========================================================================\n    // LỚP 3: ỨNG DỤNG VÀ NGHIỆP VỤ DÙNG CHUNG\n    // =========================================================================\n    // Nhánh 1: Chính quyền số\n    lop3_chidao_dieuhanh: {\n      id: \"lop3_chidao_dieuhanh\",\n      title: \"Chỉ Đạo & Điều Hành\",\n      description: \"Quản lý văn bản điều hành iOffice, phòng họp không giấy e-Cabinet, hệ thống thông tin báo cáo tỉnh\",\n      icon: <FileProtectOutlined />,\n      lop: 3,\n      category: \"Lớp 3: Chính quyền số (Nội bộ & TTHC)\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"văn bản\") || ht.ten.toLowerCase().includes(\"điều hành\") || ht.ten.toLowerCase().includes(\"báo cáo\"),\n      tasksMatch: (nv) => nv.ten.toLowerCase().includes(\"văn bản\"),\n      color: \"#15803d\",\n      bgColor: \"#f0fdf4\",\n      borderColor: \"#bbf7d0\",\n    },\n    lop3_tthc_sohoa: {\n      id: \"lop3_tthc_sohoa\",\n      title: \"Giải Quyết TTHC\",\n      description: \"Quy trình giải quyết TTHC liên thông, số hóa hồ sơ và trả kết quả bản điện tử toàn tỉnh\",\n      icon: <DesktopOutlined />,\n      lop: 3,\n      category: \"Lớp 3: Chính quyền số (Nội bộ & TTHC)\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"thủ tục\") || ht.ten.toLowerCase().includes(\"tthc\"),\n      tasksMatch: (nv) => nv.ma === \"NV-04\",\n      color: \"#047857\",\n      bgColor: \"#ecfdf5\",\n      borderColor: \"#a7f3d0\",\n    },\n    lop3_ioc_tinh: {\n      id: \"lop3_ioc_tinh\",\n      title: \"Trung Tâm IOC Tỉnh\",\n      description: \"Trung tâm Giám sát, Điều hành thông minh tỉnh Vĩnh Long kết nối dữ liệu liên ngành phục vụ lãnh đạo\",\n      icon: <FundProjectionScreenOutlined />,\n      lop: 3,\n      category: \"Lớp 3: Chính quyền số (Nội bộ & TTHC)\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"ioc\") || ht.ten.toLowerCase().includes(\"điều hành thông minh\"),\n      tasksMatch: (nv) => nv.ma === \"NV-08\",\n      color: \"#065f46\",\n      bgColor: \"#f0fdf4\",\n      borderColor: \"#a7f3d0\",\n    },\n    lop3_nghiepvu_chuyennganh: {\n      id: \"lop3_nghiepvu_chuyennganh\",\n      title: \"Nghiệp Vụ Sở Ngành\",\n      description: \"Phần mềm nghiệp vụ quản lý cán bộ công chức, tư pháp hộ tịch, thanh tra, tài chính ngân sách\",\n      icon: <AuditOutlined />,\n      lop: 3,\n      category: \"Lớp 3: Chính quyền số (Nội bộ & TTHC)\",\n      itemsMatch: (ht) => (ht.lop === 3 && !ht.ma.startsWith(\"SNN-\") && ht.ma !== \"UD-03\") || ht.ten.toLowerCase().includes(\"cán bộ\"),\n      tasksMatch: (nv) => false,\n      color: \"#166534\",\n      bgColor: \"#f0fdf4\",\n      borderColor: \"#bbf7d0\",\n    },\n\n    // Nhánh 2: Kinh tế số & Xã hội số\n    lop3_nongnghiep_so: {\n      id: \"lop3_nongnghiep_so\",\n      title: \"Nông Nghiệp & PTNT (380+ CSDL)\",\n      description: \"Bản đồ số canh tác, trạm quan trắc VnEmisoft, CSDL trồng trọt, chăn nuôi, thủy sản, OCOP, truy xuất nguồn gốc\",\n      icon: <ShopOutlined />,\n      lop: 3,\n      category: \"Lớp 3: Kinh tế số & Xã hội số\",\n      itemsMatch: (ht) => ht.ma.startsWith(\"SNN-\") || (ht.donVi?.ten || \"\").includes(\"Nông nghiệp\"),\n      tasksMatch: (nv) => false,\n      color: \"#047857\",\n      bgColor: \"#dcfce7\",\n      borderColor: \"#86efac\",\n    },\n    lop3_yte_so: {\n      id: \"lop3_yte_so\",\n      title: \"Y Tế & Sức Khỏe (HIS/EMR)\",\n      description: \"Quản lý bệnh viện HIS, Bệnh án điện tử EMR, quản lý trạm y tế xã phường, hồ sơ sức khỏe điện tử\",\n      icon: <MedicineBoxOutlined />,\n      lop: 3,\n      category: \"Lớp 3: Kinh tế số & Xã hội số\",\n      itemsMatch: (ht) => ht.ma === \"UD-03\" || ht.ten.toLowerCase().includes(\"y tế\") || ht.ten.toLowerCase().includes(\"his\"),\n      tasksMatch: (nv) => nv.ma === \"NV-09\",\n      color: \"#0e7490\",\n      bgColor: \"#ecfeff\",\n      borderColor: \"#a5f3fc\",\n    },\n    lop3_datdai_tnmt: {\n      id: \"lop3_datdai_tnmt\",\n      title: \"Đất Đai & TN-MT (NDOP)\",\n      description: \"CSDL Đất đai tỉnh kết nối nền tảng điều phối dữ liệu đất đai quốc gia (NDOP), quan trắc môi trường\",\n      icon: <EnvironmentOutlined />,\n      lop: 3,\n      category: \"Lớp 3: Kinh tế số & Xã hội số\",\n      itemsMatch: (ht) => ht.ma === \"DL-02\" || ht.ten.toLowerCase().includes(\"đất đai\") || ht.ten.toLowerCase().includes(\"môi trường\"),\n      tasksMatch: (nv) => nv.ma === \"NV-01\",\n      color: \"#1d4ed8\",\n      bgColor: \"#eff6ff\",\n      borderColor: \"#bfdbfe\",\n    },\n    lop3_dothi_kinhte: {\n      id: \"lop3_dothi_kinhte\",\n      title: \"Đô Thị, Du Lịch & GD\",\n      description: \"Cổng du lịch thông minh, giáo dục số, chiếu sáng/giao thông thông minh, thương mại điện tử\",\n      icon: <CompassOutlined />,\n      lop: 3,\n      category: \"Lớp 3: Kinh tế số & Xã hội số\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"du lịch\") || ht.ten.toLowerCase().includes(\"giáo dục\") || ht.ten.toLowerCase().includes(\"thương mại\"),\n      tasksMatch: (nv) => false,\n      color: \"#4338ca\",\n      bgColor: \"#eef2ff\",\n      borderColor: \"#c7d2fe\",\n    },\n\n    // ==========================================\n    // LỚP 2: DỮ LIỆU VÀ NỀN TẢNG LÕI\n    // ==========================================\n    lop2_lgsp_ndxp: {\n      id: \"lop2_lgsp_ndxp\",\n      title: \"Trục LGSP / NDXP\",\n      description: \"Nền tảng tích hợp, chia sẻ dữ liệu cấp tỉnh (LGSP) liên thông Trục Quốc gia (NDXP)\",\n      icon: <NodeIndexOutlined />,\n      lop: 2,\n      category: \"Lớp 2: Dữ liệu & Nền tảng lõi\",\n      itemsMatch: (ht) => ht.ma === \"DL-03\" || ht.ten.toLowerCase().includes(\"lgsp\") || ht.ten.toLowerCase().includes(\"chia sẻ\"),\n      tasksMatch: (nv) => nv.ma === \"NV-04\" || nv.ma === \"NV-06\",\n      color: \"#1e40af\",\n      bgColor: \"#dbeafe\",\n      borderColor: \"#93c5fd\",\n    },\n    lop2_kho_dulieu_master: {\n      id: \"lop2_kho_dulieu_master\",\n      title: \"Kho Dữ Liệu Tỉnh\",\n      description: \"Kho dữ liệu tổng hợp tỉnh, từ điển danh mục dùng chung và nền tảng dữ liệu mở (Open Data)\",\n      icon: <DatabaseOutlined />,\n      lop: 2,\n      category: \"Lớp 2: Dữ liệu & Nền tảng lõi\",\n      itemsMatch: (ht) => ht.ma.startsWith(\"DL-\") || ht.ten.toLowerCase().includes(\"kho dữ liệu\") || ht.ten.toLowerCase().includes(\"danh mục\"),\n      tasksMatch: (nv) => nv.ma === \"NV-06\",\n      color: \"#2563eb\",\n      bgColor: \"#eff6ff\",\n      borderColor: \"#bfdbfe\",\n    },\n    lop2_csdl_quocgia: {\n      id: \"lop2_csdl_quocgia\",\n      title: \"CSDL Quốc Gia (Đề án 06)\",\n      description: \"Kết nối CSDL Quốc gia về Dân cư, CSDL Đất đai, CSDL Đăng ký doanh nghiệp, Bảo hiểm xã hội\",\n      icon: <ApartmentOutlined />,\n      lop: 2,\n      category: \"Lớp 2: Dữ liệu & Nền tảng lõi\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"dân cư\") || ht.ma === \"DL-01\" || ht.ma === \"DL-02\",\n      tasksMatch: (nv) => nv.ma === \"NV-03\" || nv.ma === \"NV-01\",\n      color: \"#1d4ed8\",\n      bgColor: \"#eff6ff\",\n      borderColor: \"#bfdbfe\",\n    },\n    lop2_nentang_loi: {\n      id: \"lop2_nentang_loi\",\n      title: \"Định Danh VNeID & GIS\",\n      description: \"Nền tảng xác thực định danh (VNeID/SSO), Nền tảng thanh toán số Payment, Nền tảng Bản đồ số GIS\",\n      icon: <DeploymentUnitOutlined />,\n      lop: 2,\n      category: \"Lớp 2: Dữ liệu & Nền tảng lõi\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"định danh\") || ht.ten.toLowerCase().includes(\"gis\") || ht.ten.toLowerCase().includes(\"thanh toán\"),\n      tasksMatch: (nv) => nv.ma === \"NV-03\",\n      color: \"#0284c7\",\n      bgColor: \"#f0f9ff\",\n      borderColor: \"#bae6fd\",\n    },\n\n    // ==========================================\n    // LỚP 1: HẠ TẦNG SỐ VÀ AN NINH MẠNG DÙNG CHUNG\n    // ==========================================\n    lop1_idc_cloud: {\n      id: \"lop1_idc_cloud\",\n      title: \"Trung Tâm Dữ Liệu (IDC)\",\n      description: \"Trung tâm tích hợp dữ liệu tỉnh, chuyển đổi sang kiến trúc Cloud kết nối Cloud Quốc gia\",\n      icon: <CloudServerOutlined />,\n      lop: 1,\n      category: \"Lớp 1: Hạ tầng số & An ninh mạng dùng chung\",\n      itemsMatch: (ht) => ht.ma === \"HT-02\" || ht.ten.toLowerCase().includes(\"idc\") || ht.ten.toLowerCase().includes(\"trung tâm tích hợp\"),\n      tasksMatch: (nv) => nv.ma === \"NV-02\",\n      color: \"#4c1d95\",\n      bgColor: \"#f3e8ff\",\n      borderColor: \"#e9d5ff\",\n    },\n    lop1_mang_tslcd: {\n      id: \"lop1_mang_tslcd\",\n      title: \"Mạng TSLCD Cấp I, II\",\n      description: \"Mạng Truyền số liệu chuyên dùng cấp I, II kết nối 100% cơ quan Đảng, chính quyền 3 cấp\",\n      icon: <NodeIndexOutlined />,\n      lop: 1,\n      category: \"Lớp 1: Hạ tầng số & An ninh mạng dùng chung\",\n      itemsMatch: (ht) => ht.ma === \"HT-01\" || ht.ten.toLowerCase().includes(\"wan\") || ht.ten.toLowerCase().includes(\"mạng\"),\n      tasksMatch: (nv) => false,\n      color: \"#581c87\",\n      bgColor: \"#faf5ff\",\n      borderColor: \"#f3e8ff\",\n    },\n    lop1_soc_anm: {\n      id: \"lop1_soc_anm\",\n      title: \"SOC Tỉnh (ATTT 4 Lớp)\",\n      description: \"Mô hình bảo vệ 4 lớp ATTT, kết nối SOC Quốc gia của Bộ Công an, chữ ký số PKI, sao lưu dự phòng\",\n      icon: <LockOutlined />,\n      lop: 1,\n      category: \"Lớp 1: Hạ tầng số & An ninh mạng dùng chung\",\n      itemsMatch: (ht) => ht.ma === \"HT-03\" || ht.ten.toLowerCase().includes(\"soc\") || ht.ten.toLowerCase().includes(\"an toàn\"),\n      tasksMatch: (nv) => nv.ma === \"NV-05\",\n      color: \"#991b1b\",\n      bgColor: \"#fef2f2\",\n      borderColor: \"#fecaca\",\n    },\n    lop1_iot_bien: {\n      id: \"lop1_iot_bien\",\n      title: \"Hạ Tầng IoT & Camera Biên\",\n      description: \"Hệ thống camera giám sát an ninh đô thị, trạm quan trắc IoT môi trường, nông nghiệp\",\n      icon: <EyeOutlined />,\n      lop: 1,\n      category: \"Lớp 1: Hạ tầng số & An ninh mạng dùng chung\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"camera\") || ht.ten.toLowerCase().includes(\"quan trắc\") || ht.ten.toLowerCase().includes(\"iot\"),\n      tasksMatch: (nv) => false,\n      color: \"#701a75\",\n      bgColor: \"#fdf2f8\",\n      borderColor: \"#fbcfe8\",\n    },\n  };\n\n  const getMatchedItems = (block: FrameworkBlock) => {\n    return heThongs.filter(block.itemsMatch);\n  };\n\n  const getMatchedTasks = (block: FrameworkBlock) => {\n    return nhiemVus.filter(block.tasksMatch);\n  };\n\n  // Render an ultra-clean, minimalist tile\n  const renderTile = (blockKey: string) => {\n    const block = frameworkBlocks[blockKey];\n    if (!block) return null;\n    const items = getMatchedItems(block);\n    const tasks = getMatchedTasks(block);\n    const hasUpgrade = items.some((i) => i.trangThai === \"can-nang-cap\") || tasks.length > 0;\n\n    return (\n      <div\n        onClick={() => setSelectedBlock(block)}\n        className=\"bg-white hover:bg-blue-50/50 rounded-xl px-4 py-3.5 border border-slate-200 hover:border-blue-500 shadow-2xs hover:shadow-md transition-all cursor-pointer flex items-center justify-between gap-2 group\"\n      >\n        <div className=\"flex items-center gap-3 min-w-0\">\n          <div\n            className=\"w-9 h-9 rounded-lg flex items-center justify-center text-base shrink-0 transition-transform group-hover:scale-105\"\n            style={{ backgroundColor: block.bgColor, color: block.color }}\n          >\n            {block.icon}\n          </div>\n          <span className=\"font-bold text-slate-800 text-sm group-hover:text-blue-700 transition-colors truncate\">\n            {block.title}\n          </span>\n        </div>\n\n        <div className=\"flex items-center gap-1.5 shrink-0\">\n          {items.length > 0 && (\n            <span className=\"text-[11px] font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded\">\n              {items.length} HT\n            </span>\n          )}\n          {hasUpgrade && (\n            <span className=\"w-2 h-2 rounded-full bg-amber-500 animate-pulse\" title=\"Có nhiệm vụ lộ trình\" />\n          )}\n          <RightOutlined className=\"text-[10px] text-slate-300 group-hover:text-blue-500 group-hover:translate-x-0.5 transition-all\" />\n        </div>\n      </div>\n    );\n  };\n\n  if (loading) {\n    return (\n      <div className=\"flex justify-center items-center min-h-[60vh]\">\n        <Spin size=\"large\" />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"w-full space-y-5 pb-16\">\n      {/* Top Header Bar */}\n      <div className=\"bg-slate-900 text-white px-6 py-4 rounded-2xl shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-3\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"bg-blue-500/20 text-blue-300 border border-blue-400/30 text-[11px] px-2.5 py-0.5 rounded-full font-bold\">\n              QĐ 1425/QĐ-TTg • PB 1.0\n            </span>\n            <span className=\"text-xs text-slate-400\">Khung Kiến Trúc Chính Quyền Số Tỉnh Vĩnh Long</span>\n          </div>\n          <h1 className=\"text-lg md:text-xl font-bold text-white m-0\">\n            Sơ Đồ Phân Tầng Kiến Trúc Tổng Thể (04 Lớp Chuẩn)\n          </h1>\n        </div>\n\n        <div className=\"flex gap-2 shrink-0\">\n          <Link href=\"/kts/hien-trang\">\n            <Button size=\"small\" className=\"bg-white/10 border-white/20 text-white hover:bg-white/20\">\n              Hiện Trạng (389 HT)\n            </Button>\n          </Link>\n          <Link href=\"/kts/lo-trinh\">\n            <Button type=\"primary\" size=\"small\" className=\"bg-blue-600 font-semibold\">\n              Lộ Trình (9 NV)\n            </Button>\n          </Link>\n        </div>\n      </div>\n\n      {/* ARCHITECTURE BLUEPRINT - 3 COLUMN MASTER LAYOUT */}\n      <div className=\"bg-slate-100/60 rounded-2xl border border-slate-200 p-4 md:p-6\">\n        \n        <div className=\"grid grid-cols-1 xl:grid-cols-12 gap-4 items-stretch\">\n          \n          {/* ========================================================================= */}\n          {/* CỘT TRÁI: THÀNH PHẦN XUYÊN SUỐT (I & II) */}\n          {/* ========================================================================= */}\n          <div className=\"xl:col-span-2 bg-slate-200/70 rounded-xl p-3.5 flex flex-col justify-between space-y-3\">\n            <div className=\"space-y-3\">\n              <div className=\"text-center font-bold text-slate-800 text-xs uppercase tracking-wider pb-2 border-b border-slate-300\">\n                THÀNH PHẦN XUYÊN SUỐT\n              </div>\n\n              {/* 1. Quản trị & Thể chế */}\n              <div class