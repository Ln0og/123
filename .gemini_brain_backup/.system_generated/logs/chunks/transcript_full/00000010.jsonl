entBg: \"#ecfeff\",\n    },\n    lop3_datdai_tnmt: {\n      id: \"lop3_datdai_tnmt\",\n      title: \"Đất Đai & TN-MT\",\n      keyword: \"CSDL Đất đai • NDOP • Môi trường\",\n      description: \"CSDL Đất đai tỉnh kết nối nền tảng điều phối dữ liệu đất đai quốc gia (NDOP), quan trắc môi trường\",\n      icon: <EnvironmentOutlined />,\n      lop: 3,\n      category: \"Lớp 3: Kinh tế số & Xã hội số\",\n      itemsMatch: (ht) => ht.ma === \"DL-02\" || ht.ten.toLowerCase().includes(\"đất đai\") || ht.ten.toLowerCase().includes(\"môi trường\"),\n      tasksMatch: (nv) => nv.ma === \"NV-01\",\n      color: \"#1d4ed8\",\n      accentBg: \"#eff6ff\",\n    },\n    lop3_dothi_kinhte: {\n      id: \"lop3_dothi_kinhte\",\n      title: \"Đô Thị, Du Lịch, GD\",\n      keyword: \"Đô thị thông minh • Du lịch số\",\n      description: \"Cổng du lịch thông minh, giáo dục số, chiếu sáng/giao thông thông minh, thương mại điện tử\",\n      icon: <CompassOutlined />,\n      lop: 3,\n      category: \"Lớp 3: Kinh tế số & Xã hội số\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"du lịch\") || ht.ten.toLowerCase().includes(\"giáo dục\") || ht.ten.toLowerCase().includes(\"thương mại\"),\n      tasksMatch: (nv) => false,\n      color: \"#4338ca\",\n      accentBg: \"#eef2ff\",\n    },\n\n    // ==========================================\n    // LỚP 2: DỮ LIỆU VÀ NỀN TẢNG LÕI\n    // ==========================================\n    lop2_lgsp_ndxp: {\n      id: \"lop2_lgsp_ndxp\",\n      title: \"Trục LGSP / NDXP\",\n      keyword: \"Liên thông dữ liệu quốc gia\",\n      description: \"Nền tảng tích hợp, chia sẻ dữ liệu cấp tỉnh (LGSP) liên thông Trục Quốc gia (NDXP)\",\n      icon: <NodeIndexOutlined />,\n      lop: 2,\n      category: \"Lớp 2: Dữ liệu & Nền tảng lõi\",\n      itemsMatch: (ht) => ht.ma === \"DL-03\" || ht.ten.toLowerCase().includes(\"lgsp\") || ht.ten.toLowerCase().includes(\"chia sẻ\"),\n      tasksMatch: (nv) => nv.ma === \"NV-04\" || nv.ma === \"NV-06\",\n      color: \"#1e40af\",\n      accentBg: \"#dbeafe\",\n    },\n    lop2_kho_dulieu_master: {\n      id: \"lop2_kho_dulieu_master\",\n      title: \"Kho Dữ Liệu Tỉnh\",\n      keyword: \"Master Data • Dữ liệu mở\",\n      description: \"Kho dữ liệu tổng hợp tỉnh, từ điển danh mục dùng chung và nền tảng dữ liệu mở (Open Data)\",\n      icon: <DatabaseOutlined />,\n      lop: 2,\n      category: \"Lớp 2: Dữ liệu & Nền tảng lõi\",\n      itemsMatch: (ht) => ht.ma.startsWith(\"DL-\") || ht.ten.toLowerCase().includes(\"kho dữ liệu\") || ht.ten.toLowerCase().includes(\"danh mục\"),\n      tasksMatch: (nv) => nv.ma === \"NV-06\",\n      color: \"#2563eb\",\n      accentBg: \"#eff6ff\",\n    },\n    lop2_csdl_quocgia: {\n      id: \"lop2_csdl_quocgia\",\n      title: \"CSDL Quốc Gia\",\n      keyword: \"Dân cư (Đề án 06) • DN\",\n      description: \"Kết nối CSDL Quốc gia về Dân cư, CSDL Đất đai, CSDL Đăng ký doanh nghiệp, Bảo hiểm xã hội\",\n      icon: <ApartmentOutlined />,\n      lop: 2,\n      category: \"Lớp 2: Dữ liệu & Nền tảng lõi\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"dân cư\") || ht.ma === \"DL-01\" || ht.ma === \"DL-02\",\n      tasksMatch: (nv) => nv.ma === \"NV-03\" || nv.ma === \"NV-01\",\n      color: \"#1d4ed8\",\n      accentBg: \"#eff6ff\",\n    },\n    lop2_nentang_loi: {\n      id: \"lop2_nentang_loi\",\n      title: \"Định Danh & GIS\",\n      keyword: \"VNeID / SSO • Payment • GIS\",\n      description: \"Nền tảng xác thực định danh (VNeID/SSO), Nền tảng thanh toán số Payment, Nền tảng Bản đồ số GIS\",\n      icon: <DeploymentUnitOutlined />,\n      lop: 2,\n      category: \"Lớp 2: Dữ liệu & Nền tảng lõi\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"định danh\") || ht.ten.toLowerCase().includes(\"gis\") || ht.ten.toLowerCase().includes(\"thanh toán\"),\n      tasksMatch: (nv) => nv.ma === \"NV-03\",\n      color: \"#0284c7\",\n      accentBg: \"#f0f9ff\",\n    },\n\n    // ==========================================\n    // LỚP 1: HẠ TẦNG SỐ VÀ AN NINH MẠNG DÙNG CHUNG\n    // ==========================================\n    lop1_idc_cloud: {\n      id: \"lop1_idc_cloud\",\n      title: \"Trung Tâm Dữ Liệu (IDC)\",\n      keyword: \"Cloud tỉnh • Hạ tầng số\",\n      description: \"Trung tâm tích hợp dữ liệu tỉnh, chuyển đổi sang kiến trúc Cloud kết nối Cloud Quốc gia\",\n      icon: <CloudServerOutlined />,\n      lop: 1,\n      category: \"Lớp 1: Hạ tầng số & An ninh mạng dùng chung\",\n      itemsMatch: (ht) => ht.ma === \"HT-02\" || ht.ten.toLowerCase().includes(\"idc\") || ht.ten.toLowerCase().includes(\"trung tâm tích hợp\"),\n      tasksMatch: (nv) => nv.ma === \"NV-02\",\n      color: \"#4c1d95\",\n      accentBg: \"#f3e8ff\",\n    },\n    lop1_mang_tslcd: {\n      id: \"lop1_mang_tslcd\",\n      title: \"Mạng TSLCD Cấp I, II\",\n      keyword: \"Truyền dẫn chuyên dùng\",\n      description: \"Mạng Truyền số liệu chuyên dùng cấp I, II kết nối 100% cơ quan Đảng, chính quyền 3 cấp\",\n      icon: <NodeIndexOutlined />,\n      lop: 1,\n      category: \"Lớp 1: Hạ tầng số & An ninh mạng dùng chung\",\n      itemsMatch: (ht) => ht.ma === \"HT-01\" || ht.ten.toLowerCase().includes(\"wan\") || ht.ten.toLowerCase().includes(\"mạng\"),\n      tasksMatch: (nv) => false,\n      color: \"#581c87\",\n      accentBg: \"#faf5ff\",\n    },\n    lop1_soc_anm: {\n      id: \"lop1_soc_anm\",\n      title: \"Trung Tâm SOC Tỉnh\",\n      keyword: \"ATTT 4 lớp • Kết nối BCA\",\n      description: \"Mô hình bảo vệ 4 lớp ATTT, kết nối SOC Quốc gia của Bộ Công an, chữ ký số PKI, sao lưu dự phòng\",\n      icon: <LockOutlined />,\n      lop: 1,\n      category: \"Lớp 1: Hạ tầng số & An ninh mạng dùng chung\",\n      itemsMatch: (ht) => ht.ma === \"HT-03\" || ht.ten.toLowerCase().includes(\"soc\") || ht.ten.toLowerCase().includes(\"an toàn\"),\n      tasksMatch: (nv) => nv.ma === \"NV-05\",\n      color: \"#991b1b\",\n      accentBg: \"#fef2f2\",\n    },\n    lop1_iot_bien: {\n      id: \"lop1_iot_bien\",\n      title: \"IoT & Camera Biên\",\n      keyword: \"Camera an ninh • Trạm cảm biến\",\n      description: \"Hệ thống camera giám sát an ninh đô thị, trạm quan trắc IoT môi trường, nông nghiệp\",\n      icon: <EyeOutlined />,\n      lop: 1,\n      category: \"Lớp 1: Hạ tầng số & An ninh mạng dùng chung\",\n      itemsMatch: (ht) => ht.ten.toLowerCase().includes(\"camera\") || ht.ten.toLowerCase().includes(\"quan trắc\") || ht.ten.toLowerCase().includes(\"iot\"),\n      tasksMatch: (nv) => false,\n      color: \"#701a75\",\n      accentBg: \"#fdf2f8\",\n    },\n  };\n\n  const getMatchedItems = (block: FrameworkBlock) => {\n    return heThongs.filter(block.itemsMatch);\n  };\n\n  const getMatchedTasks = (block: FrameworkBlock) => {\n    return nhiemVus.filter(block.tasksMatch);\n  };\n\n  // Render a clean, punchy, minimalist card\n  const renderMinimalCard = (blockKey: string) => {\n    const block = frameworkBlocks[blockKey];\n    if (!block) return null;\n    const items = getMatchedItems(block);\n    const tasks = getMatchedTasks(block);\n    const hasUpgrade = items.some((i) => i.trangThai === \"can-nang-cap\") || tasks.length > 0;\n\n    return (\n      <div\n        onClick={() => setSelectedBlock(block)}\n        className=\"bg-white hover:bg-blue-50/40 rounded-xl p-3 md:p-3.5 border border-slate-200/90 shadow-2xs hover:shadow-md hover:border-blue-400 transition-all cursor-pointer flex flex-col justify-between group relative overflow-hidden\"\n      >\n        {/* Top colored indicator bar */}\n        <div\n          className=\"absolute top-0 left-0 right-0 h-1 transition-all group-hover:h-1.5\"\n          style={{ backgroundColor: block.color }}\n        />\n\n        {/* Content */}\n        <div className=\"flex items-center gap-2.5 pt-0.5\">\n          <div\n            className=\"w-8 h-8 rounded-lg flex items-center justify-center text-sm shrink-0 shadow-2xs\"\n            style={{ backgroundColor: block.accentBg, color: block.color }}\n          >\n            {block.icon}\n          </div>\n          <div className=\"flex-1 min-w-0\">\n            <div className=\"font-bold text-slate-800 text-xs sm:text-[13px] md:text-sm leading-tight group-hover:text-blue-700 transition-colors truncate\">\n              {block.title}\n            </div>\n            <div className=\"text-[11px] text-slate-400 font-medium truncate mt-0.5\">\n              {block.keyword}\n            </div>\n          </div>\n        </div>\n\n        {/* Footer row: Count + Lộ trình status */}\n        <div className=\"flex items-center justify-between mt-2.5 pt-2 border-t border-slate-100 text-xs\">\n          <span className=\"font-semibold text-slate-600 bg-slate-100/90 px-2 py-0.5 rounded text-[10px] md:text-[11px]\">\n            {items.length > 0 ? `${items.length} HT/CSDL` : \"Quy chuẩn\"}\n          </span>\n          {hasUpgrade ? (\n            <span className=\"inline-flex items-center gap-1 text-amber-800 bg-amber-50 border border-amber-300 text-[10px] px-2 py-0.5 rounded-full font-bold\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse\"></span>\n              Có lộ trình\n            </span>\n          ) : (\n            <span className=\"text-slate-400 text-[11px] group-hover:text-blue-600 font-medium flex items-center gap-0.5\">\n              Chi tiết <RightOutlined className=\"text-[9px]\" />\n            </span>\n          )}\n        </div>\n      </div>\n    );\n  };\n\n  if (loading) {\n    return (\n      <div className=\"flex justify-center items-center min-h-[60vh]\">\n        <Spin size=\"large\" />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"w-full space-y-6 pb-16\">\n      {/* Header Banner */}\n      <div className=\"bg-gradient-to-r from-blue-950 via-slate-900 to-indigo-950 text-white p-5 md:p-6 rounded-2xl shadow-md flex flex-col md:flex-row justify-between items-start md:items-center gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1.5\">\n            <span className=\"bg-amber-400/25 text-amber-200 border border-amber-400/40 text-xs px-2.5 py-0.5 rounded-full font-bold flex items-center gap-1\">\n              <ApartmentOutlined /> Chuẩn QĐ 1425/QĐ-TTg (PB 1.0)\n            </span>\n            <span className=\"text-xs text-blue-300\">Khung Kiến Trúc Chính Quyền Số Tỉnh Vĩnh Long</span>\n          </div>\n          <h1 className=\"text-xl md:text-2xl font-bold tracking-tight text-white m-0\">\n            Sơ Đồ Khung Kiến Trúc Tổng Thể Chính Quyền Số\n          </h1>\n          <p className=\"text-xs md:text-sm text-blue-200/90 mt-1 mb-0 max-w-4xl\">\n            Mô hình cấu trúc <b>04 Lớp Chuẩn Quốc Gia</b> kết hợp <b>04 Thành Phần Xuyên Suốt</b> (Quản trị • Quy chuẩn • AI First • Data-Centric).\n          </p>\n        </div>\n\n        <div className=\"flex gap-2.5 shrink-0\">\n          <Link href=\"/kts/hien-trang\">\n            <Button className=\"bg-white/15 border-white/30 text-white hover:bg-white/25 font-semibold\">\n              Hiện Trạng (389 HT)\n            </Button>\n          </Link>\n          <Link href=\"/kts/lo-trinh\">\n            <Button type=\"primary\" className=\"bg-blue-600 border-blue-500 font-bold shadow-md\">\n              Lộ Trình (9 NV)\n            </Button>\n          </Link>\n        </div>\n      </div>\n\n      {/* ARCHITECTURE BLUEPRINT DIAGRAM - WIDE FULL CANVAS */}\n      <div className=\"bg-white rounded-2xl border border-slate-200 shadow-sm p-4 md:p-6\">\n        \n        {/* Diagram title header */}\n        <div className=\"text-center mb-6\">\n          <div className=\"inline-flex items-center gap-2 bg-blue-900 text-white px-5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider shadow-xs\">\n            <ApartmentOutlined /> MÔ HÌNH KIẾN TRÚC TỔNG THỂ CHÍNH QUYỀN SỐ (04 LỚP CHUẨN QĐ 1425)\n          </div>\n          <p className=\"text-xs text-slate-500 mt-1.5 mb-0\">\n            💡 Nhấp vào bất kỳ khối nào để xem đầy đủ thông tin chi tiết, hệ thống hiện trạng và nhiệm vụ lộ trình\n          </p>\n        </div>\n\n        {/* 3-Column Master Grid */}\n        <div className=\"grid grid-cols-1 xl:grid-cols-12 gap-4 items-stretch\">\n          \n          {/* ========================================================================= */}\n          {/* CỘT TRÁI: 2 THÀNH PHẦN XUYÊN SUỐT (QUẢN TRỊ & TIÊU CHUẨN) */}\n          {/* ========================================================================= */}\n          <div className=\"xl:col-span-2 bg-slate-50/90 rounded-2xl border border-slate-200 p-3.5 flex flex-col justify-between space-y-3\">\n            <div className=\"space-y-3\">\n              <div className=\"flex items-center gap-1.5 font-bold text-slate-900 text-xs border-b border-slate-200 pb-2\">\n                <SlidersOutlined className=\"text-blue-700\" />\n                <span>THÀNH PHẦN XUYÊN SUỐT</span>\n              </div>\n\n              {/* 1. Quản trị & Điều phối */}\n              <div className=\"bg-white p-3 rounded-xl border border-slate-200/90 shadow-2xs\">\n                <div className=\"font-bold text-blue-950 text-xs flex items-center gap-1 mb-1.5\">\n                  <BankOutlined className=\"text-blue-600\" />\n                  <span>1. Quản trị & Điều phối</span>\n                </div>\n                <ul className=\"text-[11px] text-slate-600 space-y-1.5 pl-3 list-disc m-0\">\n                  <li>Ban chỉ đạo CĐS tỉnh</li>\n                  <li>Kế hoạch CĐS 2026–2030</li>\n                  <li>Giám sát KPIs thực thi</li>\n                </ul>\n              </div>\n\n              {/* 2. Tiêu chuẩn & Quy chuẩn */}\n              <div className=\"bg-white p-3 rounded-xl border border-slate-200/90 shadow-2xs\">\n                <div className=\"font-bold text-blue-950 text-xs flex items-center gap-1 mb-1.5\">\n                  <SafetyCertificateOutlined className=\"text-blue-600\" />\n                  <span>2. Tiêu chuẩn & Quy chuẩn</span>\n                </div>\n                <ul className=\"text-[11px] text-slate-600 space-y-1.5 pl-3 list-disc m-0\">\n                  <li>Kiến trúc số dùng chung</li>\n                  <li>Quy chế chia sẻ dữ liệu</li>\n                  <li>Chuẩn Open API</li>\n                </ul>\n              </div>\n            </div>\n\n            <div className=\"pt-2 border-t border-slate-200 text-[10px] text-slate-500 text-center font-bold uppercase tracking-wider\">\n              Khung Thể Chế\n            </div>\n          </div>\n\n          {/* ========================================================================= */}\n          {/* TRUNG TÂM: 04 LỚP KIẾN TRÚC CHUẨN QUỐC GIA (TOP-DOWN: LỚP 4 -> LỚP 1) */}\n          {/* ========================================================================= */}\n          <div className=\"xl:col-span-8 space-y-3.5\">\n            \n            {/* ------------------------------------------------------------- */}\n            {/* LỚP 4: KÊNH TƯƠNG TÁC VÀ ĐO LƯỜNG HIỆU QUẢ */}\n            {/* ------------------------------------------------------------- */}\n            <div className=\"bg-amber-50/50 rounded-2xl border border-amber-200 p-3 shadow-2xs\">\n              <div className=\"flex items-center justify-between mb-2 px-1\">\n                <span className=\"font-bold text-xs uppercase tracking-wide text-amber-950 flex items-center gap-1.5\">\n                  <TeamOutlined className=\"text-amber-600\" /> LỚP 4: KÊNH TƯƠNG TÁC & ĐO LƯỜNG HIỆU QUẢ\n                </span>\n                <span className=\"text-[10px] text-amber-900 font-semibold bg-amber-100/90 px-2.5 py-0.5 rounded border border-amber-200\">\n                  Người dân • Doanh nghiệp • CCVC\n                </span>\n              </div>\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5\">\n                {renderMinimalCard(\"lop4_dvc\")}\n                {renderMinimalCard(\"lop4_app_mobile\")}\n                {renderMinimalCard(\"lop4_portal\")}\n                {renderMinimalCard(\"lop4_kpi_metric\")}\n              </div>\n            </div>\n\n            {/* ------------------------------------------------------------- */}\n            {/* LỚP 3: ỨNG DỤNG VÀ NGHIỆP VỤ DÙNG CHUNG */}\n            {/* ------------------------------------------------------------- */}\n            <div className=\"bg-emerald-50/40 rounded-2xl border border-emerald-200 p-3 shadow-2xs space-y-2.5\">\n              <div className=\"flex items-center justify-between px-1\">\n                <span className=\"font-bold text-xs uppercase tracking-wide text-emerald-950 flex items-center gap-1.5\">\n                  <DesktopOutlined className=\"text-emerald-600\" /> LỚP 3: ỨNG DỤNG VÀ NGHIỆP VỤ DÙNG CHUNG (389+ HỆ THỐNG)\n                </span>\n                <span className=\"text-[10px] text-emerald-900 font-semibold bg-emerald-100/90 px-2.5 py-0.5 rounded border border-emerald-200\">\n                  2 Nhánh song song\n                </span>\n              </div>\n\n              {/* 2 Parallel Clean Sections */}\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n                \n                {/* Nhánh 1: Chính quyền số */}\n                <div className=\"bg-white/90 p-2.5 rounded-xl border border-emerald-200 space-y-2\">\n                  <div className=\"flex items-center justify-between px-1 pb-1.5 border-b border-slate-100\">\n                    <span className=\"font-bold text-xs text-emerald-950 flex items-center gap-1\">\n                      🏛️ CHÍNH QUYỀN SỐ\n                    </span>\n                    <span className=\"text-[10px] text-slate-400 font-medium\">(Nội bộ & TTHC)</span>\n                  </div>\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n                    {renderMinimalCard(\"lop3_chidao_dieuhanh\")}\n                    {renderMinimalCard(\"lop3_tthc_sohoa\")}\n                    {renderMinimalCard(\"lop3_ioc_tinh\")}\n                    {renderMinimalCard(\"lop3_nghiepvu_chuyennganh\")}\n                  </div>\n                </div>\n\n                {/* Nhánh 2: Kinh tế số & Xã hội số */}\n                <div className=\"bg-white/90 p-2.5 rounded-xl border border-emerald-200 space-y-2\">\n                  <div className=\"flex items-center justify-between px-1 pb-1.5 border-b border-slate-100\">\n                    <span className=\"font-bold text-xs text-emerald-950 flex items-center gap-1\">\n                      🌾 KINH TẾ SỐ & XÃ HỘI SỐ\n                    </span>\n                    <span className=\"text-[10px] text-slate-400 font-medium\">(Ngành & Đời sống)</span>\n                  </div>\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n                    {renderMinimalCard(\"lop3_nongnghiep_so\")}\n                    {renderMinimalCard(\"lop3_yte_so\")}\n                    {renderMinimalCard(\"lop3_datdai_tnmt\")}\n                    {renderMinimalCard(\"lop3_dothi_kinhte\")}\n                  </div>\n                </div>\n\n              </div>\n            </div>\n\n            {/* ------------------------------------------------------------- */}\n            {/* LỚP 2: DỮ LIỆU VÀ NỀN TẢNG LÕI */}\n            {/* ------------------------------------------------------------- */}\n            <div className=\"bg-blue-50/50 rounded-2xl border border-blue-200 p-3 shadow-2xs\">\n              <div className=\"flex items-center justify-between mb-2 px-1\">\n                <span className=\"font-bold text-xs uppercase tracking-wide text-blue-950 flex items-center gap-1.5\">\n                  <NodeIndexOutlined className=\"text-blue-600\" /> LỚP 2: DỮ LIỆU VÀ NỀN TẢNG LÕI (LGSP / NDXP • MASTER DATA)\n                </span>\n                <span className=\"text-[10px] text-blue-900 font-semibold bg-blue-100/90 px-2.5 py-0.5 rounded border border-blue-200\">\n                  Trục li