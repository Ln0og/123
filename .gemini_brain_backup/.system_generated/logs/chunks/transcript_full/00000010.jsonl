           <span>\n38:             <CalendarOutlined className=\"mr-1\" />\n39:             Giai đoạn: {khung.giaiDoanApDung || \"—\"}\n40:           </span>\n41:           <span>\n42:             <UserOutlined className=\"mr-1\" />\n43:             Đầu mối: {khung.daiDienPhuTrach || \"—\"}\n44:           </span>\n45:         </div>\n46:       </div>\n47: \n48:       <div className=\"grid grid-cols-3 gap-6\">\n49:         {/* Bối cảnh */}\n50:         <Card\n51:           className=\"col-span-2\"\n52:           title={\n53:             <span className=\"flex items-center gap-2\">\n54:               <InfoCircleOutlined className=\"text-blue-600\" />\n55:               Bối cảnh & Căn cứ\n56:             </span>\n57:           }\n58:         >\n59:           <p className=\"text-gray-700 leading-relaxed whitespace-pre-line\">\n60:             {khung.boiCanh || \"Chưa có thông tin.\"}\n61:           </p>\n62:         </Card>\n63: \n64:         {/* Thông tin chung */}\n65:         <Card\n66:           title={\n67:             <span className=\"flex items-center gap-2\">\n68:               <CalendarOutlined className=\"text-green-600\" />\n69:               Thông tin chung\n70:             </span>\n71:           }\n72:         >\n73:           <Descriptions column={1} size=\"small\">\n74:             <Descriptions.Item label=\"Tên Khung\">\n75:               {khung.tenKhung}\n76:             </Descriptions.Item>\n77:             <Descriptions.Item label=\"Phiên bản\">\n78:               {khung.phienBan}\n79:             </Descriptions.Item>\n80:             <Descriptions.Item label=\"Ngày ban hành\">\n81:               {khung.ngayBanHanh\n82:                 ? new Date(khung.ngayBanHanh).toLocaleDateString(\"vi-VN\")\n83:                 : \"—\"}\n84:             </Descriptions.Item>\n85:             <Descriptions.Item label=\"Giai đoạn\">\n86:               {khung.giaiDoanApDung || \"—\"}\n87:             </Descriptions.Item>\n88:             <Descriptions.Item label=\"Tr