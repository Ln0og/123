ng-tight\">\n              <div className=\"font-bold text-blue-900 text-sm\">KTS Vĩnh Long</div>\n              <div className=\"text-gray-400 text-xs\">Khung Kiến trúc Số</div>\n            </div>\n          </Link>\n          <nav className=\"flex gap-1 flex-1\">\n            {navItems.map((item) => (\n              <Link key={item.href} href={item.href}>\n                <span\n                  className={`px-4 py-2 rounded-lg text-sm font-medium transition-colors cursor-pointer inline-block ${\n                    pathname === item.href\n                      ? \"bg-blue-800 text-white\"\n                      : \"text-gray-600 hover:bg-gray-100\"\n                  }`}\n                >\n                  {item.label}\n                </span>\n              </Link>\n            ))}\n          </nav>\n          <div className=\"flex gap-2\">\n            <Link href=\"/dashboard\">\n              <Button icon={<BarChartOutlined />} size=\"small\">Dashboard</Button>\n            </Link>\n            <Link href=\"/admin\">\n              <Button type=\"primary\" size=\"small\" style={{ backgroundColor: \"#003087\" }}>\n                Quản trị\n              </Button>\n            </Link>\n          </div>\n        </div>\n      </header>\n      <main className=\"max-w-7xl mx-auto px-6 py-8\">{children}</main>\n    </div>\n  );\n}\n","Description":"Portal layout with sticky navigation header","Overwrite":false,"TargetFile":"C:\\Delta Force\\kts-vinhlong\\src\\app\\(portal)\\layout.tsx","toolAction":"Writing portal layout","toolSummary":"Portal layout"}}]}
