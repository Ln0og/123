.map((id: string) => ({ id }))\r\n39:         } : undefined\r\n40:       },\r\n41:       include: { donViChuTri: true, heThongSos: true },\r\n42:     });\r\n43:     return NextResponse.json(item, { status: 201 });\r\n44:   } catch (e) {\r\n45:     console.error(e);\r\n46:     return NextResponse.json({ error: \"Lỗi server\" }, { status: 500 });\r\n47:   }\r\n48: }\r\n49: \nThe above content shows the entire, complete file contents of the requested file.\n"}
