{"step_index":132,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-21T00:28:41Z","content":"Created At: 2026-09-21T07:28:41+07:00\nCompleted At: 2026-09-21T07:28:41+07:00\nFile Path: `file:///e:/KTS/123/src/app/admin/import/page.tsx`\nTotal Lines: 215\nTotal Bytes: 8121\nShowing lines 1 to 60\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"use client\";\r\n2: import { useState } from \"react\";\r\n3: import { Card, Upload, Button, Table, Alert, Tag, message, Steps } from \"antd\";\r\n4: import { CheckCircleOutlined } from \"@ant-design/icons\";\r\n5: import * as XLSX from \"xlsx\";\r\n6: \r\n7: const { Dragger } = Upload;\r\n8: \r\n9: interface PreviewRow {\r\n10:   ma: string;\r\n11:   ten: string;\r\n12:   lop: number;\r\n13:   trangThai: string;\r\n14:   moTa?: string;\r\n15:   chuQuan?: string;\r\n16: }\r\n17: \r\n18: export default function AdminImportPage() {\r\n19:   const [preview, setPreview] = useState<PreviewRow[]>([]);\r\n20:   const [importing, setImporting] = useState(false);\r\n21:   const [step, setStep] = useState(0);\r\n22:   const [importResult, setImportResult] = useState<{ success: number; error: number } | null>(null);\r\n23: \r\n24:   const handleFile = (file: File) => {\r\n25:     const reader = new FileReader();\r\n26:     reader.onload = (e) => {\r\n27:       try {\r\n28:         const data = new Uint8Array(e.target?.result as ArrayBuffer);\r\n29:         const workbook = XLSX.read(data, { type: \"array\" });\r\n30:         \r\n31:         // Thử đọc sheet DM_DOITUONG (Bảng 1 trong Mẫu 03)\r\n32:         const sheetName = workbook.SheetNames.find(n => \r\n33:           n.includes(\"DM_DOITUONG\") || n.includes(\"Danh muc\") || n === workbook.SheetNames[0]\r\n34:         ) || workbook.SheetNames[0];\r\n35:         \r\n36:         const sheet = workbook.Sheets[sheetName];\r\n37:         const rows = XLSX.utils.sheet_to_json<Record<string, string>>(sheet, { header: 1 });\r\n38:         \r\n39:         // Parse rows (bỏ qua header)\r\n40:         const parsed: PreviewRow[] = [];\r\n41:         for (let i = 1; i < rows.length; i++) {\r\n42:           const row = rows[i] as unknown as string[];\r\n43:           if (!row || !row[1]) continue; // Bỏ qua dòng trống\r\n44:           parsed.push({\r\n45:             ma: String(row[0] || `HT-${i.toString().padStart(2, \"0\")}`),\r\n46:             ten: String(row[1] || \"\"),\r\n47:             lop: parseInt(String(row[2])) || 1,\r\n48:             trangThai: String(row[3] || \"dang-van-hanh\"),\r\n49:             moTa: String(row[4] || \"\"),\r\n50:             chuQuan: String(row[5] || \"\"),\r\n51:           });\r\n52:         }\r\n53:         \r\n54:         setPreview(parsed);\r\n55:         setStep(1);\r\n56:         message.success(`Đọc được ${parsed.length} dòng từ sheet \"${sheetName}\"`);\r\n57:       } catch {\r\n58:         message.error(\"Lỗi đọc file XLSX. Vui lòng kiểm tra định dạng.\");\r\n59:       }\r\n60:     };\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
