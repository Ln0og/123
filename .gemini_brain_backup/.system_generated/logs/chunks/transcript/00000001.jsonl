dStart(2, \\\"0\\\")}`),\\n            ten: String(row[1] || \\\"\\\"),\\n            lop: parseInt(String(row[2])) || 1,\\n            trangThai: String(row[3] || \\\"dang-van-hanh\\\"),\\n            moTa: String(row[4] || \\\"\\\"),\\n            chuQuan: String(row[5] || \\\"\\\"),\\n          });\\n     \n<truncated 5986 bytes>","Description":"\"Import XLSX page with file drag-drop, preview table, and step-by-step import wizard\"","Overwrite":"false","TargetFile":"\"C:\\\\Delta Force\\\\kts-vinhlong\\\\src\\\\app\\\\admin\\\\import\\\\page.tsx\"","toolAction":"\"Writing admin import page\"","toolSummary":"\"Admin import XLSX page\""}}],"truncated_fields":["tool_calls"]}
