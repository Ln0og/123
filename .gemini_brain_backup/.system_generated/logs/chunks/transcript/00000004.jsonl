ock, setSelectedBlock] = useState<FrameworkBlock | null>(null);\n46: \n47:   useEffect(() => {\n48:     Promise.all([\n49:       fetch(\"/api/he-thong\").then((r) => r.json()),\n50:       fetch(\"/api/nhiem-vu\").then((r) => r.json()),\n51:     ])\n52:       .then(([htData, nvData]) => {\n53:         setHeThongs(Array.isArray(htData) ? htData : []);\n54:         setNhiemVus(Array.isArray(nvData) ? nvData : []);\n55:         setLoading(false);\n56:       })\n57:       .catch(() => {\n58:         setHeThongs([]);\n59:         setNhiemVus([]);\n60:         setLoading(false);\n61:       });\n62:   }, []);\n63: \n64:   // Define the architectural blocks based on QD 1425 / National Digital Architecture Framework PB 1.0\n65:   const frameworkBlocks: Record<string, FrameworkBlock> = {\n66:     // Top: Channels & Users\n67:     kenh_dvc: {\n68:       id: \"kenh_dvc\",\n69:       title: \"Cổng DVC & Một Cửa Điện Tử\",\n70:       description: \"Cổng Dịch vụ công trực tuyến tỉnh kết nối Cổng DVC Quốc gia\",\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
