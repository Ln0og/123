.trim();\n41:     const ma = `SNN-${String(row[0] || i).padStart(2, \"0\")}`;\n42:     const tenMien = row[2] ? String(row[2]).trim() : \"\";\n43:     const donViQuanLy = row[4] ? String(row[4]).trim() : \"\";\n44:     const donViCon = row[5] ? String(row[5]).trim() : \"\";\n45:     \n46:     let chuQuan = donViQuanLy;\n47:     if (donViCon) chuQuan += ` - ${donViCon}`;\n48: \n49:     const rawTrangThai = String(row[9] || \"\").toLowerCase();\n50:     let trangThai = \"dang-van-hanh\";\n51:     if (rawTrangThai.includes(\"không\") || rawTrangThai.includes(\"dừng\")) {\n52:       trangThai = \"can-thay-the\";\n53:     }\n54: \n55:     const namStr = String(row[6] || \"\");\n56:     const namTrienKhai = parseInt(namStr) || null;\n57: \n58:     // Build moTa from domain and data sharing info\n59:     let moTaParts = [];\n60:     if (tenMien && tenMien !== \"Không có\") moTaParts.push(`Tên miền: ${tenMien}`);\n61:     if (row[13]) moTaParts.push(`Dữ liệu chia sẻ: ${String(row[13]).substring(0, 200)}...`);\n62:     if (row[14]) moTaParts.push(`Phạm vi: ${String(row[14]).substring(0, 200)}...`);\n63: \n64:     const isDuLieu = ten.toLowerCase().includes(\"csdl\") || ten.toLowerCase().includes(\"dữ liệu\");\n65:     const loai = isDuLieu ? \"du-lieu\" : \"ung-dung\";\n66:     const lop = isDuLieu ? 2 : 3;\n67: \n68:     try {\n69:       await prisma.heThongSo.create({\n70:         data: {\n71:           ma,\n72:           ten,\n73:           loai,\n74:           lop,\n75:           moTa: moTaParts.join(\"\\\\n\"),\n76:           chuQuan,\n77:           trangThai,\n78:           namTrienKhai,\n79:           donViId: donVi.id\n80:         }\n81:       });\n82:       successCount++;\n83:       console.log(`Imported: ${ma} - ${ten.substring(0, 30)}...`);\n84:     } catch (e) {\n85:       console.error(`Error importing row ${i}:`, e.message);\n86:     }\n87:   }\n88: \n89:   console.log(`\\\\n✅ Import completed: ${successCount} systems added.`);\n90:   await prisma.$disconnect(